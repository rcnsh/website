{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  "workers_dev": false,

  "limits": { "cpu_ms": 500 },

  "triggers": { "crons": ["17 4 * * *"] },

  "ratelimits": [
    {
      "name": "API_BUDGET",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "SCAN_BUDGET",
      "namespace_id": "1002",
      "simple": { "limit": 80, "period": 60 }
    },
    {
      "name": "AUTH_BUDGET",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rcnsh",
      "database_id": "d1dadeb1-fb9f-4a36-aff3-fa129643839b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rcn",
      "remote": true
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "02d9b4fc36304046be09c0700b899f1a"
    }
  ],

  "vars": {
    "PUBLIC_BUCKET_URL": "https://upload.rcn.sh",

    "MUSIC_WAREHOUSE_URL": "https://music-api.rcn.sh",
    "GITHUB_USERNAME": "rcnsh",
    "OWNER_GITHUB_ID": "49075095"
  }
}
