{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // A ceiling on what one request can spend, against a route that can be made
  // to loop. The default is 30s and there is no account spend cap behind it.
  // Startup CPU is accounted separately, so cold starts are unaffected.
  "limits": { "cpu_ms": 500 },

  // Per-client budgets, spent in src/lib/throttle.ts. Limits are per minute,
  // per Cloudflare location, and sized well above what the site's own
  // JavaScript asks for. `namespace_id` is account-wide, not per Worker — the
  // multiplayer Worker uses the 2000 range so its counters stay separate.
  "ratelimits": [
    // Everything the Worker renders that is not matched below.
    {
      "name": "API_BUDGET",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    // Every route that reads the whole cached tree out of KV. The ceiling has
    // to clear a human clicking through folders — the browser lazy-loads one
    // directory per expansion.
    {
      "name": "SCAN_BUDGET",
      "namespace_id": "1002",
      "simple": { "limit": 80, "period": 60 }
    },
    // The OAuth round trip. Writes D1 rows, and a human does it about once.
    {
      "name": "AUTH_BUDGET",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Guestbook entries + OAuth sessions.
  // Create with: wrangler d1 create rcnsh   →  paste the id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rcnsh",
      "database_id": "d1dadeb1-fb9f-4a36-aff3-fa129643839b",
      "migrations_dir": "migrations"
    }
  ],

  // Public file bucket. `remote: true` so local dev reads the real bucket
  // rather than an empty simulated one; the contents are public anyway.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rcn",
      "remote": true
    }
  ],

  // Short-lived cache for Spotify access tokens and GitHub responses.
  // Create with: wrangler kv namespace create CACHE  →  paste the id below.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "02d9b4fc36304046be09c0700b899f1a"
    }
  ],

  "vars": {
    // The bucket's custom domain (R2 → rcn → Settings → Custom Domains).
    "PUBLIC_BUCKET_URL": "https://upload.rcn.sh",

    // Paired with the MUSIC_WAREHOUSE_TOKEN secret.
    "MUSIC_WAREHOUSE_URL": "https://music-api.rcn.sh",
    "GITHUB_USERNAME": "rcnsh"
  }
}
