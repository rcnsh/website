{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rcn-upload",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "routes": [{ "pattern": "upload.rcn.sh", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rcn" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rcnsh",
      "database_id": "d1dadeb1-fb9f-4a36-aff3-fa129643839b"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "https://rcn.sh"
  }
}
