{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rcnsh-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  /*
    A route rather than a Custom Domain. rcn.sh itself is a Custom Domain
    pointing at the `rcnsh` worker, and a route on a subpath of that hostname
    runs *before* it — so this worker answers /api/multiplayer and the site
    worker never sees the request. Same origin, which keeps the connection
    inside `connect-src 'self'` and means no second hostname to certificate.

    The zone already has the proxied DNS record the route needs; the Custom
    Domain created it.
  */
  "routes": [{ "pattern": "rcn.sh/api/multiplayer*", "zone_name": "rcn.sh" }],

  // One instance per page path. `new_sqlite_classes` is not optional — the
  // key-value backend is Workers Paid only, and nothing here is stored anyway.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CursorRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CursorRoom"] }]
}
