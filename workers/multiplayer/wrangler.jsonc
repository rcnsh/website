{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "website-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Parses a URL and hands off to a Durable Object. The default is 30s.
  "limits": { "cpu_ms": 50 },

  // Upgrades per client per minute. MAX_PEERS caps open sockets and Budget in
  // protocol.ts caps how fast one may talk, but neither bounds churn —
  // connect/disconnect is a billed Durable Object request each time.
  // The 2000 range because namespace ids are account-wide.
  "ratelimits": [
    {
      "name": "SOCKET_BUDGET",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // A route, not a Custom Domain: a route on a subpath of rcn.sh runs before
  // the site Worker's Custom Domain, so this stays same-origin and inside
  // `connect-src 'self'` with no second hostname to certificate.
  "routes": [{ "pattern": "rcn.sh/api/multiplayer*", "zone_name": "rcn.sh" }],

  // The room list this Worker imports is generated, not committed. Workers
  // Builds deploys straight from a push with no build step of its own, so this
  // file is the only place that can know. No `cwd`: Wrangler resolves it
  // against the invocation directory, which is already the repository root.
  "build": {
    "command": "npm run rooms"
  },

  // One instance per page path. `new_sqlite_classes` is not optional: the
  // key-value backend is Workers Paid only.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CursorRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CursorRoom"] }]
}
