# Copy to `.dev.vars` for local development.
# In production these are Worker secrets: `wrangler secret put <NAME>`

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Local callback URL:      http://localhost:4321/api/auth/callback
# Production callback URL: https://rcn.sh/api/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Classic PAT with `read:user`. Required for the contribution graph
# (GitHub only exposes the calendar over GraphQL, which needs auth) and it
# lifts the REST rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=""

# Read-only token for the music-warehouse Worker (its READ_TOKEN secret).
# Listening data is read from there, not from Spotify — the warehouse holds the
# only Spotify grant, so this site has no refresh token to keep alive.
MUSIC_WAREHOUSE_TOKEN=""
