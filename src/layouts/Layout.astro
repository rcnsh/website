---
import { ClientRouter } from "astro:transitions";
import { MOTION_BOOTSTRAP } from "../../shared/inline-scripts.ts";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import geistSans from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "@/styles/global.css";

import TopBar from "@/components/TopBar.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import Footer from "@/components/Footer.astro";
import Lattice from "@/components/Lattice.astro";
import PlayOnSpotify from "@/components/music/PlayOnSpotify.astro";
import MiniPlayer from "@/components/player/MiniPlayer.astro";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  imageSize?: { width: number; height: number } | null;
}

const OG_IMAGE = { src: "/og.png", width: 1200, height: 630 } as const;

const {
  title,
  description = site.description,
  ogType = "website",
  image = OG_IMAGE.src,
  imageSize: ogImageSize = OG_IMAGE,
} = Astro.props;

const pageTitle = title ? `${site.name} • ${title}` : `${site.name} • Home`;

const metaDescription = description.replace(/\[([^\]]+)\]\([^)\s]+\)/g, "$1");
const pathname = Astro.url.pathname.replace(/(?:\/index)?\.html$/, "");
const canonical =
  new URL(pathname, site.url).toString().replace(/\/+$/, "") || site.url;

const ogImage = new URL(image, site.url).toString();
const imageAlt = `${site.author} — ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogImageSize && (
        <>
          <meta property="og:image:width" content={String(ogImageSize.width)} />
          <meta property="og:image:height" content={String(ogImageSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writing`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${site.name} — Writing`}
      href="/feed.json"
    />
    <meta name="theme-color" content="#0d0d0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline set:html={MOTION_BOOTSTRAP} />

    {
      Astro.isPrerendered && <ClientRouter />
    }
  </head>

  <body class="min-h-dvh">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-xs focus:bg-overlay focus:px-4 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <Lattice />

    <div class="page-shell relative z-10 flex min-h-dvh flex-col overflow-x-clip">
      <TopBar />
      <main id="content" class="flex-1">
        <slot name="hero" />
        <div class="mx-auto w-full max-w-page px-4 pt-7 sm:px-5">
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <CommandPalette />
    <PlayOnSpotify />
    <MiniPlayer />

    <script>
      import { holdOwnerViewOnFiles } from "@/components/files/owner-view";
      import {
        keepReaderAttributes,
        wipePagesIn,
        loadServerPagesDirectly,
        reloadAcrossBuilds,
      } from "@/lib/page-lifecycle";

      reloadAcrossBuilds();
      keepReaderAttributes();
      wipePagesIn();
      loadServerPagesDirectly();
      holdOwnerViewOnFiles();
    </script>
  </body>
</html>

