---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@/styles/global.css";

import TopBar from "@/components/TopBar.astro";
import Footer from "@/components/Footer.astro";
import StructuredData from "@/components/StructuredData.astro";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Posts are "article"; everything else is a page. */
  ogType?: "website" | "article";
  /** Share card. Site-relative or absolute; resolved against the site URL. */
  image?: string;
  /** A post's dates. Their presence makes the JSON-LD node a BlogPosting. */
  published?: Date;
  modified?: Date;
}

/* The card in public/. Its dimensions are declared to the scrapers that read
   them before fetching, so they only hold for this file — a caller passing its
   own image gets the tag without the size hints. */
const OG_IMAGE = { src: "/og.png", width: 1200, height: 630 } as const;

const {
  title,
  description = site.description,
  ogType = "website",
  image = OG_IMAGE.src,
  published,
  modified,
} = Astro.props;

const pageTitle = title ? `${site.name} • ${title}` : `${site.name} • Home`;

/*
  Descriptions come from config and post frontmatter, where `[label](url)` is a
  habit — unwrap it to the label so raw Markdown never lands in a meta tag.
*/
const metaDescription = description.replace(/\[([^\]]+)\]\([^)\s]+\)/g, "$1");
const canonical =
  new URL(Astro.url.pathname, site.url).toString().replace(/\/+$/, "") ||
  site.url;

// Absolute — a relative og:image is ignored by every scraper that reads it.
const ogImage = new URL(image, site.url).toString();
const ogImageSize = image === OG_IMAGE.src ? OG_IMAGE : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogImageSize && (
        <>
          <meta property="og:image:width" content={String(ogImageSize.width)} />
          <meta property="og:image:height" content={String(ogImageSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={`${site.author} — ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writing`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${site.name} — Writing`}
      href="/feed.json"
    />
    <meta name="theme-color" content="#0d0d0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    {/* Same prose an agent would otherwise have to infer from the markup. */}
    <StructuredData
      canonical={canonical}
      name={title ?? site.author}
      description={metaDescription}
      image={ogImage}
      published={published}
      modified={modified}
    />

    <ClientRouter />
  </head>

  <body class="min-h-dvh">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-xs focus:bg-overlay focus:px-4 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <div class="flex min-h-dvh flex-col">
      <TopBar />
      <main id="content" class="mx-auto w-full max-w-3xl flex-1 px-5 pt-12 sm:px-6">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* Cross-page transition: a short cross-fade, no travel. */
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root) {
    animation: vt-out 0.12s ease both;
  }
  ::view-transition-new(root) {
    animation: vt-in 0.22s ease both;
  }

  @keyframes vt-out {
    to {
      opacity: 0;
    }
  }
  @keyframes vt-in {
    from {
      opacity: 0;
    }
  }
</style>
