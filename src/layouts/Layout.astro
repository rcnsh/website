---
import { MOTION_BOOTSTRAP } from "../../shared/inline-scripts.ts";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
/* The two subsets an English page actually uses, so they can be preloaded —
   Vite rewrites these to the same hashed files the stylesheet asks for. */
import geistSans from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "@/styles/global.css";

import TopBar from "@/components/TopBar.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Posts are "article"; everything else is a page. */
  ogType?: "website" | "article";
  /** Share card. Site-relative or absolute; resolved against the site URL. */
  image?: string;
  /**
   * Dimensions of `image`, for scrapers that read them before fetching.
   * Defaults to the size every card here is drawn at; null for anything else.
   */
  imageSize?: { width: number; height: number } | null;
}

/* The fallback card in public/, and the size lib/og.ts draws at. */
const OG_IMAGE = { src: "/og.png", width: 1200, height: 630 } as const;

const {
  title,
  description = site.description,
  ogType = "website",
  image = OG_IMAGE.src,
  imageSize: ogImageSize = OG_IMAGE,
} = Astro.props;

const pageTitle = title ? `${site.name} • ${title}` : `${site.name} • Home`;

// Unwrap `[label](url)`, so raw Markdown never lands in a meta tag.
const metaDescription = description.replace(/\[([^\]]+)\]\([^)\s]+\)/g, "$1");
const canonical =
  new URL(Astro.url.pathname, site.url).toString().replace(/\/+$/, "") ||
  site.url;

// Absolute — a relative og:image is ignored by every scraper that reads it.
const ogImage = new URL(image, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* Without these the first paragraph paints twice. `crossorigin`
         because fonts are fetched in CORS mode even from this origin, and a
         preload that does not match is a second download. */
    }
    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogImageSize && (
        <>
          <meta property="og:image:width" content={String(ogImageSize.width)} />
          <meta property="og:image:height" content={String(ogImageSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={`${site.author} — ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writing`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${site.name} — Writing`}
      href="/feed.json"
    />
    <meta name="theme-color" content="#0d0d0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />


    {
      /* The body lives in shared/inline-scripts.ts so astro.config.ts can
         hash the identical string for the CSP. Any new is:inline script must
         be registered there too. */
    }
    <script is:inline set:html={MOTION_BOOTSTRAP} />
  </head>

  <body class="min-h-dvh">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[200] focus:rounded-xs focus:bg-overlay focus:px-4 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <div class="flex min-h-dvh flex-col">
      <TopBar />
      <main id="content" class="mx-auto w-full max-w-3xl flex-1 px-5 pt-12 sm:px-6">
        <slot />
      </main>
      <Footer />
    </div>

    {/* Outside the header: its backdrop-blur would trap a fixed overlay. */}
    <CommandPalette />
  </body>
</html>

