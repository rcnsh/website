---
import Layout from "@/layouts/Layout.astro";
import GuestbookSign from "@/components/react/GuestbookSign";
import GuestbookCountries from "@/components/widgets/GuestbookCountries.astro";
import GuestbookEntries from "@/components/widgets/GuestbookEntries.astro";
import GuestbookMapIsland from "@/components/widgets/GuestbookMapIsland.astro";
import GuestbookTotals from "@/components/widgets/GuestbookTotals.astro";
import { pageOgHref, pages, site } from "@/lib/site";

// Prerendered, so the router keeps the player going into and out of it. What
// is live comes in after load: the totals and signatures as server islands,
// and who is reading from /api/guestbook/signer, which GuestbookSign asks.
const page = pages.guestbook;
const MAX_LENGTH = page.maxMessageLength;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("guestbook")}
>
  <div class="bento" data-guestbook>
    <section
      class="tile page-hero col-span-12 animate-rise max-sm:px-5 max-sm:pt-6 max-sm:pb-[22px] min-[1021px]:col-span-5 min-[1021px]:min-h-[260px]"
      aria-labelledby="gb-title"
    >
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-1.5 font-mono text-[11.5px] text-ink-faint"
      >
        <a href="/" class="transition-colors hover:text-ink">{site.name}</a>
        <span class="text-line-strong" aria-hidden="true">/</span>
        <span aria-current="page">guestbook</span>
      </nav>
      <h1
        id="gb-title"
        class="display-face mt-5 text-[2.4rem] text-ink sm:mt-[26px] sm:text-[clamp(2.25rem,4vw,3rem)]"
      >
        {page.title}
      </h1>
      <GuestbookTotals server:defer>
        <!-- One fact's height, as GuestbookTotals renders it. -->
        <div slot="fallback" aria-hidden="true" class="mt-auto pt-5 sm:pt-[26px]">
          <div class="flex flex-col-reverse gap-[5px]">
            <div class="placeholder-block h-[15px] w-16 rounded-xs"></div>
            <div class="placeholder-block h-7 w-10 rounded-xs"></div>
          </div>
        </div>
      </GuestbookTotals>
    </section>

    <section
      id="gb-sign"
      class="tile col-span-12 flex animate-rise scroll-mt-[calc(var(--header-h)+1.5rem)] flex-col [animation-delay:30ms] min-[1021px]:col-span-7"
      aria-labelledby="gb-sign-title"
    >
      <GuestbookSign client:load maxLength={MAX_LENGTH} />
      <noscript>
        <p class="text-sm text-ink-faint">Signing the guestbook needs JavaScript.</p>
      </noscript>
    </section>

    <section
      class="tile col-span-12 flex animate-rise flex-col [animation-delay:60ms] min-[1021px]:col-span-8"
      aria-labelledby="gb-map-title"
      data-gb-map
    >
      <div class="mb-4 flex items-center gap-2.5">
        <h2 id="gb-map-title" class="label">
          Signed from
        </h2>
      </div>
      {/*
        Its own island so the 118 KB of world outline stays out of the page
        and caches apart from the live totals. The fallback reserves the map's
        820x400 aspect and the caption line, so nothing jumps.
      */}
      <GuestbookMapIsland server:defer>
        <div slot="fallback" class="flex flex-1 flex-col">
          <div class="placeholder-block aspect-[820/400] w-full rounded-card" />
          <div class="mt-3.5 h-[16.5px]" />
        </div>
      </GuestbookMapIsland>
    </section>

    <section
      class="tile col-span-12 flex animate-rise flex-col [animation-delay:90ms] min-[1021px]:col-span-4"
      aria-labelledby="gb-countries-title"
    >
      <GuestbookCountries server:defer>
        <div slot="fallback" aria-hidden="true">
          <div class="mb-4 flex items-center gap-2.5">
            <span id="gb-countries-title" class="label">By country</span>
          </div>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2.5 sm:gap-x-6 min-[1021px]:flex min-[1021px]:flex-col min-[1021px]:gap-[9px]">
            {
              Array.from({ length: 10 }).map(() => (
                <div class="flex flex-col gap-1">
                  <div class="placeholder-block h-[14px] w-24 rounded-xs" />
                  <div class="placeholder-block h-[3px] w-full rounded-[2px]" />
                </div>
              ))
            }
          </div>
        </div>
      </GuestbookCountries>
    </section>

    <section
      class="tile col-span-12 animate-rise [animation-delay:120ms]"
      aria-labelledby="gb-list-title"
    >
      <GuestbookEntries server:defer>
        <div slot="fallback" aria-hidden="true">
          <div class="mb-4 flex items-center gap-2.5">
            <span id="gb-list-title" class="label">Signatures</span>
          </div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-3">
            {
              Array.from({ length: 6 }).map(() => (
                <div class="placeholder-block h-[112px] rounded-card" />
              ))
            }
          </div>
        </div>
      </GuestbookEntries>
    </section>
  </div>
</Layout>

<script>
  import { onPage } from "@/lib/page-lifecycle";

  // Rows and map shapes meet on the ISO code. Both arrive in server islands,
  // after this runs and in either order, so everything is delegated.
  const IDLE_TIP = "";

  const setTip = (text: string) => {
    const tip = document.querySelector<HTMLElement>("[data-map-tip]");
    if (tip && tip.textContent !== text) tip.textContent = text;
  };

  const light = (code: string | undefined, on: boolean) => {
    if (!code || !/^[A-Z]{2}$/.test(code)) return;
    for (const shape of document.querySelectorAll(`[data-gb-map] [data-c="${code}"]`)) {
      shape.classList.toggle("hl", on);
    }
  };

  const titleOf = (code: string | undefined) =>
    code && /^[A-Z]{2}$/.test(code)
      ? document.querySelector(`[data-gb-map] [data-c="${code}"] title`)?.textContent
      : null;

  onPage((signal) => {
    if (!document.querySelector("[data-guestbook]")) return;
    let row: HTMLElement | null = null;

    const track = (target: Element | null) => {
      const next = target?.closest<HTMLElement>("[data-country]") ?? null;
      if (next !== row) {
        light(row?.dataset.country, false);
        row = next;
        light(row?.dataset.country, true);
      }
      if (target?.closest("[data-gb-map]")) {
        setTip(target.closest("[data-c]")?.querySelector("title")?.textContent ?? IDLE_TIP);
      } else {
        setTip((row && titleOf(row.dataset.country)) || IDLE_TIP);
      }
    };

    document.addEventListener("mouseover", (event) => track(event.target as Element), { signal });
    document.addEventListener(
      "mouseout",
      (event) => {
        if (!event.relatedTarget) track(null);
      },
      { signal },
    );
  });
</script>
