---
import Layout from "@/layouts/Layout.astro";
import GuestbookForm from "@/components/react/GuestbookForm";
import GuestbookList from "@/components/react/GuestbookList";
import GuestbookMapIsland from "@/components/widgets/GuestbookMapIsland.astro";
import { GithubIcon } from "@/components/react/BrandIcons";
import { getSession, type SessionUser } from "@/lib/auth";
import { getDb, schema } from "@/lib/db";
import {
  encodeCursor,
  getPage,
  getStats,
  invalidate,
  lastPostedAt,
  type GuestbookEntry,
  type GuestbookStats,
} from "@/lib/guestbook";
import { containsProfanity } from "@/lib/profanity";
import { nextAllowedAt } from "@/lib/rate-limit";
import { relativeTime } from "@/lib/utils";
import { pageOgHref, pages, site } from "@/lib/site";
import { rankCountries } from "@/lib/country-ranking";
import { WORLD_SHAPES } from "@/lib/world";

// Needs the request's cookies, so it can't be prerendered.
export const prerender = false;

const page = pages.guestbook;
const MAX_LENGTH = page.maxMessageLength;

let session: SessionUser | null = null;
let entries: GuestbookEntry[] = [];
let cursor: string | null = null;
let stats: GuestbookStats = { total: 0, counts: {}, unplaced: 0 };
const error: string | null = Astro.url.searchParams.get("error");
const posted = Astro.url.searchParams.has("posted");

/** Set when the signer is inside their 24h window; null when they may post. */
let nextPostAt: Date | null = null;

// A missing D1 binding shouldn't take the page down — show the reason instead.
let dbReady = true;

/**
 * The signer's country, straight off the edge. Read from the request because
 * the adapter's typed locals expose only `cfContext`; hence the cast. Null
 * unless two letters — `cf` is absent under `astro dev`, and Tor reports `T1`.
 */
function signerCountry(): string | null {
  const { cf } = Astro.request as Request & {
    cf?: IncomingRequestCfProperties;
  };

  const code = cf?.country;
  return typeof code === "string" && /^[A-Z]{2}$/.test(code) ? code : null;
}

try {
  session = await getSession(Astro.cookies);
} catch (sessionError) {
  console.error("[guestbook] session lookup failed", sessionError);
  dbReady = false;
}

/** Validates and stores a submission; returns an ERRORS key, or null on success. */
async function sign(): Promise<string | null> {
  const formData = await Astro.request.formData();
  const message = String(formData.get("message") ?? "").trim();

  // A form post is always form-like, so `security.checkOrigin` covers this one
  // and no explicit check is needed — unlike the JSON routes; see lib/csrf.
  if (!session) return "auth";
  if (!message) return "empty";
  if (message.length > MAX_LENGTH) return "long";
  if (containsProfanity(message)) return "profanity";

  try {
    // The form could have been sitting open since before the last message.
    if (nextAllowedAt(await lastPostedAt(session.githubId))) return "rate";

    await getDb().insert(schema.guestbook).values({
      githubId: session.githubId,
      username: session.username,
      displayName: session.displayName,
      avatarUrl: session.avatarUrl,
      message,
      country: signerCountry(),
    });

    // The redirect reads both straight back; drop them first.
    await invalidate();
    return null;
  } catch (insertError) {
    console.error("[guestbook] insert failed", insertError);
    return "db";
  }
}

// Post/redirect/get, so a reload or Back never re-submits the form.
if (dbReady && Astro.request.method === "POST") {
  const failed = await sign();
  return Astro.redirect(
    failed ? `/guestbook?error=${failed}#gb-status` : "/guestbook?posted#gb-status",
    303,
  );
}

if (dbReady) {
  try {
    // One page; GuestbookList fetches the rest as the reader scrolls, and the
    // totals come from a grouped count rather than from tallying rows.
    const [page, totals] = await Promise.all([getPage(), getStats()]);

    entries = page.entries;
    cursor = page.next ? encodeCursor(page.next) : null;
    stats = totals;
  } catch (queryError) {
    console.error("[guestbook] query failed", queryError);
    dbReady = false;
  }
}

const ERRORS: Record<string, string> = {
  state: "That login attempt expired. Give it another go.",
  auth: "Sign in with GitHub first.",
  signin: "GitHub sign-in didn't go through. Give it another go.",
  empty: "Write something before signing.",
  long: `Keep it under ${MAX_LENGTH} characters.`,
  profanity: "Let's keep it friendly.",
  rate: "One message a day — you've already had yours.",
  db: "Couldn't save that. Try again in a moment.",
};

// The signer's own last message, for the "you can sign again" line.
if (dbReady && session && Astro.request.method !== "POST") {
  try {
    nextPostAt = nextAllowedAt(await lastPostedAt(session.githubId));
  } catch (limitError) {
    // The POST path re-checks, so the limit still holds.
    console.error("[guestbook] rate-limit lookup failed", limitError);
  }
}

const ranking = rankCountries(stats.counts);
const countryNames = new Map(
  WORLD_SHAPES.flatMap((shape) => (shape.code ? [[shape.code, shape.name]] : [])),
);
const nameOf = (code: string) => countryNames.get(code) ?? code;
const countryCount = Object.keys(stats.counts).length;
const latest = entries[0] ? new Date(entries[0].createdAt * 1000) : null;
const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("guestbook")}
>
  <div class="bento">
    <section
      class="tile page-hero col-span-12 animate-rise max-sm:px-5 max-sm:pt-6 max-sm:pb-[22px] min-[1021px]:col-span-5 min-[1021px]:min-h-[260px]"
      aria-labelledby="gb-title"
    >
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-1.5 font-mono text-[11.5px] text-ink-faint"
      >
        <a href="/" class="transition-colors hover:text-ink">{site.name}</a>
        <span class="text-line-strong" aria-hidden="true">/</span>
        <span aria-current="page">guestbook</span>
      </nav>
      <h1
        id="gb-title"
        class="display-face mt-5 text-[2.4rem] text-ink sm:mt-[26px] sm:text-[clamp(2.25rem,4vw,3rem)]"
      >
        {page.title}
      </h1>
      <p class="mt-3 max-w-[52ch] text-[0.9375rem] leading-[1.65] text-ink-dim sm:text-[0.96875rem]">
        {page.description}
      </p>
      {
        dbReady && (
          <dl class="mt-auto flex flex-wrap gap-x-8 gap-y-3.5 pt-5 sm:pt-[26px]">
            <div class="flex flex-col-reverse gap-[5px]">
              <dt class="font-mono text-[10.5px] text-ink-faint">
                {plural(stats.total, "Signature", "Signatures")}
              </dt>
              <dd class="font-mono text-lg font-semibold tracking-[-0.02em] text-ink tabular-nums">
                {stats.total}
              </dd>
            </div>
            {countryCount > 0 && (
              <div class="flex flex-col-reverse gap-[5px]">
                <dt class="font-mono text-[10.5px] text-ink-faint">
                  {plural(countryCount, "Country", "Countries")}
                </dt>
                <dd class="font-mono text-lg font-semibold tracking-[-0.02em] text-ink tabular-nums">
                  {countryCount}
                </dd>
              </div>
            )}
            {latest && (
              <div class="flex flex-col-reverse gap-[5px]">
                <dt class="font-mono text-[10.5px] text-ink-faint">Latest</dt>
                <dd class="font-mono text-lg font-semibold tracking-[-0.02em] text-ink">
                  <time datetime={latest.toISOString()}>{relativeTime(latest)}</time>
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </section>

    {
      !dbReady && (
        <p class="tile col-span-12 animate-rise border-warn/30 bg-warn/5 text-sm text-warn [animation-delay:30ms] min-[1021px]:col-span-7">
          The guestbook database isn't reachable. Create the D1 database, set{" "}
          <code class="font-mono">database_id</code> in{" "}
          <code class="font-mono">wrangler.jsonc</code>, then run the migrations.
        </p>
      )
    }

    {
      dbReady && (
        <section
          class="tile col-span-12 flex animate-rise flex-col [animation-delay:30ms] min-[1021px]:col-span-7"
          aria-labelledby="gb-sign-title"
        >
          <div class="mb-4 flex items-center gap-2.5">
            <h2 id="gb-sign-title" class="label">
              Sign the guestbook
            </h2>
            <span class="ml-auto hidden font-mono text-[11px] whitespace-nowrap text-ink-faint sm:inline">
              one message a day · {MAX_LENGTH} characters
            </span>
          </div>

          {session ? (
            <div class="flex flex-1 flex-col">
              <div class="flex items-center gap-3">
                {session.avatarUrl ? (
                  <img
                    src={session.avatarUrl}
                    alt=""
                    width={30}
                    height={30}
                    class="h-[30px] w-[30px] shrink-0 rounded-full"
                  />
                ) : (
                  <span class="h-[30px] w-[30px] shrink-0 rounded-full bg-raised" />
                )}
                <p class="min-w-0 truncate font-mono text-[12.5px] text-ink-dim">
                  @{session.username}
                </p>
                <form method="POST" action="/api/auth/logout" class="ml-auto">
                  <button
                    type="submit"
                    class="-my-2 py-2 font-mono text-xs text-ink-faint underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink-dim hover:decoration-brand"
                  >
                    sign out
                  </button>
                </form>
              </div>

              {nextPostAt ? (
                <p class="mt-4 flex flex-1 items-center gap-2.5 text-sm text-ink-dim">
                  <span
                    class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line-soft text-ok"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span>
                    One message a day. You can sign again{" "}
                    <time datetime={nextPostAt.toISOString()}>
                      {relativeTime(nextPostAt)}
                    </time>
                    .
                  </span>
                </p>
              ) : (
                <GuestbookForm
                  client:load
                  maxLength={MAX_LENGTH}
                  restoreDraft={Boolean(error)}
                />
              )}
            </div>
          ) : (
            <div class="flex flex-1 flex-col justify-center gap-3.5">
              <a
                href="/api/auth/login"
                class="inline-flex items-center gap-2 self-start rounded-[6px] border border-ink bg-ink px-3.5 py-2.5 text-[0.90625rem] leading-[1.3] font-medium text-(color:--color-base) transition-colors hover:bg-white sm:h-10 sm:px-4 sm:py-0"
              >
                <GithubIcon className="h-4 w-4 shrink-0" />
                Sign in with GitHub to leave a message
              </a>
              <p class="max-w-[58ch] text-[0.8125rem] leading-[1.55] text-ink-faint">
                Signing in stores your GitHub username, avatar, and approximate
                country with your message, shown publicly below. You can
                delete your own entry any time.
              </p>
            </div>
          )}

          <div
            id="gb-status"
            role="status"
            class="scroll-mt-[calc(var(--header-h)+1.5rem)]"
          >
            {error && ERRORS[error] && (
              <p class="mt-3 text-[0.84375rem] text-bad">{ERRORS[error]}</p>
            )}

            {posted && !error && (
              <p class="mt-3 text-[0.84375rem] text-ok">Signed — thanks.</p>
            )}
          </div>
        </section>
      )
    }

    {
      dbReady && stats.total > 0 && (
        <section
          class:list={[
            "tile col-span-12 flex animate-rise flex-col [animation-delay:60ms]",
            ranking.top.length > 0 && "min-[1021px]:col-span-8",
          ]}
          aria-labelledby="gb-map-title"
          data-gb-map
        >
          <div class="mb-4 flex items-center gap-2.5">
            <h2 id="gb-map-title" class="label">
              Signed from
            </h2>
          </div>
          {/*
            Deferred so the 118 KB of world outline leaves this document.
            /guestbook renders per-session and so is never edge-cached; the
            map is public and caches on its own. The fallback reserves the
            map's 820x400 aspect and the caption line, so nothing jumps.
          */}
          <GuestbookMapIsland server:defer>
            <div slot="fallback" class="flex flex-1 flex-col">
              <div class="placeholder-block aspect-[820/400] w-full rounded-card" />
              <div class="mt-3.5 h-[16.5px]" />
            </div>
          </GuestbookMapIsland>
        </section>
      )
    }

    {
      dbReady && stats.total > 0 && ranking.top.length > 0 && (
        <section
          class="tile col-span-12 flex animate-rise flex-col [animation-delay:90ms] min-[1021px]:col-span-4"
          aria-labelledby="gb-countries-title"
        >
          <div class="mb-4 flex items-center gap-2.5">
            <h2 id="gb-countries-title" class="label">
              By country
            </h2>
            {ranking.rest.length > 0 && (
              <span class="ml-auto font-mono text-[11px] text-ink-faint">
                top {ranking.top.length}
              </span>
            )}
          </div>
          <ol class="grid grid-cols-2 gap-x-4 gap-y-2.5 sm:gap-x-6 min-[1021px]:flex min-[1021px]:flex-col min-[1021px]:gap-[9px]">
            {ranking.top.map((row) => (
              <li
                data-country={row.code}
                class="group grid grid-cols-[1fr_auto] gap-x-2.5 gap-y-1 font-mono text-[11.5px]"
              >
                <span class="min-w-0 truncate text-ink transition-colors group-hover:text-brand-alt">
                  {nameOf(row.code)}
                </span>
                <span class="text-ink-faint tabular-nums">{row.count}</span>
                <span
                  class="col-span-2 h-[3px] overflow-hidden rounded-[2px] bg-line-soft"
                  aria-hidden="true"
                >
                  <span
                    class="bg-brand-gradient block h-full"
                    style={`width:${(row.share * 100).toFixed(1)}%`}
                  />
                </span>
              </li>
            ))}
          </ol>
          {ranking.rest.length > 0 && (
            <p class="mt-3.5 border-t border-line-soft pt-3 font-mono text-[11px] leading-[1.7] text-ink-faint">
              Also{" "}
              {ranking.rest.map((row, index) => (
                <>
                  {index > 0 && " · "}
                  <span class="text-ink-dim">{nameOf(row.code)}</span>{" "}
                  {row.count}
                </>
              ))}
            </p>
          )}
          {/* getStats() folds small countries into `unplaced`; say why, since
              the map's caption counts them as having no location. */}
          {stats.unplaced > 0 && (
            <p class="mt-auto pt-5 text-[0.75rem] leading-[1.55] text-ink-faint">
              {stats.unplaced} {plural(stats.unplaced, "signature has", "signatures have")}{" "}
              no country listed: older entries predate the column, and a
              country with only a couple of signers is left off so no one can
              be singled out.
            </p>
          )}
        </section>
      )
    }

    {
      dbReady && (
        <section
          class="tile col-span-12 animate-rise [animation-delay:120ms]"
          aria-labelledby="gb-list-title"
        >
          <div class="mb-4 flex items-center gap-2.5">
            <h2 id="gb-list-title" class="label">
              {stats.total} {plural(stats.total, "signature", "signatures")}
            </h2>
            {stats.total > 1 && (
              <span class="ml-auto font-mono text-[11px] text-ink-faint">
                newest first
              </span>
            )}
          </div>

          {/*
            An island because the list is longer than the page shows: the first
            page is server-rendered, the rest arrives on scroll. `client:load`,
            since on a short guestbook this sits above the fold.
          */}
          <GuestbookList
            client:load
            initial={entries}
            initialCursor={cursor}
            sessionGithubId={session?.githubId ?? null}
          />
        </section>
      )
    }
  </div>
</Layout>

<script>
  // Rows and map shapes meet on the ISO code. The map is a server island that
  // can land after this runs, so look shapes up on each hover, not once.
  const IDLE_TIP = "Hover a country";

  const setTip = (text: string) => {
    const tip = document.querySelector<HTMLElement>("[data-map-tip]");
    if (tip) tip.textContent = text;
  };

  const light = (code: string | undefined, on: boolean) => {
    if (!code || !/^[A-Z]{2}$/.test(code)) return;
    for (const shape of document.querySelectorAll(`[data-gb-map] [data-c="${code}"]`)) {
      shape.classList.toggle("hl", on);
    }
  };

  const map = document.querySelector<HTMLElement>("[data-gb-map]");
  map?.addEventListener("mouseover", (event) => {
    const shape = (event.target as Element).closest("[data-c]");
    setTip(shape?.querySelector("title")?.textContent ?? IDLE_TIP);
  });
  map?.addEventListener("mouseleave", () => setTip(IDLE_TIP));

  for (const row of document.querySelectorAll<HTMLElement>("[data-country]")) {
    const code = row.dataset.country;
    row.addEventListener("mouseenter", () => {
      light(code, true);
      const title = document.querySelector(`[data-gb-map] [data-c="${code}"] title`);
      if (title?.textContent) setTip(title.textContent);
    });
    row.addEventListener("mouseleave", () => {
      light(code, false);
      setTip(IDLE_TIP);
    });
  }
</script>
