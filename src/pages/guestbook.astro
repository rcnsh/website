---
import { and, desc, eq, gt } from "drizzle-orm";
import Layout from "@/layouts/Layout.astro";
import GuestbookForm from "@/components/react/GuestbookForm";
import GuestbookMap from "@/components/widgets/GuestbookMap.astro";
import { GithubIcon } from "@/components/react/BrandIcons";
import { getSession } from "@/lib/auth";
import { getDb, schema } from "@/lib/db";
import { containsProfanity } from "@/lib/profanity";
import { nextAllowedAt, WINDOW_MS } from "@/lib/rate-limit";
import { relativeTime } from "@/lib/utils";
import { pages } from "@/lib/site";

// Needs the request's cookies, so it can't be prerendered.
export const prerender = false;

const page = pages.guestbook;
const MAX_LENGTH = page.maxMessageLength;

let session = null;
let entries: (typeof schema.guestbook.$inferSelect)[] = [];
let error: string | null = Astro.url.searchParams.get("error");
let posted = false;

/** Set when the signer is inside their 24h window; null when they may post. */
let nextPostAt: Date | null = null;

// A missing D1 binding shouldn't take the page down — show the reason instead.
let dbReady = true;

/**
 * The signer's country, straight off the edge — no lookup, no third party, and
 * nothing more precise than a country ever stored.
 *
 * Read from the request rather than `Astro.locals`: this adapter's typed
 * locals expose only `cfContext`, the ExecutionContext, and its `runtime`
 * property is deprecated. On Workers the incoming request is the platform's,
 * which carries `cf` — Astro just types it as a standard Request, hence the
 * cast.
 *
 * Null unless it's two letters: `cf` is absent under `astro dev` and on some
 * requests, and Tor reports the placeholder `T1`. All of those mean the same
 * thing to the map.
 */
function signerCountry(): string | null {
  const { cf } = Astro.request as Request & {
    cf?: IncomingRequestCfProperties;
  };

  const code = cf?.country;
  return typeof code === "string" && /^[A-Z]{2}$/.test(code) ? code : null;
}

try {
  session = await getSession(Astro.cookies);
} catch (sessionError) {
  console.error("[guestbook] session lookup failed", sessionError);
  dbReady = false;
}

if (dbReady && Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const message = String(formData.get("message") ?? "").trim();

  // No CSRF check here on purpose: Astro's `security.checkOrigin` is on by
  // default and rejects a cross-site POST with a 403 before this runs.
  if (!session) {
    error = "auth";
  } else if (!message) {
    error = "empty";
  } else if (message.length > MAX_LENGTH) {
    error = "long";
  } else if (containsProfanity(message)) {
    error = "profanity";
  } else {
    try {
      const db = getDb();

      // Re-check the limit here rather than trusting the render below: the
      // form could have been sitting open since before the last message.
      const [recent] = await db
        .select({ createdAt: schema.guestbook.createdAt })
        .from(schema.guestbook)
        .where(
          and(
            eq(schema.guestbook.githubId, session.githubId),
            gt(schema.guestbook.createdAt, new Date(Date.now() - WINDOW_MS)),
          ),
        )
        .orderBy(desc(schema.guestbook.createdAt))
        .limit(1);

      nextPostAt = nextAllowedAt(recent?.createdAt ?? null);

      if (nextPostAt) {
        error = "rate";
      } else {
        await db.insert(schema.guestbook).values({
          githubId: session.githubId,
          username: session.username,
          displayName: session.displayName,
          avatarUrl: session.avatarUrl,
          message,
          country: signerCountry(),
        });
        posted = true;
        error = null;
        nextPostAt = new Date(Date.now() + WINDOW_MS);
      }
    } catch (insertError) {
      console.error("[guestbook] insert failed", insertError);
      error = "db";
    }
  }
}

if (dbReady) {
  try {
    entries = await getDb()
      .select()
      .from(schema.guestbook)
      .orderBy(desc(schema.guestbook.createdAt))
      .limit(200);
  } catch (queryError) {
    console.error("[guestbook] query failed", queryError);
    dbReady = false;
  }
}

const ERRORS: Record<string, string> = {
  state: "That login attempt expired. Give it another go.",
  auth: "Sign in with GitHub first.",
  empty: "Write something before signing.",
  long: `Keep it under ${MAX_LENGTH} characters.`,
  profanity: "Let's keep it friendly.",
  rate: "One message a day — you've already had yours.",
  db: "Couldn't save that. Try again in a moment.",
};

/*
  Tallied from the list already in hand rather than a GROUP BY, since the page
  has every row it's about to render. `T1` and the imported entries have no
  country and fall through to `unplaced`.
*/
const countryCounts: Record<string, number> = {};
let unplaced = 0;

for (const entry of entries) {
  if (entry.country) {
    countryCounts[entry.country] = (countryCounts[entry.country] ?? 0) + 1;
  } else {
    unplaced += 1;
  }
}

// A GET falls back to the freshly-read list, which saves a second query.
if (session && Astro.request.method !== "POST") {
  const latest = entries.find((entry) => entry.githubId === session.githubId);
  nextPostAt = nextAllowedAt(latest?.createdAt ?? null);
}
---

<Layout title={page.title} description={page.description}>
  <header class="animate-rise pb-10">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
  </header>

  {
    !dbReady && (
      <p class="border-y border-amber-500/25 bg-amber-500/5 px-4 py-3 text-sm text-amber-200/90">
        The guestbook database isn't reachable. Create the D1 database, set{" "}
        <code class="font-mono">database_id</code> in{" "}
        <code class="font-mono">wrangler.jsonc</code>, then run the migrations.
      </p>
    )
  }

  {
    dbReady && (
      <>
        <section class="border-y border-line py-6">
          {session ? (
            <>
              <div class="mb-4 flex items-center gap-3">
                {session.avatarUrl && (
                  <img
                    src={session.avatarUrl}
                    alt=""
                    width={28}
                    height={28}
                    class="h-7 w-7 rounded-full"
                  />
                )}
                <p class="min-w-0 truncate font-mono text-xs text-ink-dim">
                  @{session.username}
                </p>
                <form method="POST" action="/api/auth/logout" class="ml-auto">
                  <button
                    type="submit"
                    class="font-mono text-xs text-ink-faint underline decoration-line-strong underline-offset-[3px] transition-colors hover:text-ink-dim"
                  >
                    sign out
                  </button>
                </form>
              </div>

              {nextPostAt ? (
                <p class="text-sm text-ink-faint">
                  One message a day. You can sign again{" "}
                  <time datetime={nextPostAt.toISOString()}>
                    {relativeTime(nextPostAt)}
                  </time>
                  .
                </p>
              ) : (
                <GuestbookForm client:load maxLength={MAX_LENGTH} />
              )}
            </>
          ) : (
            <a
              href="/api/auth/login"
              class="inline-flex items-center gap-2.5 text-[0.9375rem] text-ink underline decoration-line-strong underline-offset-[4px] transition-colors hover:decoration-brand"
            >
              <GithubIcon className="h-4 w-4" />
              Sign in with GitHub to leave a message
            </a>
          )}

          {error && ERRORS[error] && (
            <p class="mt-3 text-sm text-red-400/90">{ERRORS[error]}</p>
          )}

          {posted && (
            <p class="mt-3 text-sm text-emerald-400/90">Signed — thanks.</p>
          )}
        </section>

        {entries.length > 0 && (
          <section class="pt-10">
            <h2 class="rule-heading label mb-6">Signed from</h2>
            <GuestbookMap counts={countryCounts} unplaced={unplaced} />
          </section>
        )}

        <section class="pb-6 pt-10">
          <h2 class="rule-heading label mb-5">
            {entries.length} {entries.length === 1 ? "signature" : "signatures"}
          </h2>

          {entries.length === 0 ? (
            <p class="py-6 text-sm text-ink-faint">
              No one's signed yet. Be the first.
            </p>
          ) : (
            <ul class="divide-y divide-line border-y border-line">
              {entries.map((entry) => (
                <li class="flex gap-3.5 py-4">
                  {entry.avatarUrl ? (
                    <img
                      src={entry.avatarUrl}
                      alt=""
                      width={28}
                      height={28}
                      loading="lazy"
                      class="mt-0.5 h-7 w-7 shrink-0 rounded-full"
                    />
                  ) : (
                    <div class="mt-0.5 h-7 w-7 shrink-0 rounded-full bg-raised" />
                  )}

                  <div class="min-w-0 flex-1">
                    <p class="break-words text-[0.9375rem] leading-relaxed text-ink">
                      {entry.message}
                    </p>
                    <p class="mt-1.5 font-mono text-[11px] text-ink-faint">
                      <a
                        href={`https://github.com/${entry.username}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition-colors hover:text-ink-dim"
                      >
                        @{entry.username}
                      </a>
                      {" · "}
                      <time datetime={entry.createdAt.toISOString()}>
                        {relativeTime(entry.createdAt)}
                      </time>
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</Layout>
