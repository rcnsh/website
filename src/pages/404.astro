---
import Layout from "@/layouts/Layout.astro";
import { pages } from "@/lib/site";

const page = pages.notFound;
---

<Layout title="404" description={page.description}>
  <section class="animate-rise py-20">
    <p class="font-mono text-sm text-ink-faint">404</p>
    <h1 class="display-face mt-3 text-[2.25rem] text-ink">{page.title}</h1>
    <p class="mt-2.5 max-w-[46ch] text-ink-dim">
      Press <kbd class="font-mono text-sm text-ink">⌘K</kbd> to jump somewhere else, or{" "}
      <a
        href="/"
        class="text-ink underline decoration-line-strong underline-offset-[3px] transition-colors hover:decoration-brand"
      >
        go home</a
      >.
    </p>
  </section>
</Layout>
