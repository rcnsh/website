---
import Layout from "@/layouts/Layout.astro";
import FilesRoot from "@/components/widgets/FilesRoot.astro";
import { pageOgHref, pages } from "@/lib/site";

const page = pages.files;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("files")}
>
  <header class="animate-rise pb-10">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
  </header>

  <div class="pb-6">
    <FilesRoot server:defer>
      <div slot="fallback">
        <div class="placeholder-block h-9 rounded-xs"></div>
        <div class="placeholder-block mt-3 h-[320px] rounded-xs"></div>
      </div>
    </FilesRoot>
  </div>
</Layout>
