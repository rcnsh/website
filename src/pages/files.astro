---
import Layout from "@/layouts/Layout.astro";
import FilesRoot from "@/components/widgets/FilesRoot.astro";
import FilesHero from "@/components/files/FilesHero.astro";
import FilesUsage from "@/components/files/FilesUsage.astro";
import { pageOgHref, pages } from "@/lib/site";
// Imported here rather than by the island, so the stylesheet is the page's own.
import "@/components/files/browser.css";

const page = pages.files;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("files")}
>
  <div class="pb-6">
    <FilesRoot server:defer title={page.title} description={page.description}>
      {/* Sized to the island: same title tile, same tile heights. */}
      <div slot="fallback" class="bento">
        <FilesHero title={page.title} description={page.description} />
        <FilesUsage />
        <section class="fb tile col-span-12" aria-label="File browser" aria-busy="true">
          <div class="fb-tb">
            <div class="fb-crumbs"><span class="placeholder-block h-4 w-40 rounded-xs"></span></div>
            <div class="placeholder-block h-[34px] rounded-[6px]"></div>
          </div>
          <div class="fb-cols"></div>
          <div class="fb-foot"></div>
        </section>
      </div>
    </FilesRoot>
  </div>
</Layout>
