---
import Layout from "@/layouts/Layout.astro";
import NowPlaying from "@/components/react/NowPlaying";
import TopMusic from "@/components/widgets/TopMusic.astro";
import RecentTracks from "@/components/widgets/RecentTracks.astro";
import RichText from "@/components/RichText.astro";
import { pages } from "@/lib/site";

const page = pages.music;
---

<Layout title={page.title} description={page.intro}>
  <header class="animate-rise pb-10">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
    <RichText text={page.intro} class="mt-2.5 max-w-[54ch] text-ink-dim" />
  </header>

  <!-- flex+gap, not space-y — islands render as display:contents wrappers. -->
  <div class="flex flex-col gap-14 pb-6">
    <section>
      <h2 class="rule-heading label mb-5">Right now</h2>
      <NowPlaying client:load />
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Top</h2>
      <TopMusic server:defer>
        <div slot="fallback">
          <div class="placeholder-block mb-5 h-3 w-64 rounded-xs"></div>
          <div class="placeholder-block h-[420px] rounded-xs"></div>
        </div>
      </TopMusic>
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Recently played</h2>
      <RecentTracks server:defer>
        <div slot="fallback" class="placeholder-block h-[420px] rounded-xs">
        </div>
      </RecentTracks>
    </section>
  </div>
</Layout>
