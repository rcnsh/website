---
import Layout from "@/layouts/Layout.astro";
import NowPlaying from "@/components/react/NowPlaying";
import TopMusic from "@/components/widgets/TopMusic.astro";
import RecentTracks from "@/components/widgets/RecentTracks.astro";
import { SpotifyIcon } from "@/components/react/BrandIcons";
import { pageOgHref, pages, site } from "@/lib/site";

const page = pages.music;
const profileUrl = `https://open.spotify.com/user/${site.spotifyUser}`;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("music")}
>
  <header class="animate-rise flex items-center gap-7 pb-10">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
    <a
      href={profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="My Spotify profile"
      class="text-ink-faint transition-colors hover:text-brand"
    >
      <SpotifyIcon className="h-6 w-6" />
    </a>
  </header>

  <!-- flex+gap, not space-y — islands render as display:contents wrappers. -->
  <div class="flex flex-col gap-14 pb-6">
    <section>
      <h2 class="rule-heading label mb-5">Right now</h2>
      <NowPlaying client:idle />
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Top</h2>
      <TopMusic server:defer>
        <!-- Mirrors MusicExplorer's controls and twelve rows, so the
             sections below don't jump when it lands. -->
        <div slot="fallback" aria-hidden="true">
          <div class="mb-5 flex flex-wrap items-baseline gap-x-6 gap-y-3 font-mono text-xs text-ink-faint">
            <div class="flex gap-4">
              {["tracks", "artists"].map((label) => (
                <span class="border-b border-transparent pb-0.5">{label}</span>
              ))}
            </div>
            <span class="hidden text-line-strong sm:inline">/</span>
            <div class="flex gap-4">
              {["4 weeks", "6 months", "all time"].map((label) => (
                <span class="border-b border-transparent pb-0.5">{label}</span>
              ))}
            </div>
          </div>
          <ol class="divide-y divide-line border-y border-line">
            {
              Array.from({ length: 12 }).map(() => (
                <li class="flex items-center gap-4 py-2.5">
                  <span class="w-5 shrink-0" />
                  <div class="placeholder-block h-9 w-9 shrink-0 rounded-xs" />
                  <span class="min-w-0 flex-1">
                    <span class="block text-[0.9375rem]">
                      <span class="placeholder-block inline-block h-3 w-40 rounded-xs align-middle" />
                    </span>
                    <span class="block text-xs">
                      <span class="placeholder-block inline-block h-2.5 w-24 rounded-xs align-middle" />
                    </span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </TopMusic>
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Recently played</h2>
      <RecentTracks server:defer>
        <!-- Row for row with RecentTracks.astro's fifteen. -->
        <ol slot="fallback" aria-hidden="true" class="divide-y divide-line border-y border-line">
          {
            Array.from({ length: 15 }).map(() => (
              <li class="flex items-center gap-4 py-2.5">
                <div class="placeholder-block h-8 w-8 shrink-0 rounded-xs" />
                <span class="min-w-0 flex-1">
                  <span class="block text-[0.9375rem]">
                    <span class="placeholder-block inline-block h-3 w-40 rounded-xs align-middle" />
                  </span>
                  <span class="block text-xs">
                    <span class="placeholder-block inline-block h-2.5 w-24 rounded-xs align-middle" />
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
      </RecentTracks>
    </section>
  </div>
</Layout>
