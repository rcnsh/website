---
import Layout from "@/layouts/Layout.astro";
import UsesArt from "@/components/uses/UsesArt.astro";
import { pageOgHref, pages, uses } from "@/lib/site";

const page = pages.uses;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("uses")}
>
  <header class="animate-rise pb-10">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
  </header>

  {/* Each group is a plate on the diagram; its name breaks the top rule. */}
  <div class="flex flex-col gap-14 pb-6">
    {
      uses.groups.map((group) => (
        <section class="relative rounded-xs border border-line px-5 pb-8 pt-10 sm:px-7">
          {/*
            The inset subtracts the label's own px-2.5, so the *text* lands on
            the section's content edge rather than 10px right of it. It also
            has to track the section's padding, which steps 1.25rem -> 1.75rem
            at `sm`; the old `left-5 sm:left-6` tracked neither, so the label
            sat 10px off below `sm` and 4px off above it — a misalignment that
            changed at the breakpoint.
          */}
          <h2
            class="label absolute -top-[0.5em] left-[calc(1.25rem-0.625rem)] select-none bg-base px-2.5 sm:left-[calc(1.75rem-0.625rem)]"
          >
            {group.title}
          </h2>

          {/*
            Flex-wrap with a fixed basis, not a grid: the group sizes do not
            divide into full rows at any breakpoint, and centring splits the
            leftover space evenly rather than dumping it on the right. The
            basis values reproduce the grid's column widths.
          */}
          <ul class="flex flex-wrap justify-center gap-x-4 gap-y-9">
            {group.items.map((item) => {
              const Tag = item.url ? "a" : "div";

              return (
                <li class="basis-[calc(50%-0.5rem)] sm:basis-[calc(33.333%-0.75rem)] md:basis-[calc(16.666%-0.875rem)]">
                  <Tag
                    {...(item.url
                      ? {
                          href: item.url,
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                    class="group/item flex flex-col items-center gap-3 text-center"
                  >
                    <UsesArt
                      name={item.art}
                      class="h-[4.5rem] w-[4.5rem] text-ink-dim transition-colors duration-200 group-hover/item:text-ink"
                    />

                    <span class="flex flex-col gap-1">
                      {/*
                        Two lines reserved, because a name that wraps used to
                        push its detail line 15px out of the row's baseline at
                        >=768 — the captions in one row stopped agreeing on
                        where they start.
                      */}
                      <span class="min-h-[2lh] font-mono text-[0.75rem] leading-tight text-ink">
                        {item.name}
                      </span>
                      {item.detail && (
                        <span class="font-mono text-[0.6875rem] leading-tight text-ink-faint">
                          {item.detail}
                        </span>
                      )}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
