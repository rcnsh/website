---
import Layout from "@/layouts/Layout.astro";
import UsesArt from "@/components/uses/UsesArt.astro";
import { pageOgHref, pages, uses } from "@/lib/site";

const page = pages.uses;
---

<Layout
  title={page.title}
  description={page.description}
  image={pageOgHref("uses")}
>
  <header class="animate-rise pb-12">
    <h1 class="display-face text-[2.25rem] text-ink">{page.title}</h1>
  </header>

  {/* Each group is a plate on the diagram; its name breaks the top rule. */}
  <div class="flex flex-col gap-12 pb-6">
    {
      uses.groups.map((group) => (
        <section class="relative rounded-xs border border-line px-5 pb-8 pt-10 sm:px-7">
          <h2
            class="label absolute -top-[0.5em] left-5 select-none bg-base px-2.5 sm:left-6"
          >
            {group.title}
          </h2>

          {/*
            Fixed counts, not auto-fit: the groups are 6, 5, 6 and 4 items, and
            auto-fit was landing 5 across and orphaning the last one on its own
            row. These divide the groups into full rows at every width.
          */}
          <ul class="grid grid-cols-2 gap-x-4 gap-y-9 sm:grid-cols-3 md:grid-cols-6">
            {group.items.map((item) => {
              const Tag = item.url ? "a" : "div";

              return (
                <li>
                  <Tag
                    {...(item.url
                      ? {
                          href: item.url,
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                    class="group/item flex flex-col items-center gap-3 text-center"
                  >
                    <UsesArt
                      name={item.art}
                      class="h-[4.5rem] w-[4.5rem] text-ink-dim transition-colors duration-200 group-hover/item:text-ink"
                    />

                    <span class="flex flex-col gap-1">
                      <span class="font-mono text-[0.75rem] leading-tight text-ink">
                        {item.name}
                      </span>
                      {item.detail && (
                        <span class="font-mono text-[0.6875rem] leading-tight text-ink-faint">
                          {item.detail}
                        </span>
                      )}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
