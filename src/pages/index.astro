---
import Layout from "@/layouts/Layout.astro";
import RichText from "@/components/RichText.astro";
import Figure from "@/components/home/Figure.astro";
import FilesFigure from "@/components/home/FilesFigure.astro";
import GuestbookFigure from "@/components/home/GuestbookFigure.astro";
import LedgerSection from "@/components/home/LedgerSection.astro";
import NowPlaying from "@/components/react/NowPlaying";
import Clock from "@/components/widgets/Clock.astro";
import Contributions from "@/components/widgets/Contributions.astro";
import Repos from "@/components/widgets/Repos.astro";
import Stack from "@/components/widgets/Stack.astro";
import Stats from "@/components/widgets/Stats.astro";
import { formatDate, getPosts, isoDate, postHref, readingTime } from "@/lib/blog";
import { externalLinks, home, site } from "@/lib/site";

const recentPosts = (await getPosts()).slice(0, 3);
const [firstName, ...rest] = site.author.split(" ");
const github = externalLinks.find((link) => link.icon === "github");
const githubHref = github?.href ?? `https://github.com/${site.githubUser}`;
// "/pgp_key.asc.txt" → "pgp_key.asc": what each link points at, after its name.
const elsewhere = externalLinks.map((link) => ({
  ...link,
  external: /^https?:/.test(link.href),
  detail: link.href.split("/").pop()!.replace(/\.txt$/, ""),
}));
---

<Layout>
  {/*
    The field. The canvas behind the page (Lattice.astro) draws what is
    playing on the mark's own triangle grid, inside this section's box; the
    text sits over the side it dissolves on.
  */}
  <section slot="hero" class="hero" data-lattice="cover" data-lattice-intro aria-labelledby="who">
    <div class="hero-frame mx-auto flex w-full max-w-page flex-col px-4 sm:px-5">
      <h1 id="who" class="hero-name display-face text-ink">
        <span class="hero-line"><span>{firstName}</span></span>
        <span class="hero-line"><span>{rest.join(" ")}</span></span>
      </h1>
      <p class="hero-rise mt-5 font-mono text-[13px] text-ink-dim">{site.tagline}</p>

      <RichText
        text={home.bio}
        class="hero-rise mt-6 block max-w-[46ch] text-[16.5px] leading-[1.7] text-ink-dim max-sm:text-[16px]"
      />

      <div class="hero-rise hero-foot mt-auto pt-10">
        <section class="hero-playing" aria-label="Listening">
          <NowPlaying client:load layout="home" />
        </section>
        <p class="hero-key mt-3.5 flex items-center gap-2.5 font-mono text-[11.5px] text-ink-faint">
          <span class="hero-key-swatches" aria-hidden="true">
            <i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
          </span>
          <span class="min-w-0 truncate">
            The triangles are drawing <span class="text-ink-dim" data-lattice-caption>the rcn mark</span>
          </span>
        </p>
      </div>
    </div>
  </section>

  {/*
    The ledger: one numbered entry per subject, read top to bottom. Each
    server island renders inside its own entry, so a slow one holds its place
    and nothing reflows into it. From 1280px the short entries pair up, so
    the whole ledger fits a screen under the header.
  */}
  <div class="flex-1 pb-6 xl:grid xl:grid-cols-2 xl:grid-rows-[auto_auto_auto_1fr] xl:pb-0">
    <LedgerSection n={1} label="Writing" id="writing-heading" link={{ href: "/blog", text: "all posts" }} col="start">
      {
        recentPosts.length > 0 ? (
          <ul class="divide-y divide-line-soft">
            {recentPosts.map((post) => (
              <li>
                <a href={postHref(post)} class="row-tick group block">
                  <div class="grid gap-x-6 gap-y-1.5 py-4 md:grid-cols-[7rem_minmax(0,1fr)_auto] xl:py-3.5 md:items-baseline xl:grid-cols-[auto_minmax(0,1fr)] [li:first-child_&]:pt-0.5">
                    <time class="font-mono text-[13px] text-ink-faint" datetime={isoDate(post.data.pubDate)}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    <div class="xl:col-span-2 xl:row-start-2">
                      <h3 class="text-[18px] font-medium leading-snug text-ink transition-colors group-hover:text-brand-alt">
                        {post.data.title}
                        {post.data.draft && <span class="label ml-2 align-middle text-brand">draft</span>}
                      </h3>
                      <p class="mt-1.5 text-[14.5px] leading-[1.55] text-ink-dim xl:truncate">{post.data.description}</p>
                    </div>
                    <span class="font-mono text-[13px] text-ink-faint max-md:hidden xl:col-start-2 xl:row-start-1 xl:justify-self-end">{readingTime(post.body)} min</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-faint">Nothing published yet.</p>
        )
      }
    </LedgerSection>

    <LedgerSection n={2} label="Here & now" id="now-heading" col="end">
      <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-3 xl:grid-cols-2 xl:gap-y-4">
        <Clock />
        <Stats server:defer>
          <Fragment slot="fallback">
            <Figure label="Repos" detail="public" />
            <Figure label="Followers" detail="on GitHub" />
            <Figure label="On GitHub since" />
          </Fragment>
        </Stats>
        <FilesFigure server:defer>
          <Figure slot="fallback" label="Files" href="/files" />
        </FilesFigure>
        <GuestbookFigure server:defer>
          <Figure slot="fallback" label="Guestbook" href="/guestbook" />
        </GuestbookFigure>
      </div>
    </LedgerSection>

    <LedgerSection n={3} label="The year" id="contrib-heading" link={{ href: githubHref, text: "github", external: true }}>
      <Contributions server:defer>
        <Contributions slot="fallback" pending />
      </Contributions>
    </LedgerSection>

    <LedgerSection
      n={4}
      label="Selected work"
      id="repos-heading"
      link={{ href: githubHref + "?tab=repositories", text: "all repos", external: true }}
    >
      <Repos server:defer>
        <Repos slot="fallback" pending />
      </Repos>
    </LedgerSection>

    <LedgerSection n={5} label="Uses" id="stack-heading" link={{ href: "/uses", text: "full setup" }} col="start">
      <Stack />
    </LedgerSection>

    <LedgerSection n={6} label="Elsewhere" id="elsewhere-heading" col="end">
      <ul class="flex flex-wrap gap-x-8 gap-y-2 font-mono text-[15px]">
        {
          elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group rule-link inline-flex items-baseline gap-2 text-ink transition-colors hover:text-brand-alt"
              >
                {link.label}
                <span class="text-ink-faint">{link.detail}</span>
                <span aria-hidden="true" class="text-ink-faint transition-colors group-hover:text-brand-alt">
                  {link.external ? "↗" : "→"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </LedgerSection>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
  }

  /* The ledger's first rule is the hero's foot, and the footer closes its
     last row, so nothing but the ledger stands between them. Any slack goes
     into that last row, so its divider runs down to the footer's rule. */
  :global(main:has(> .hero)) {
    display: flex;
    flex-direction: column;
  }
  .hero + :global(div) {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 0;
  }
  :global(.page-shell:has(> main > .hero) > footer) {
    margin-top: 0;
  }

  /* The rest of the page is at least a screen too, so scrolled to the
     bottom the hero's rule meets the header's, as it meets the screen's
     foot at the top. The slack goes into the ledger's last row. From
     1280px the ledger pairs its short entries to fit one screen exactly
     where it can (LedgerSection.astro). */
  @media (min-width: 768px) {
    :global(.page-shell:has(> main > .hero)) {
      min-height: calc(200svh - var(--header-h));
    }
  }

  .hero-frame {
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(1.5rem, 4vh, 2.75rem);
  }

  /* Sized so the surname ends before the cover turns solid. */
  .hero-name {
    font-size: clamp(3.25rem, 9.2vw, 9.5rem);
    letter-spacing: -0.065em;
    line-height: 0.86;
    margin-left: -0.045em;
    /* Where a letter crosses a lit triangle, the ground comes with it. */
    text-shadow: 0 0 0.35em var(--color-base);
  }

  .hero-line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }

  /* Each line slides up its own slot along the lattice's slant. */
  .hero-line > span {
    display: block;
    animation: hero-line 0.9s var(--ease-out-quint) both;
  }
  .hero-line:nth-child(2) > span {
    animation-delay: 0.07s;
  }

  @keyframes hero-line {
    from {
      opacity: 0.01;
      translate: -0.58em 1em;
    }
  }

  .hero-rise {
    animation: var(--animate-rise);
    animation-delay: 0.22s;
  }
  .hero-foot {
    animation-delay: 0.32s;
  }

  .hero-playing {
    width: min(100%, 27rem);
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-tile);
    background: color-mix(in oklab, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .hero-key {
    width: min(100%, 27rem);
  }
  .hero-key-swatches {
    display: flex;
    flex: none;
    gap: 3px;
  }
  .hero-key-swatches i {
    width: 13px;
    height: 11px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .hero-key-swatches i:nth-child(even) {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    margin-inline: -5px;
  }
  .hero-key-swatches [data-level="1"] {
    background: color-mix(in oklab, var(--color-brand-deep) 40%, var(--color-raised));
  }
  .hero-key-swatches [data-level="2"] {
    background: color-mix(in oklab, var(--color-brand-deep) 65%, var(--color-raised));
  }
  .hero-key-swatches [data-level="3"] {
    background: var(--color-brand-deep);
  }
  .hero-key-swatches [data-level="4"] {
    background: var(--color-brand);
  }

  /* A phone: the cover runs edge to edge across the top and the text starts
     where it thins out. */
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }
    .hero-frame {
      /* The cover's inset below the header, then its last thin scatter, which
         the name's text-shadow grounds. */
      padding-top: calc(22px + 88vw);
    }
    .hero-name {
      font-size: 17.5vw;
    }
  }
</style>
