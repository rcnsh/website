---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import Contributions from "@/components/widgets/Contributions.astro";
import Repos from "@/components/widgets/Repos.astro";
import Stack from "@/components/widgets/Stack.astro";
import Stats from "@/components/widgets/Stats.astro";
import ClockTile from "@/components/widgets/ClockTile.astro";
import NowPlaying from "@/components/react/NowPlaying";
import PostList from "@/components/PostList.astro";
import RichText from "@/components/RichText.astro";
import { getPosts } from "@/lib/blog";
import { home, site } from "@/lib/site";

const recentPosts = (await getPosts()).slice(0, 3);
---

<Layout>
  <!-- Masthead -->
  <section class="animate-rise pb-10 pt-2 sm:pt-6">
    <Logo class="h-10 w-auto sm:h-12" />

    <h1
      class="display-face mt-7 text-[2.75rem] text-ink sm:text-[4rem]"
    >
      {site.author}
    </h1>
    <p class="mt-3.5 font-mono text-[0.8125rem] text-ink-faint">
      {site.tagline}
    </p>

    <RichText
      text={home.bio}
      class="mt-9 max-w-[56ch] text-[1.0625rem] leading-[1.75] text-ink-dim"
    />
  </section>

  <!--
    flex+gap, not space-y — islands render as display:contents, so `> * + *`
    margins would land on zero-height elements.
  -->
  <div class="flex flex-col gap-14 pb-6">
    <!-- Facts strip. display:contents on the island makes these siblings. -->
    <dl
      class="flex flex-wrap gap-x-12 gap-y-5 border-y border-line py-5"
    >
      <ClockTile />
      <Stats server:defer>
        <Fragment slot="fallback">
          {
            Array.from({ length: 3 }).map(() => (
              <div>
                <div class="placeholder-block h-2.5 w-16 rounded-xs" />
                <div class="placeholder-block mt-2.5 h-4 w-10 rounded-xs" />
              </div>
            ))
          }
        </Fragment>
      </Stats>
    </dl>

    {
      recentPosts.length > 0 && (
        <section>
          <h2 class="rule-heading label mb-2">Writing</h2>
          <PostList posts={recentPosts} />
          <a
            href="/blog"
            class="label mt-5 inline-block transition-colors hover:text-ink-dim"
          >
            All posts &rarr;
          </a>
        </section>
      )
    }

    <section>
      <h2 class="rule-heading label mb-5">Listening</h2>
      <NowPlaying client:visible />
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Contributions</h2>
      <Contributions server:defer>
        <div slot="fallback" class="placeholder-block h-[137px] rounded-xs">
        </div>
      </Contributions>
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Uses</h2>
      <Stack />
    </section>

    <Repos server:defer>
      <!-- Row for row with Repos.astro (four repos), so nothing below jumps. -->
      <div slot="fallback" aria-hidden="true">
        <div class="rule-heading label mb-5">Selected work</div>
        <ul class="divide-y divide-line border-y border-line">
          {
            Array.from({ length: 4 }).map(() => (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="w-full shrink-0 font-mono text-sm sm:w-[15rem]">
                  <span class="placeholder-block inline-block h-3 w-32 rounded-xs align-middle" />
                </span>
                <span class="flex-1 text-[0.9375rem] leading-relaxed">
                  <span class="placeholder-block inline-block h-3 w-full max-w-72 rounded-xs align-middle" />
                  {/* Descriptions usually wrap to a second line. */}
                  <span class="placeholder-block inline-block h-3 w-40 rounded-xs align-middle" />
                </span>
                <span class="shrink-0 font-mono text-[11px]">
                  <span class="placeholder-block inline-block h-2.5 w-20 rounded-xs align-middle" />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </Repos>
  </div>
</Layout>
