---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import Contributions from "@/components/widgets/Contributions.astro";
import Repos from "@/components/widgets/Repos.astro";
import Stack from "@/components/widgets/Stack.astro";
import Stats from "@/components/widgets/Stats.astro";
import ClockTile from "@/components/widgets/ClockTile.astro";
import NowPlaying from "@/components/react/NowPlaying";
import PostList from "@/components/PostList.astro";
import RichText from "@/components/RichText.astro";
import { getPosts } from "@/lib/blog";
import { home, site, stack } from "@/lib/site";
import { agentGuidance, agentSite, postSummaries } from "@/lib/agent-content";
import { buildHomeMarkdown } from "@/lib/agent-docs";
import { markdownResponse } from "@/lib/negotiate";

/* Rendered per request so the Accept header can be read — a prerendered page is
   served straight from Cloudflare's asset store and the Worker never runs. The
   page itself is only a template; the three widgets that cost anything are
   server islands and were already deferred. */
export const prerender = false;

const markdown = Astro.locals.prefersMarkdown
  ? markdownResponse(
      buildHomeMarkdown({
        site: agentSite,
        agent: agentGuidance,
        bio: home.bio,
        stack: [...stack],
        posts: await postSummaries(),
      }),
    )
  : null;

if (markdown) return markdown;

const recentPosts = (await getPosts()).slice(0, 3);
---

<Layout>
  <!-- Masthead -->
  <section class="animate-rise pb-12 pt-2 sm:pt-6">
    <Logo class="h-10 w-auto sm:h-12" />

    <h1
      class="display-face mt-7 text-[2.75rem] text-ink sm:text-[4rem]"
    >
      {site.author}
    </h1>
    <p class="mt-3.5 font-mono text-[0.8125rem] text-ink-faint">
      {site.tagline}
    </p>

    <RichText
      text={home.bio}
      class="mt-9 max-w-[56ch] text-[1.0625rem] leading-[1.75] text-ink-dim"
    />
  </section>

  <!--
    flex+gap, not space-y — islands render as display:contents, so `> * + *`
    margins would land on zero-height elements.
  -->
  <div class="flex flex-col gap-14 pb-6">
    <!-- Facts strip. display:contents on the island makes these siblings. -->
    <dl
      class="flex flex-wrap gap-x-12 gap-y-5 border-y border-line py-5"
    >
      <ClockTile />
      <Stats server:defer>
        <Fragment slot="fallback">
          {
            Array.from({ length: 3 }).map(() => (
              <div>
                <div class="placeholder-block h-2.5 w-16 rounded-xs" />
                <div class="placeholder-block mt-2.5 h-4 w-10 rounded-xs" />
              </div>
            ))
          }
        </Fragment>
      </Stats>
    </dl>

    {
      recentPosts.length > 0 && (
        <section>
          <h2 class="rule-heading label mb-2">Writing</h2>
          <PostList posts={recentPosts} />
          <a
            href="/blog"
            class="label mt-5 inline-block transition-colors hover:text-ink-dim"
          >
            All posts &rarr;
          </a>
        </section>
      )
    }

    <section>
      <h2 class="rule-heading label mb-5">Listening</h2>
      <NowPlaying client:visible />
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Contributions</h2>
      <Contributions server:defer>
        <div slot="fallback" class="placeholder-block h-[124px] rounded-xs">
        </div>
      </Contributions>
    </section>

    <section>
      <h2 class="rule-heading label mb-5">Uses</h2>
      <Stack />
    </section>

    <Repos server:defer>
      <div slot="fallback">
        <div class="rule-heading label mb-5">Selected work</div>
        <div class="placeholder-block h-[260px] rounded-xs"></div>
      </div>
    </Repos>
  </div>
</Layout>
