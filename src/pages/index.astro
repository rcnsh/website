---
import Layout from "@/layouts/Layout.astro";
import RichText from "@/components/RichText.astro";
import FilesTile from "@/components/home/FilesTile.astro";
import GuestbookTile from "@/components/home/GuestbookTile.astro";
import LinkTile from "@/components/home/LinkTile.astro";
import NowPlaying from "@/components/react/NowPlaying";
import ClockTile from "@/components/widgets/ClockTile.astro";
import Contributions from "@/components/widgets/Contributions.astro";
import Repos from "@/components/widgets/Repos.astro";
import Stack from "@/components/widgets/Stack.astro";
import StatTile from "@/components/home/StatTile.astro";
import Stats from "@/components/widgets/Stats.astro";
import { formatDate, getPosts, isoDate, postHref, readingTime } from "@/lib/blog";
import { externalLinks, home, site } from "@/lib/site";

const recentPosts = (await getPosts()).slice(0, 3);
const [firstName, ...rest] = site.author.split(" ");
const github = externalLinks.find((link) => link.icon === "github");
const pgp = externalLinks.find((link) => link.icon === "key");
---

<Layout>
  {/*
    The field. The canvas behind the page (Lattice.astro) draws what is
    playing on the mark's own triangle grid, inside this section's box; the
    text sits over the side it dissolves on.
  */}
  <section slot="hero" class="hero" data-lattice="cover" aria-labelledby="who">
    <div class="hero-frame mx-auto flex w-full max-w-page flex-col px-4 sm:px-5">
      <h1 id="who" class="hero-name display-face text-ink">
        <span class="hero-line"><span>{firstName}</span></span>
        <span class="hero-line"><span>{rest.join(" ")}</span></span>
      </h1>
      <p class="hero-rise mt-5 font-mono text-[13px] text-ink-dim">{site.tagline}</p>

      <RichText
        text={home.bio}
        class="hero-rise mt-6 block max-w-[46ch] text-[16.5px] leading-[1.7] text-ink-dim max-sm:text-[16px]"
      />

      <div class="hero-rise hero-foot mt-auto pt-10">
        <section class="hero-playing" aria-label="Listening">
          <NowPlaying client:load layout="home" />
        </section>
        <p class="hero-key mt-3.5 flex items-center gap-2.5 font-mono text-[11.5px] text-ink-faint">
          <span class="hero-key-swatches" aria-hidden="true">
            <i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
          </span>
          <span class="min-w-0 truncate">
            The triangles are drawing <span class="text-ink-dim" data-lattice-caption>the rcn mark</span>
          </span>
        </p>
      </div>
    </div>
  </section>

  {/*
    Every tile names its grid area, and the areas are restated per breakpoint
    below, so a tile that is slow to arrive (a server island) holds its place
    rather than letting the others reflow into it. Islands emit no wrapper, so
    their tiles are direct children of the grid too.
  */}
  <div class="home-grid bento pb-2">
    <ClockTile class="[grid-area:ck]" />

    <Stats server:defer>
      <Fragment slot="fallback">
        <StatTile class="[grid-area:s1]" label="Repos" />
        <StatTile class="[grid-area:s2]" label="Followers" />
        <StatTile class="[grid-area:s3]" label="On GitHub since" />
      </Fragment>
    </Stats>

    <section class="tile flex flex-col [grid-area:wr]" aria-labelledby="writing-heading">
      <div class="mb-4 flex items-center gap-2.5">
        <h2 class="label" id="writing-heading">Writing</h2>
        <a href="/blog" class="ml-auto rule-link font-mono text-[11px] text-ink-faint transition-colors hover:text-ink">
          All posts &rarr;
        </a>
      </div>

      {
        recentPosts.length > 0 ? (
          <ul class="flex flex-1 flex-col divide-y divide-line-soft">
            {recentPosts.map((post) => (
              <li>
                <a href={postHref(post)} class="row-tick group block py-[15px] [li:first-child_&]:pt-0.5"><div>
                  <time class="font-mono text-[11px] text-ink-faint" datetime={isoDate(post.data.pubDate)}>
                    {formatDate(post.data.pubDate)} · {readingTime(post.body)} min
                  </time>
                  <h3 class="mt-1.5 text-[16px] font-medium leading-snug text-ink transition-colors group-hover:text-brand-alt">
                    {post.data.title}
                    {post.data.draft && <span class="label ml-2 align-middle text-brand">draft</span>}
                    <span
                      aria-hidden="true"
                      class="inline-block -translate-x-1 text-brand opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100"
                    >
                      &rarr;
                    </span>
                  </h3>
                  <p class="mt-1.5 text-[13.5px] leading-[1.55] text-ink-dim">{post.data.description}</p>
                </div></a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-faint">Nothing published yet.</p>
        )
      }
    </section>

    <Contributions server:defer>
      <Contributions slot="fallback" pending />
    </Contributions>

    <FilesTile server:defer>
      <LinkTile slot="fallback" class="[grid-area:fl]" href="/files" title="Files" detail={{ pending: "00 objects · 000 MB on R2" }} icon="file" />
    </FilesTile>

    <Repos server:defer>
      <Repos slot="fallback" pending />
    </Repos>

    <Stack />

    <LinkTile
      class="[grid-area:gh]"
      href={github?.href ?? `https://github.com/${site.githubUser}`}
      title="GitHub"
      detail={`@${site.githubUser}`}
      icon="github"
      external
    />

    {
      pgp && (
        <LinkTile
          class="[grid-area:pg]"
          href={pgp.href}
          title={pgp.label}
          detail={pgp.href.split("/").pop()!.replace(/\.txt$/, "")}
          icon="key"
        />
      )
    }

    <GuestbookTile server:defer>
      <LinkTile slot="fallback" class="[grid-area:gb]" href="/guestbook" title="Guestbook" detail={{ pending: "00 signatures" }} icon="book" />
    </GuestbookTile>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    border-bottom: 1px solid var(--color-line-soft);
  }

  .hero-frame {
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(1.5rem, 4vh, 2.75rem);
  }

  /* Sized so the surname ends before the cover turns solid. */
  .hero-name {
    font-size: clamp(3.25rem, 9.2vw, 9.5rem);
    letter-spacing: -0.065em;
    line-height: 0.86;
    margin-left: -0.045em;
    /* Where a letter crosses a lit triangle, the ground comes with it. */
    text-shadow: 0 0 0.35em var(--color-base);
  }

  .hero-line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
  }

  /* Each line slides up its own slot along the lattice's slant. */
  .hero-line > span {
    display: block;
    animation: hero-line 0.9s var(--ease-out-quint) both;
  }
  .hero-line:nth-child(2) > span {
    animation-delay: 0.07s;
  }

  @keyframes hero-line {
    from {
      opacity: 0.01;
      translate: -0.58em 1em;
    }
  }

  .hero-rise {
    animation: var(--animate-rise);
    animation-delay: 0.22s;
  }
  .hero-foot {
    animation-delay: 0.32s;
  }

  .hero-playing {
    width: min(100%, 27rem);
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-tile);
    background: color-mix(in oklab, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .hero-key {
    width: min(100%, 27rem);
  }
  .hero-key-swatches {
    display: flex;
    flex: none;
    gap: 3px;
  }
  .hero-key-swatches i {
    width: 13px;
    height: 11px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .hero-key-swatches i:nth-child(even) {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    margin-inline: -5px;
  }
  .hero-key-swatches [data-level="1"] {
    background: color-mix(in oklab, var(--color-brand-deep) 40%, var(--color-raised));
  }
  .hero-key-swatches [data-level="2"] {
    background: color-mix(in oklab, var(--color-brand-deep) 65%, var(--color-raised));
  }
  .hero-key-swatches [data-level="3"] {
    background: var(--color-brand-deep);
  }
  .hero-key-swatches [data-level="4"] {
    background: var(--color-brand);
  }

  /* A phone: the cover runs edge to edge across the top and the text starts
     where it thins out. */
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }
    .hero-frame {
      padding-top: 68vw;
    }
    .hero-name {
      font-size: 17.5vw;
    }
  }

  .home-grid {
    margin-top: 0.25rem;
    grid-auto-rows: minmax(104px, auto);
    grid-template-areas:
      "wr wr wr wr wr hm hm hm hm hm hm hm"
      "wr wr wr wr wr hm hm hm hm hm hm hm"
      "ck ck ck s1 s1 s2 s2 s3 s3 fl fl fl"
      "rp rp rp rp rp rp rp st st st st st"
      "rp rp rp rp rp rp rp gh gh gh pg pg"
      "rp rp rp rp rp rp rp gb gb gb gb gb";
  }

  @media (max-width: 1020px) {
    .home-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        "wr wr wr wr wr wr"
        "hm hm hm hm hm hm"
        "ck ck ck s1 s1 s1"
        "s2 s2 s2 s3 s3 s3"
        "rp rp rp rp rp rp"
        "rp rp rp rp rp rp"
        "st st st st st st"
        "gh gh gh pg pg pg"
        "gb gb gb fl fl fl";
    }
  }

  @media (max-width: 640px) {
    .home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      grid-template-areas:
        "wr wr" "hm hm" "ck ck" "s1 s2" "s3 s3" "rp rp" "st st"
        "gh pg" "gb fl";
    }
  }
</style>
