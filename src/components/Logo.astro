---
import {
  LOGO_PLATE,
  LOGO_PLATE_VIEWBOX,
  LOGO_POLYGONS,
  LOGO_VIEWBOX,
} from "@/lib/logo";

interface Props {
  class?: string;
  /** Renders the dark rounded plate behind the glyph, like a favicon. */
  plate?: boolean;
}

const { class: className, plate = false } = Astro.props;

/**
 * The cropped viewBox is the mark's real bounds (≈3.46:1), so `h-8` means
 * eight units of logo rather than of mostly-empty canvas. Size by height, width
 * auto. The plate variant keeps the full square.
 */
const viewBox = plate ? LOGO_PLATE_VIEWBOX : LOGO_VIEWBOX;
---

<svg
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="rcn.sh"
  class={className}
>
  {plate && <rect width="1080" height="1080" rx="220" fill={LOGO_PLATE} />}
  <g>
    {
      LOGO_POLYGONS.map((polygon) => (
        <polygon fill={polygon.fill} points={polygon.points} />
      ))
    }
  </g>
</svg>
