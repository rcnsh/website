---
interface Props {
  class?: string;
  /** Renders the dark rounded plate behind the glyph, like a favicon. */
  plate?: boolean;
}

const { class: className, plate = false } = Astro.props;

/**
 * The source artwork is a wide, short mark centred in a 1080² canvas — it
 * fills 75% of the width but only 22% of the height, so a square box renders
 * a glyph a fifth of its apparent size. Cropping to the real bounds makes the
 * SVG's box the mark itself, so `h-8` means eight units of *logo*.
 * Aspect ratio is 815.34 / 235.38 ≈ 3.46:1 — size it by height, width auto.
 *
 * The plate variant keeps the full square, since the plate is the square.
 */
const viewBox = plate ? "0 0 1080 1080" : "132.33 422.31 815.34 235.38";
---

<svg
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="rcn.sh"
  class={className}
>
  {plate && <rect width="1080" height="1080" rx="220" fill="#181818" />}
  <g>
    <polygon
      fill="#5b66af"
      points="947.67 500.78 902.38 579.22 857.08 657.67 766.48 657.67 811.77 579.22 857.07 500.78 766.48 500.78 721.19 579.22 675.88 657.67 585.3 657.67 630.59 579.22 539.99 579.22 585.28 500.78 675.88 500.78 675.88 500.76 721.17 422.31 902.38 422.31 902.38 422.33 947.67 500.78"
    ></polygon>
    <polygon
      fill="#305b99"
      points="494.7 500.78 449.41 579.22 494.7 657.67 494.7 657.69 404.1 657.69 404.1 657.67 358.81 579.22 404.1 500.78 313.52 500.78 268.23 579.22 222.92 657.69 132.33 657.69 177.62 579.24 177.64 579.22 222.93 500.78 268.23 422.33 268.23 422.31 539.99 422.31 494.7 500.78"
    ></polygon>
  </g>
</svg>
