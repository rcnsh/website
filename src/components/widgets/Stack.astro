---
import { stack } from "@/lib/site";

// Primary tools come first and carry the dot, so they read as the day-to-day
// set and the rest as the supporting cast.
const ordered = [...stack.filter((item) => item.primary), ...stack.filter((item) => !item.primary)];
---

<section class="tile [grid-area:st]" aria-labelledby="stack-heading">
  <div class="mb-4 flex items-center gap-2.5">
    <h2 class="label" id="stack-heading">Uses</h2>
    <a
      href="/uses"
      class="ml-auto font-mono text-[11px] text-ink-faint transition-colors hover:text-ink"
    >
      Full setup &rarr;
    </a>
  </div>

  <ul class="flex flex-wrap gap-1.5">
    {
      ordered.map((item) => (
        <li>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center gap-[7px] rounded border px-2.5 py-1.5 font-mono text-xs transition-colors",
              item.primary
                ? "border-line bg-raised text-ink hover:border-line-strong"
                : "border-line-soft text-ink-dim hover:border-line-strong hover:text-ink",
            ]}
          >
            {item.primary && <i class="bg-brand-gradient h-[5px] w-[5px] rounded-full" aria-hidden="true" />}
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</section>
