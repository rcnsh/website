---
import { uses } from "@/lib/site";
import { homeStack } from "@/lib/uses";

// Drawn from /uses so the two cannot drift. Primary tools are in full ink, so
// they read as the day-to-day set and the rest as the supporting cast.
const ordered = homeStack(uses.groups);
---

<ul class="flex flex-wrap items-baseline gap-y-1 font-mono text-[15px] leading-[1.9]">
  {
    ordered.map((item, index) => (
      <li class="inline-flex items-baseline">
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "rule-link transition-colors",
            item.home === "primary" ? "text-ink hover:text-brand-alt" : "text-ink-dim hover:text-ink",
          ]}
        >
          {item.name}
        </a>
        {/* After the item, so a wrapped line never opens on a separator. */}
        {index < ordered.length - 1 && (
          <span class="px-2.5 text-ink-faint" aria-hidden="true">
            ·
          </span>
        )}
      </li>
    ))
  }
</ul>
