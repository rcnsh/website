---
import { getContributions } from "@/lib/github";
import { summarise } from "@/lib/contrib-summary";

// A server island, so a slow GitHub response never blocks the page. The loader
// throws, so `data === null` means one thing — no GITHUB_TOKEN — and `failed`
// means the request itself did not work.
let data: Awaited<ReturnType<typeof getContributions>> = null;
let failed = false;
try {
  data = await getContributions();
} catch (error) {
  failed = true;
  console.error("[github] contributions island failed", error);
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Month labels sit above the first week that starts a new month.
const monthStarts: { index: number; label: string }[] = [];
if (data) {
  let previous = -1;
  data.weeks.forEach((week, index) => {
    const first = week[0];
    if (!first) return;
    const month = new Date(first.date).getUTCMonth();
    if (month !== previous && index < data.weeks.length - 1) {
      monthStarts.push({ index, label: MONTHS[month]! });
      previous = month;
    }
  });
}

// The year starts mid-month, so the leading month may own one column and its
// label would run into the next. Three columns clear a three-letter label at
// the narrowest a column gets.
const monthLabels = monthStarts.filter((start, position) => {
  const next = monthStarts[position + 1];
  return !next || next.index - start.index >= 3;
});

const summary = data ? summarise(data.weeks) : null;
const DAY = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const weekCount = data?.weeks.length ?? 53;
---

<section class="tile flex flex-col [grid-area:hm]" aria-labelledby="contrib-heading">
  <div class="mb-4 flex items-center gap-2.5">
    <h2 class="label" id="contrib-heading">Contributions</h2>
    {
      data && (
        <span class="ml-auto font-mono text-[11px] text-ink-dim">
          <b class="font-semibold text-ink">{data.total.toLocaleString("en-GB")}</b> in the last year
        </span>
      )
    }
  </div>

  {
    data && summary ? (
      <>
        <dl class="mb-[18px] flex gap-8">
          {[
            { label: "Longest streak", value: `${summary.longestStreak} day${summary.longestStreak === 1 ? "" : "s"}` },
            { label: "This week", value: String(summary.thisWeek) },
            { label: "Busiest day", value: summary.busiest ? DAY.format(new Date(summary.busiest.date)) : "—" },
          ].map((fact) => (
            <div class="flex flex-col-reverse gap-[5px]">
              <dt class="font-mono text-[10.5px] text-ink-faint">{fact.label}</dt>
              <dd class="font-mono text-lg font-semibold tracking-[-0.02em] tabular-nums text-ink">{fact.value}</dd>
            </div>
          ))}
        </dl>

        {/* prettier-ignore */}
        <div
          data-contrib-scroller
          class="mt-auto overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [--fade-l:0px] [--fade-r:0px] [mask-image:linear-gradient(to_right,transparent_0,#000_var(--fade-l),#000_calc(100%-var(--fade-r)),transparent_100%)]"
        >
          {/* Columns stretch to the tile and stop shrinking at 8px, where the scroller takes over. */}
          <div
            class="grid min-w-full gap-[3px]"
            style={`grid-template-columns: 22px repeat(${weekCount}, minmax(8px, 1fr))`}
          >
            <span />
            {monthLabels.map(({ index, label }) => (
              <span
                class="col-span-3 font-mono text-[10px] leading-3 text-ink-faint"
                style={`grid-column-start: ${index + 2}`}
              >
                {label}
              </span>
            ))}

            <div class="row-start-2 mr-1 grid grid-rows-7 gap-[3px] font-mono text-[9px] text-ink-faint">
              {["", "Mon", "", "Wed", "", "Fri", ""].map((day) => (
                <span class="flex items-center leading-none">{day}</span>
              ))}
            </div>

            {data.weeks.map((week) => {
              // Placed by weekday, not position, so a short week at either
              // end still lines up with the Mon/Wed/Fri labels.
              const byWeekday = new Map(
                week.map((day) => [new Date(day.date).getUTCDay(), day]),
              );
              return (
                <div class="row-start-2 grid grid-rows-7 gap-[3px]">
                  {Array.from({ length: 7 }, (_, day) => {
                    const cell = byWeekday.get(day);
                    if (!cell) return <span class="aspect-square" />;
                    return (
                      <span
                        class="aspect-square rounded-[2px]"
                        data-level={cell.level}
                        data-contrib-day={`${cell.count} contribution${cell.count === 1 ? "" : "s"} on ${DAY.format(new Date(cell.date))}`}
                        title={`${cell.count} contribution${cell.count === 1 ? "" : "s"} on ${cell.date}`}
                      />
                    );
                  })}
                </div>
              );
            })}
          </div>
        </div>

        <div class="mt-3 flex items-center gap-1.5 font-mono text-[10.5px] text-ink-faint">
          <span data-contrib-tip class="min-h-[1em] text-ink-dim" aria-hidden="true">Hover a day</span>
          <span class="ml-auto">Less</span>
          {[0, 1, 2, 3, 4].map((level) => (
            <span class="h-2.5 w-2.5 rounded-[2px]" data-level={level} />
          ))}
          <span>More</span>
        </div>
      </>
    ) : failed ? (
      <p class="py-4 text-sm text-ink-faint">Couldn't reach GitHub.</p>
    ) : (
      <p class="py-4 text-sm text-ink-faint">
        Set <code class="font-mono text-ink-dim">GITHUB_TOKEN</code> to show the
        contribution graph.
      </p>
    )
  }
</section>

<style>
  [data-level="0"] {
    background: var(--color-raised);
  }
  [data-level="1"] {
    background: color-mix(in oklab, var(--color-brand-deep) 40%, var(--color-raised));
  }
  [data-level="2"] {
    background: color-mix(in oklab, var(--color-brand-deep) 65%, var(--color-raised));
  }
  [data-level="3"] {
    background: var(--color-brand-deep);
  }
  [data-level="4"] {
    background: var(--color-brand);
  }

  [data-contrib-day]:hover {
    outline: 1px solid var(--color-ink);
    outline-offset: -1px;
  }
</style>

<script>
  import { edgeFade } from "@/lib/edge-fade";

  // The graph is wider than the scroller on phones with the scrollbar
  // suppressed, so fade whichever edge is cutting content off and start
  // scrolled to the recent end. `edgeFade` holds that decision so it can be
  // unit-tested — see CLAUDE.md § Maintenance › Gotchas.
  //
  // Island markup arrives after this script has run, hence the observer below.
  function initScroller(scroller: HTMLElement) {
    if (scroller.hasAttribute("data-contrib-ready")) return;
    scroller.setAttribute("data-contrib-ready", "");

    const sync = () => {
      const { left, right } = edgeFade(
        scroller.scrollLeft,
        scroller.scrollWidth,
        scroller.clientWidth,
      );
      scroller.style.setProperty("--fade-l", `${left}px`);
      scroller.style.setProperty("--fade-r", `${right}px`);
    };

    const overflow = scroller.scrollWidth - scroller.clientWidth;
    // `instant`: not motion a reader has to sit through.
    if (overflow > 0) scroller.scrollTo({ left: overflow, behavior: "instant" });

    sync();
    scroller.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync, { passive: true });

    // The footer echoes the hovered day; the title attribute covers touch and
    // assistive tech, so this is pointer-only.
    const tip = scroller.parentElement?.querySelector<HTMLElement>("[data-contrib-tip]");
    if (tip) {
      const resting = tip.textContent;
      scroller.addEventListener("pointerover", (event) => {
        const day = (event.target as HTMLElement).dataset.contribDay;
        if (day) tip.textContent = day;
      });
      scroller.addEventListener("pointerleave", () => {
        tip.textContent = resting;
      });
    }
  }

  function setupContributions(): boolean {
    const scrollers = document.querySelectorAll<HTMLElement>("[data-contrib-scroller]");
    for (const scroller of scrollers) initScroller(scroller);
    return scrollers.length > 0;
  }

  if (!setupContributions()) {
    // Disconnects as soon as the island lands, so this is not a standing cost.
    const observer = new MutationObserver(() => {
      if (setupContributions()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>
