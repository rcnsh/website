---
import { getRecentTracks } from "@/lib/spotify";
import { RECENT_WINDOW } from "@/lib/listening";
import { ordinal } from "@/lib/music-stats-view";
import { relativeTime } from "@/lib/utils";
import PlayButton from "@/components/music/PlayButton.astro";

const RECENT_SHOWN = 15;

let tracks: Awaited<ReturnType<typeof getRecentTracks>> = [];
let failed = false;
try {
  // The stats tile's window, so both read one cache entry.
  tracks = (await getRecentTracks(RECENT_WINDOW)).slice(0, RECENT_SHOWN);
} catch (error) {
  failed = true;
  console.error("[music] recent tracks island failed", error);
}

/** "first listen", "17th play", or nothing for a play the warehouse can't number. */
function playLabel(track: (typeof tracks)[number]): string | null {
  if (track.firstPlay) return "first listen";
  return track.playNumber && track.playNumber > 1 ? `${ordinal(track.playNumber)} play` : null;
}
---

{
  failed ? (
    <p class="py-6 text-sm text-ink-faint">Couldn't reach the music warehouse.</p>
  ) : tracks.length === 0 ? (
    <p class="py-6 text-sm text-ink-faint">Nothing to show yet.</p>
  ) : (
    <ol class="divide-y divide-line-soft border-t border-line-soft">
      {tracks.map((track) => {
        const label = playLabel(track);
        return (
          // The title's link stretches over the row, so the whole row opens the
          // song, while each artist links on its own above it.
          <li class="group relative flex items-center gap-3.5 py-[9px]">
            {track.image ? (
              <img
                src={track.image}
                alt=""
                width={32}
                height={32}
                loading="lazy"
                class="h-8 w-8 shrink-0 rounded-xs bg-raised object-cover"
              />
            ) : (
              <div class="h-8 w-8 shrink-0 rounded-xs bg-raised" />
            )}

            <span class="min-w-0 flex-1">
              <span class="flex items-center gap-1.5">
                <a
                  href={track.url ?? "#"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="truncate text-[14.5px] text-ink transition-colors after:absolute after:inset-0 group-hover:text-brand-alt"
                >
                  {track.title}
                </a>
                <PlayButton trackId={track.trackId} title={track.title} />
              </span>
              <span class="mt-px block truncate text-[12.5px] text-ink-dim">
                {track.credits.length
                  ? track.credits.map((credit, i) => (
                      <>
                        {i > 0 && ", "}
                        {credit.url ? (
                          <a
                            href={credit.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="relative z-10 transition-colors hover:text-ink"
                          >
                            {credit.name}
                          </a>
                        ) : (
                          credit.name
                        )}
                      </>
                    ))
                  : track.artists}
                {track.context && <span class="text-ink-faint"> · from {track.context}</span>}
              </span>
            </span>

            <span class="shrink-0 text-right font-mono text-[11px] leading-tight text-ink-faint">
              {label && (
                <span class:list={["block", track.firstPlay ? "text-brand-alt" : "text-ink-dim"]}>{label}</span>
              )}
              <time datetime={track.playedAt}>{relativeTime(track.playedAt)}</time>
            </span>
          </li>
        );
      })}
    </ol>
  )
}
