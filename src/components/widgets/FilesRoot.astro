---
import FileBrowser from "@/components/react/FileBrowser";
import {
  cachedTree,
  listDirectory,
  publicBucketBase,
  type R2Listing,
  type R2Tree,
} from "@/lib/r2";

/*
 * Server island. Ships the whole directory tree with the page, or — once the
 * bucket is too big for that — just the root, leaving the client to lazy-load
 * the rest from /api/files/list.
 */
let tree: R2Tree | null = null;
let root: R2Listing | null = null;

try {
  tree = await cachedTree();
  root = tree ? (tree[""] ?? null) : await listDirectory("");
} catch (error) {
  console.error("[files] listing failed", error);
}
---

<FileBrowser
  client:idle
  tree={tree}
  initial={root}
  bucketUrl={publicBucketBase()}
/>
