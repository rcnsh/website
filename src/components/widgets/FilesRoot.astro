---
import FileBrowser from "@/components/react/FileBrowser";
import FilesHero from "@/components/files/FilesHero.astro";
import FilesUsage from "@/components/files/FilesUsage.astro";
import { bucket, type PublicSummary } from "@/lib/bucket";
import { bucketTotals } from "@/lib/bucket-totals";
import { kindTotals } from "@/lib/files-nav";
import { publicBucketBase } from "@/lib/r2";

// Server island, and the whole page below the top bar: the title tile's
// figures, the usage tile and the browser all come from one read of the tree.
// It ships the whole directory tree with the page, or just the root once the
// bucket outgrows that. Listed folders only, for everyone: the edge caches
// this island for all readers, so the owner's full view loads client-side.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

let summary: PublicSummary = { tree: null, root: null, hidden: null, ownerSlots: 0 };
try {
  // Sizes only, never names: the bar shows visitors how much is private.
  summary = await bucket.publicSummary();
} catch (error) {
  console.error("[files] listing failed", error);
}
const { tree, root, hidden, ownerSlots } = summary;

const totals = tree ? bucketTotals(tree) : null;
const kinds = tree ? kindTotals(tree) : null;
---

<div class="bento">
  <FilesHero title={title} description={description} totals={totals} wide={!kinds?.length} />
  {kinds && kinds.length > 0 && <FilesUsage kinds={kinds} hidden={hidden} ownerSlots={ownerSlots} />}
  <FileBrowser client:idle tree={tree} initial={root} bucketUrl={publicBucketBase()} />
</div>
