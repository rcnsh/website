---
import { getStats } from "@/lib/guestbook";
import { rankCountries } from "@/lib/country-ranking";
import { WORLD_SHAPES } from "@/lib/world";

// Server island, never cached (`islandPolicy` in lib/http): it agrees with
// the totals beside it on the page a post redirects to. The map may lag by
// its 60s; it is the same counts, but a heavy fragment.
let ranking: ReturnType<typeof rankCountries> = { top: [], rest: [] };
let unplaced = 0;
let failed = false;

try {
  const stats = await getStats();
  ranking = rankCountries(stats.counts);
  unplaced = stats.unplaced;
} catch (error) {
  failed = true;
  console.error("[guestbook] countries island failed", error);
}

const countryNames = new Map(WORLD_SHAPES.flatMap((shape) => (shape.code ? [[shape.code, shape.name]] : [])));
const nameOf = (code: string) => countryNames.get(code) ?? code;
---

<div class="mb-4 flex items-center gap-2.5">
  <h2 id="gb-countries-title" class="label">By country</h2>
  {
    ranking.rest.length > 0 && (
      <span class="ml-auto font-mono text-[11px] text-ink-faint">top {ranking.top.length}</span>
    )
  }
</div>
{failed && <p class="text-sm text-ink-faint">Couldn't load the countries.</p>}
{!failed && ranking.top.length === 0 && <p class="text-sm text-ink-faint">No countries yet.</p>}
{
  ranking.top.length > 0 && (
    <ol class="grid grid-cols-2 gap-x-4 gap-y-2.5 sm:gap-x-6 min-[1021px]:flex min-[1021px]:flex-col min-[1021px]:gap-[9px]">
      {ranking.top.map((row) => (
        <li
          data-country={row.code}
          class="group grid grid-cols-[1fr_auto] gap-x-2.5 gap-y-1 font-mono text-[11.5px]"
        >
          <span class="min-w-0 truncate text-ink transition-colors group-hover:text-brand-alt">
            {nameOf(row.code)}
          </span>
          <span class="text-ink-faint tabular-nums">{row.count}</span>
          <span class="col-span-2 h-[3px] overflow-hidden rounded-[2px] bg-line-soft" aria-hidden="true">
            <span class="bg-brand-gradient block h-full" style={`width:${(row.share * 100).toFixed(1)}%`} />
          </span>
        </li>
      ))}
    </ol>
  )
}
{
  ranking.rest.length > 0 && (
    <p class="mt-3.5 border-t border-line-soft pt-3 font-mono text-[11px] leading-[1.7] text-ink-faint">
      Also{" "}
      {ranking.rest.map((row, index) => (
        <>
          {index > 0 && " · "}
          <span class="text-ink-dim">{nameOf(row.code)}</span> {row.count}
        </>
      ))}
    </p>
  )
}
{/* getStats() folds small countries into `unplaced`; say why, since the
    map's caption counts them as having no location. */}
{
  unplaced > 0 && (
    <p class="mt-auto pt-5 text-[0.75rem] leading-[1.55] text-ink-faint">
      {unplaced} {unplaced === 1 ? "signature has" : "signatures have"} no country listed: older
      entries predate the column, and a country with only a couple of signers is left off so no
      one can be singled out.
    </p>
  )
}
