---
import { getProfile } from "@/lib/github";

// Deferred island. The page owns the <dl>; <astro-island> is display:contents,
// so these land as its direct children.
//
// The loader throws on failure now rather than caching a null, so the catch is
// here. The strip still degrades to em dashes — there is nowhere in a three-cell
// <dl> to put a sentence — but the failure is logged rather than silent.
let profile: Awaited<ReturnType<typeof getProfile>> = null;
try {
  profile = await getProfile();
} catch (error) {
  console.error("[github] stats island failed", error);
}
const since = profile ? new Date(profile.createdAt).getFullYear() : null;

const facts = [
  { label: "Repos", value: profile ? String(profile.publicRepos) : "—" },
  { label: "Followers", value: profile ? String(profile.followers) : "—" },
  { label: "On GitHub since", value: since ? String(since) : "—" },
];
---

{
  facts.map((fact) => (
    <div>
      <dt class="label">{fact.label}</dt>
      <dd class="mt-1.5 font-mono text-base tabular-nums text-ink">
        {fact.value}
      </dd>
    </div>
  ))
}
