---
import StatTile from "@/components/home/StatTile.astro";
import { getProfile } from "@/lib/github";

// Deferred island. Three tiles in three separate grid areas: the island emits
// no wrapper, so each lands as a direct child of the page grid.
//
// The loader throws on failure rather than caching a null, so the catch is
// here. The tiles still degrade to em dashes — there is no room in a figure
// tile for a sentence — but the failure is logged rather than silent.
let profile: Awaited<ReturnType<typeof getProfile>> = null;
try {
  profile = await getProfile();
} catch (error) {
  console.error("[github] stats island failed", error);
}
const since = profile ? new Date(profile.createdAt).getFullYear() : null;
const years = since ? new Date().getFullYear() - since : null;
---

<StatTile
  class="[grid-area:s1]"
  label="Repos"
  value={profile ? String(profile.publicRepos) : "—"}
  detail="public"
/>
<StatTile
  class="[grid-area:s2]"
  label="Followers"
  value={profile ? String(profile.followers) : "—"}
  detail="on GitHub"
/>
<StatTile
  class="[grid-area:s3]"
  label="On GitHub since"
  value={since ? String(since) : "—"}
  detail={years ? `${years} year${years === 1 ? "" : "s"}` : undefined}
/>
