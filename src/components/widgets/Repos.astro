---
import { getFeaturedRepos } from "@/lib/github";
import { languageColour } from "@/lib/languages";
import { pinnedRepos } from "@/lib/site";
import { relativeTime } from "@/lib/utils";

interface Props {
  /** Render the island's own fallback: four rows, nothing in them yet. */
  pending?: boolean;
}

const { pending = false } = Astro.props;
const SHOWN = 4;

// The loader throws rather than caching an empty list, so an empty result and
// a failed one stay distinguishable here.
let repos: Awaited<ReturnType<typeof getFeaturedRepos>> = [];
let failed = false;
if (!pending) {
  try {
    repos = await getFeaturedRepos(pinnedRepos, SHOWN);
  } catch (error) {
    failed = true;
    console.error("[github] repos island failed", error);
  }
}

// Below 1024px a third column squeezes the description to five lines or
// more, so the meta goes under it there.
const row = "grid gap-x-6 gap-y-1 py-3.5 md:grid-cols-[10.5rem_minmax(0,1fr)] md:items-baseline lg:grid-cols-[10.5rem_minmax(0,1fr)_auto]";
const meta = "font-mono text-[12.5px] md:col-start-2 lg:col-start-auto";
---

{
  pending ? (
    // The sample is as long as a typical description (about 100 characters),
    // so it wraps to the same lines at every width.
    <ul class="divide-y divide-line-soft" aria-hidden="true">
      {Array.from({ length: SHOWN }, () => (
        <li class="[&:first-child>div]:pt-0.5">
          <div class={row}>
            <span class="font-mono text-[14.5px] font-medium">
              <span class="placeholder-text w-28" />
            </span>
            <p class="text-[14.5px] leading-[1.55] xl:truncate">
              <span class="placeholder-ghost">
                A small tool that does one job from where you already are, on the web and on the devices you carry.
              </span>
            </p>
            <span class={meta}>
              <span class="placeholder-text w-28" />
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : failed ? (
    <p class="text-sm text-ink-faint">
      Couldn't reach GitHub.
      {import.meta.env.DEV && (
        <>
          {" "}Set <code class="font-mono text-ink-dim">GITHUB_TOKEN</code> to
          raise the rate limit.
        </>
      )}
    </p>
  ) : repos.length === 0 ? (
    <p class="text-sm text-ink-faint">Nothing to show yet.</p>
  ) : (
    <ul class="divide-y divide-line-soft">
      {repos.map((repo) => (
        <li>
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="row-tick group block [li:first-child_&>div]:pt-0.5"
          >
            <div class={row}>
              <span class="font-mono text-[14.5px] font-medium text-ink transition-colors group-hover:text-brand-alt">
                {repo.name}
              </span>
              <p class="text-[14.5px] leading-[1.55] text-ink-dim xl:truncate" title={repo.description ?? undefined}>{repo.description ?? "No description."}</p>
              <span class:list={[meta, "flex flex-wrap items-center gap-x-3 whitespace-nowrap text-ink-faint"]}>
                {repo.language && (
                  <span class="inline-flex items-center gap-1.5">
                    <i class="h-[7px] w-[7px] rounded-full" style={`background: ${languageColour(repo.language)}`} />
                    {repo.language}
                  </span>
                )}
                {repo.stars > 0 && <span>★ {repo.stars}</span>}
                <span>{relativeTime(repo.updatedAt)}</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
