---
import { getFeaturedRepos } from "@/lib/github";
import { languageColour } from "@/lib/languages";
import { pinnedRepos } from "@/lib/site";
import { relativeTime } from "@/lib/utils";

// The loader throws rather than caching an empty list, so an empty result and
// a failed one stay distinguishable here.
let repos: Awaited<ReturnType<typeof getFeaturedRepos>> = [];
let failed = false;
try {
  repos = await getFeaturedRepos(pinnedRepos, 4);
} catch (error) {
  failed = true;
  console.error("[github] repos island failed", error);
}
---

<section class="tile flex flex-col [grid-area:rp]" aria-labelledby="repos-heading">
  <div class="mb-4 flex items-center gap-2.5">
    <h2 class="label" id="repos-heading">Selected work</h2>
    <a
      href="https://go.rcn.sh/github"
      target="_blank"
      rel="noopener noreferrer"
      class="ml-auto font-mono text-[11px] text-ink-faint transition-colors hover:text-ink"
    >
      All repos &rarr;
    </a>
  </div>

  {
    failed ? (
      <p class="py-6 text-sm text-ink-faint">
        Couldn't reach GitHub.
        {import.meta.env.DEV && (
          <>
            {" "}Set <code class="font-mono text-ink-dim">GITHUB_TOKEN</code> to
            raise the rate limit.
          </>
        )}
      </p>
    ) : repos.length === 0 ? (
      <p class="py-6 text-sm text-ink-faint">Nothing to show yet.</p>
    ) : (
      <ul class="grid flex-1 gap-2.5 sm:grid-cols-2">
        {repos.map((repo) => (
          <li class="flex">
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-1 flex-col rounded-card border border-line-soft bg-[color-mix(in_oklab,var(--color-base)_50%,var(--color-surface))] px-4 pb-3.5 pt-4 transition-colors hover:border-line-strong hover:bg-raised"
            >
              <span class="font-mono text-sm font-medium text-ink transition-colors group-hover:text-brand-alt">
                {repo.name}
              </span>
              <p class="mb-3.5 mt-2 text-[13.5px] leading-[1.55] text-ink-dim">
                {repo.description ?? "No description."}
              </p>
              <span class="mt-auto flex flex-wrap gap-x-3.5 gap-y-1 font-mono text-[11px] text-ink-faint">
                {repo.language && (
                  <span class="inline-flex items-center gap-1.5">
                    <i
                      class="h-2 w-2 rounded-full"
                      style={`background: ${languageColour(repo.language)}`}
                    />
                    {repo.language}
                  </span>
                )}
                {repo.stars > 0 && <span>★ {repo.stars}</span>}
                <span>{relativeTime(repo.updatedAt)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
