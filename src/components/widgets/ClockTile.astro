---
import { clock } from "@/lib/site";

/**
 * Static, not a server island: Astro hoists component <script> tags to page
 * load, before a deferred island's HTML exists, so the script would find
 * nothing. Shows my time, not the visitor's — see `clock.timeZone`.
 */
---

<div>
  <dt class="label">{clock.label}</dt>
  {
    /* Config comes in via data attributes — importing site.ts would ship Zod. */
  }
  <dd
    class="mt-1.5 font-mono text-base tabular-nums text-ink"
    data-clock
    data-tz={clock.timeZone}
    data-hour12={String(clock.hour12)}
  >
    --:--:--
  </dd>
</div>

<script>
  import { liveUpdates, onPrefChange } from "@/lib/prefs";

  const start = () => {
    const node = document.querySelector<HTMLElement>("[data-clock]");
    if (!node) return;

    // Built once — constructing a formatter is the slow part.
    const format = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: node.dataset.hour12 === "true",
      timeZone: node.dataset.tz || "UTC",
    });

    const render = () => {
      node.textContent = format.format(new Date());
    };

    // Everything this page-load binds, retired together before the next swap.
    const bindings = new AbortController();
    let id = 0;

    /**
     * Start or stop the tick, according to the live-updates switch.
     *
     * Ticking is the entire point of a clock, so turning updates off cannot
     * just stop the interval and walk away — that leaves a wrong time on
     * screen, which reads as broken rather than as paused. The reading is
     * redrawn whenever the tab is looked at again, so the case that would
     * genuinely mislead — a page left open for an hour and come back to —
     * cannot happen. What is left is a second hand that stands still while
     * someone who asked for that watches it.
     */
    const sync = () => {
      window.clearInterval(id);
      id = 0;
      render();
      if (liveUpdates()) id = window.setInterval(render, 1000);
    };

    document.addEventListener(
      "visibilitychange",
      () => {
        if (!document.hidden && !liveUpdates()) render();
      },
      { signal: bindings.signal },
    );

    onPrefChange("live", sync, bindings.signal);
    sync();

    // Clear before the next transition so intervals don't stack up.
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.clearInterval(id);
        bindings.abort();
      },
      { once: true },
    );
  };

  start();
  document.addEventListener("astro:page-load", start);
</script>
