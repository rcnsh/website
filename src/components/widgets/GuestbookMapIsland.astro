---
import GuestbookMap from "./GuestbookMap.astro";
import { getStats } from "@/lib/guestbook";

/**
 * The map, as a deferred island — for cacheability, not latency. GuestbookMap
 * inlines the whole world outline, and /guestbook itself cannot be edge-cached.
 * This fragment reads no session, so the edge can hold it.
 *
 * It takes no props on purpose: island props ride the encrypted `?e=` query
 * parameter, so passing the counts in would defeat the caching. See CLAUDE.md
 * § Maintenance › Caching.
 */
let counts: Record<string, number> = {};
let unplaced = 0;
let failed = false;

try {
  const stats = await getStats();
  counts = stats.counts;
  unplaced = stats.unplaced;
} catch (error) {
  failed = true;
  console.error("[guestbook] map island failed", error);
}
---

{
  failed ? (
    <p class="py-6 text-sm text-ink-faint">Couldn't load the map.</p>
  ) : (
    <GuestbookMap counts={counts} unplaced={unplaced} />
  )
}
