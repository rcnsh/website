---
/**
 * One figure with its label. `class` places it in the page grid. Without a
 * `value` it is its own skeleton: the figure and detail pulse in lines of
 * their own type, so the tile is the same height when it lands.
 */
interface Props {
  label: string;
  value?: string;
  detail?: string;
  class?: string;
}

const { label, value, detail, class: className } = Astro.props;
const pending = value === undefined;
---

<div class:list={["tile flex flex-col justify-between gap-[18px]", className]} aria-hidden={pending || undefined}>
  <span class="label">{label}</span>
  <div>
    <div class="font-mono text-[1.875rem] font-semibold leading-none tracking-[-0.04em] tabular-nums text-ink">
      {value ?? <span class="placeholder-text w-14" />}
    </div>
    {
      (detail || pending) && (
        <div class="mt-1.5 font-mono text-[11px] text-ink-faint">
          {pending ? <span class="placeholder-text w-12" /> : detail}
        </div>
      )
    }
  </div>
</div>
