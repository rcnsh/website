---
import { BRAND_MARKS } from "@/lib/brand-marks";

/**
 * One drawing per thing on the diagram, all on a 96x96 grid. Physical objects
 * are hand-drawn and stroked; software uses its real mark from
 * lib/brand-marks.ts at half the grid, since a filled shape reads heavier.
 *
 * Apps with no available mark are drawn here instead.
 */

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const mark = BRAND_MARKS[name];

const DRAWN = [
  "macbook",
  "pixel",
  "airpods",
  "backpack",
  "mouse",
  "keyboard",
  "rex",
  "premiere",
  "helium",
  "t3code",
] as const;

const isDrawn = (value: string): value is (typeof DRAWN)[number] =>
  (DRAWN as readonly string[]).includes(value);

---

<svg
  viewBox="0 0 96 96"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    /* A sourced mark: 24x24 doubled and centred, so it fills half the grid. */
    mark && (
      <g transform="translate(24 24) scale(2)" fill="currentColor" stroke="none">
        <path d={mark.path} />
      </g>
    )
  }

  {
    name === "macbook" && (
      <>
        {/* Lid, with the notch that dates it to this generation. */}
        <rect x="18" y="20" width="60" height="38" rx="3" />
        <rect x="21.5" y="23.5" width="53" height="31" rx="1.5" class="screen" />
        <path d="M42 20h12v3.5H42z" />
        {/* Base: a shallow wedge, wider than the lid, with the opening lip. */}
        <path d="M13 58h70l5 7.5a2 2 0 0 1-1.7 3H9.7A2 2 0 0 1 8 65.5L13 58Z" />
        <path d="M40 62.5h16" />
      </>
    )
  }

  {
    name === "pixel" && (
      <>
        {/*
          From the back, where the camera island is the whole identity. It is
          an inset pill, not the edge-to-edge bar of a Pixel 6 through 8 — that
          inset is the difference between this generation and those.
        */}
        <rect x="31" y="11" width="34" height="74" rx="9" />
        <rect x="34.5" y="18.5" width="27" height="12.5" rx="6.25" />

        {/* The three lenses sit in their own darker pill on the left. */}
        <rect x="36.5" y="21" width="17" height="7.5" rx="3.75" />
        <circle cx="40" cy="24.75" r="1.9" />
        <circle cx="45" cy="24.75" r="1.9" />
        <circle cx="50" cy="24.75" r="1.9" />

        {/* Flash and sensor stacked on the wider right end of the island. */}
        <circle cx="57.5" cy="22.5" r="1.5" class="accent" />
        <circle cx="57.5" cy="27.5" r="1.2" />

        {/* Volume and power — on the left edge when the phone is face down. */}
        <path d="M31 40h-2.5v9H31" />
        <path d="M31 53h-2.5v5.5H31" />
      </>
    )
  }

  {
    name === "airpods" && (
      <>
        {/* The pair, drawn as the driver housing and its short Pro stem. */}
        <circle cx="39" cy="22" r="6.5" />
        <rect x="36.5" y="27" width="5" height="10" rx="2.5" />
        <circle cx="57" cy="22" r="6.5" />
        <rect x="54.5" y="27" width="5" height="10" rx="2.5" />
        {/* Case below: lid seam across the top, status light on the front. */}
        <rect x="27" y="46" width="42" height="30" rx="8" />
        <path d="M27 55h42" />
        <circle cx="48" cy="66" r="1.5" class="accent" />
      </>
    )
  }

  {
    name === "backpack" && (
      <>
        {/* Body: the squared-off Peak Design silhouette. */}
        <path d="M26 38c0-5 4-9 9-9h26c5 0 9 4 9 9v36c0 3-2 5-5 5H31c-3 0-5-2-5-5V38Z" />
        {/* Grab handle, and the seam where the fold-over lid sits. */}
        <path d="M42 29c0-3 2.5-5 6-5s6 2 6 5" />
        <path d="M26 46h44" />
        {/* MagLatch: the strap down the front into its buckle. */}
        <path d="M48 46v9" class="accent" />
        <rect x="43.5" y="55" width="9" height="7" rx="1.5" class="accent" />
        {/* Side compression straps. */}
        <path d="M26 54h5M65 54h5M26 68h5M65 68h5" />
      </>
    )
  }

  {
    name === "mouse" && (
      <>
        {/* Top-down: the shell, the button split, and the wheel. */}
        <path d="M48 14c-9.5 0-15.5 7.5-15.5 19v25c0 11 6 18 15.5 18s15.5-7 15.5-18V33c0-11.5-6-19-15.5-19Z" />
        <path d="M48 15v23" />
        <rect x="45.5" y="23" width="5" height="10" rx="2.5" class="accent" />
        {/* A hint of the lattice shell the UltralightX is known for. */}
        <circle cx="41" cy="50" r="2" />
        <circle cx="48" cy="54" r="2" />
        <circle cx="55" cy="50" r="2" />
        <circle cx="41" cy="60" r="2" />
        <circle cx="55" cy="60" r="2" />
      </>
    )
  }

  {
    name === "keyboard" && (
      <>
        <rect x="8" y="30" width="80" height="36" rx="4" />
        {/* Key rows as dashes — individual keys would be noise at this size. */}
        <path
          d="M14 38h68M14 46h68M14 54h30M62 54h20"
          stroke-dasharray="4.5 2.5"
        />
        {/* Spacebar, in the accent so the layout reads at a glance. */}
        <rect x="36" y="58" width="24" height="4" rx="1.5" class="accent" />
      </>
    )
  }

  {
    name === "rex" && (
      <>
      {/*
        Rexie, Rex's mascot, in the rounded tile its app icon uses. Superlogical
        publishes no vector, so the silhouette is traced (potrace) from the app
        icon: eye cut out, mouth as the notch under the head, and the neck cut
        flat where the icon's badge hides it. Fitted to 40 of the tile's 52, as tall as the
        icon draws it.
      */}
      <rect x="22" y="22" width="52" height="52" rx="13" />
      <g
        transform="translate(28.76 28) scale(0.04474) translate(0 894) scale(1 -1)"
        fill="currentColor"
        stroke="none"
      >
        <path d="M310 892 c-2 0 -4 -1 -5 -1 -2 0 -15 -11 -16 -14 0 -2 -1 -4 -2 -5 -1 -1 -2 -4 -2 -7 0 -3 -1 -7 -2 -10 -2 -5 -2 -8 -3 -22 0 -16 0 -18 -2 -21 -2 -3 -3 -6 -3 -8 -1 -6 -10 -17 -15 -18 -1 -1 -4 -2 -5 -3 -4 -4 -36 -4 -41 0 -2 1 -5 2 -8 3 -2 0 -5 1 -6 2 -2 1 -5 2 -7 3 -3 1 -6 2 -8 3 -1 1 -4 2 -5 2 -2 0 -5 1 -7 2 -7 5 -32 4 -38 0 -18 -13 -22 -26 -16 -51 2 -11 3 -15 8 -29 3 -6 4 -12 6 -24 0 -6 -3 -19 -6 -23 -2 -2 -3 -3 -3 -4 -1 -2 -13 -11 -16 -11 -1 0 -4 -1 -6 -2 -2 -1 -6 -2 -11 -3 -5 0 -10 -2 -12 -3 -3 -1 -7 -1 -21 -2 -14 0 -18 -1 -22 -2 -2 -1 -6 -2 -8 -3 -4 0 -13 -5 -16 -10 -2 -2 -5 -4 -6 -6 -1 -1 -2 -3 -2 -4 0 -1 -1 -3 -2 -5 -4 -8 -1 -31 5 -38 1 -1 2 -2 2 -2 0 -3 13 -17 20 -21 3 -2 21 -18 29 -27 8 -8 11 -11 11 -15 1 -2 2 -4 3 -5 3 -4 3 -13 0 -21 -2 -3 -3 -6 -3 -7 0 -4 -11 -16 -16 -19 -2 -1 -6 -4 -8 -6 -2 -2 -5 -4 -6 -4 -1 0 -2 -1 -4 -2 -1 -1 -5 -4 -8 -6 -7 -4 -18 -14 -18 -15 0 -1 -1 -3 -2 -4 -3 -4 -6 -18 -6 -23 1 -6 4 -17 6 -19 0 -1 1 -3 2 -4 1 -5 16 -19 21 -19 2 -1 4 -2 5 -2 1 -3 5 -4 9 -4 3 0 4 -1 5 -2 1 -2 3 -2 7 -3 4 0 6 -1 8 -3 2 -1 4 -2 6 -2 1 0 3 -1 4 -2 1 -1 3 -2 5 -2 3 -1 10 -7 16 -13 3 -4 4 -5 5 -13 0 -5 0 -10 0 -12 -1 -2 -1 -5 -1 -6 0 -5 -10 -19 -13 -19 -4 0 -19 -13 -26 -22 -9 -11 -10 -30 -3 -45 l4 -8 0 -100 0 -101 224 0 225 0 0 104 c0 58 0 106 0 107 l0 3 -60 3 c-70 4 -80 4 -80 5 1 0 216 39 220 39 2 1 5 1 6 2 2 0 5 1 7 1 2 0 6 1 8 2 3 2 6 3 8 4 2 0 5 1 6 2 1 1 3 2 4 2 2 0 4 1 6 3 1 1 4 2 5 2 2 0 4 1 5 3 1 1 3 2 5 2 2 0 4 1 5 2 2 1 4 3 6 3 2 1 5 2 6 3 1 1 3 2 5 2 2 1 4 2 5 3 1 1 2 2 3 2 1 0 3 1 5 3 2 2 4 3 5 3 2 0 4 1 5 2 1 1 2 3 4 3 2 1 7 4 14 10 2 1 5 3 7 4 3 2 4 3 13 10 3 2 8 6 11 9 7 4 43 41 48 47 2 3 7 9 11 14 4 5 7 10 8 11 0 1 1 3 2 5 4 3 7 8 7 9 0 1 1 3 2 5 2 1 3 4 3 5 1 1 2 3 3 4 0 1 2 3 2 5 1 2 3 5 3 6 4 7 11 23 12 28 0 1 2 4 3 6 1 2 2 6 2 10 1 3 2 8 3 11 1 2 2 7 2 11 1 3 2 8 3 9 2 5 3 67 1 70 -2 3 -3 6 -4 16 -1 5 -2 9 -2 10 -1 1 -2 5 -2 9 -1 3 -2 6 -2 7 -1 1 -2 4 -3 7 -1 2 -2 5 -3 7 0 1 -1 3 -1 5 -1 1 -2 4 -3 5 -1 1 -2 4 -3 6 0 2 -2 5 -3 7 -1 1 -2 3 -2 3 0 1 -1 3 -2 5 -2 2 -4 6 -6 9 -2 3 -5 6 -5 7 -1 1 -2 2 -2 2 0 1 -6 10 -8 12 -2 2 -5 5 -7 9 -12 13 -48 46 -51 46 0 0 -2 1 -3 2 -5 4 -10 8 -11 8 -1 0 -2 1 -4 2 -5 4 -12 8 -13 8 -1 0 -3 1 -4 3 -1 1 -3 2 -4 2 -2 0 -4 1 -5 3 -2 1 -3 2 -5 2 -2 0 -4 1 -5 3 -2 1 -3 2 -5 2 -2 0 -4 1 -6 2 -2 2 -5 3 -7 4 -3 0 -5 1 -6 2 -2 1 -4 2 -7 2 -2 1 -5 2 -7 3 -1 1 -4 2 -6 2 -3 1 -6 2 -7 3 -2 1 -6 2 -10 3 -4 0 -7 1 -9 2 -1 1 -5 2 -8 2 -3 1 -7 2 -8 3 -2 1 -8 2 -13 2 -5 0 -10 1 -12 3 -3 1 -7 2 -17 2 -10 1 -16 2 -19 3 -7 2 -87 2 -97 0 -4 -1 -12 -3 -20 -3 -9 -1 -13 -1 -16 -3 -2 -1 -7 -2 -11 -2 l-8 0 -2 4 c-4 6 -15 19 -23 25 -4 3 -10 8 -14 11 -3 3 -7 5 -7 5 -1 0 -3 1 -4 3 -2 1 -4 2 -5 2 -2 0 -4 1 -6 3 -2 1 -4 2 -6 2 -1 0 -5 1 -8 1 -6 2 -8 2 -12 0z m19 -420 c3 -1 7 -2 9 -2 1 0 5 -2 8 -4 2 -1 6 -4 8 -5 7 -5 17 -17 21 -26 1 -2 3 -4 3 -5 1 -1 2 -3 3 -5 0 -2 1 -4 2 -6 2 -3 6 -31 5 -37 -3 -20 -5 -25 -9 -32 -1 -1 -2 -3 -3 -5 -2 -4 -12 -14 -15 -16 -2 -1 -4 -2 -5 -2 -2 -2 -15 -5 -20 -5 -7 0 -19 3 -23 6 -2 1 -4 2 -5 2 -1 0 -23 21 -23 23 0 0 -1 2 -2 4 -2 2 -3 5 -4 6 0 1 -1 4 -2 5 -1 2 -2 5 -3 7 0 3 -1 6 -2 8 -4 5 -4 43 0 48 1 2 2 5 2 7 1 3 2 6 4 7 1 2 2 4 2 4 0 3 11 15 16 17 1 0 3 1 4 2 1 1 3 2 4 2 2 0 6 1 8 2 6 2 10 2 17 0z" />
      </g>
      </>
    )
  }

  {
    name === "premiere" && (
      <>
        {/*
          Adobe has no simple-icons entry, but its icons are genuinely a
          rounded tile with the app's two letters — so this is the mark, not a
          stand-in for it.
        */}
        <rect x="22" y="22" width="52" height="52" rx="13" />
        <text
          x="48"
          y="49"
          text-anchor="middle"
          dominant-baseline="central"
          class="monogram"
        >
          Pr
        </text>
      </>
    )
  }

  {
    name === "helium" && (
      <>
      {/*
        Helium's own mark in the rounded tile its app icon uses — the 52px tile
        Premiere gets, so the two sit level. Scaled to 65% rather than the flat
        2x, matching the real icon's padding, and centred on the glyph.
      */}
      <rect x="22" y="22" width="52" height="52" rx="13" />
      <g
        transform="translate(31.06 30.76) scale(1.408)"
        fill="currentColor"
        stroke="none"
      >
        <path d="m 14.336641,22.536663 -2.308,1.702 -2.3080004,-1.702 1.0490004,-8.118 -6.5180004,4.966 -2.63,-1.146 0.322,-2.847 7.565,-3.153 -7.565,-3.1529996 -0.321,-2.847 2.63,-1.146 6.5170004,4.9669996 -1.0510004,-8.1209996 2.3100004,-1.69999998 2.308,1.70199998 -1.048,8.1179996 6.518,-4.9669996 2.629,1.147 -0.322,2.847 -7.565,3.1529996 7.566,3.153 0.321,2.847 -2.63,1.146 -6.517,-4.966 z" />
      </g>
      </>
    )
  }

  {
    name === "t3code" && (
      <>
      {/*
        T3 Code's own "T3" mark (pingdotgg/t3code, apps/mobile/assets/widget/
        T3Mark.svg) in the rounded tile its app icon uses — the same 52px tile
        as Helium and Premiere. Scaled so the glyph spans 34 of the tile's 52,
        and centred on the glyph's own bounds.
      */}
      <rect x="22" y="22" width="52" height="52" rx="13" />
      <g
        transform="translate(25.42 24.43) scale(0.36)"
        fill="currentColor"
        stroke="none"
      >
        <path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z" />
      </g>
      </>
    )
  }

  {
    !mark && !isDrawn(name) && (
      /* A typo in site.json shows up here rather than as a silent gap. */
      <>
        <rect x="24" y="24" width="48" height="48" rx="4" stroke-dasharray="4 4" />
        <path d="M40 48h16" />
      </>
    )
  }
</svg>

<style>
  /*
    The drawings are decoration, not content — dragging across the page should
    not pick up the "Pr" on Premiere's tile. Set on the whole svg rather than
    that one label, so a future drawing with text in it inherits the same rule.
  */
  svg {
    -webkit-user-select: none;
    user-select: none;
  }

  /* The screen and accent parts pick up the one accent the site allows. */
  .screen {
    stroke: var(--color-line-strong);
  }

  .accent {
    stroke: var(--color-brand);
  }

  .dim {
    stroke: var(--color-line-strong);
  }

  .accent-dim {
    stroke: color-mix(in oklab, var(--color-brand) 60%, transparent);
  }

  .monogram {
    font-family: var(--font-mono);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.03em;
    fill: currentColor;
    stroke: none;
  }
</style>
