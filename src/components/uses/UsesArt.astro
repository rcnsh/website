  viewBox="0 0 96 96"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    mark && (
      <g transform="translate(24 24) scale(2)" fill="currentColor" stroke="none">
