---
import Icon from "./Icon.astro";

/**
 * The cog in the header, and the popover it opens.
 *
 * A dropdown rather than a bare switch in the bar: multiplayer is one setting
 * and it should not cost a permanent piece of chrome that most visitors will
 * never use. The cog is the affordance; the explanation lives inside.
 *
 * The only thing this ships eagerly is the popover markup and the script
 * below. src/lib/multiplayer.ts — the socket, the render loop and its CSS — is
 * behind a dynamic import that only runs when the switch is turned on, so a
 * visitor who leaves it alone pays for nothing beyond a button.
 */
---

<div class="relative" data-settings>
  <button
    type="button"
    data-settings-trigger
    aria-label="Settings"
    aria-expanded="false"
    class="relative -m-2 flex items-center gap-1.5 p-2 text-ink-faint transition-colors hover:text-ink-dim"
  >
    {/*
      How many people are in this page's room with cursors on, when multiplayer
      is off and the answer is not none.

      The feature could not be found before this. It only shows anything once
      two people have independently turned it on over the same paragraph at the
      same moment, so the ordinary experience of trying it was an empty screen
      and a reasonable conclusion that it was broken. A number on the cog is
      the smallest honest thing that says otherwise — and it is one cached
      request, not a held-open socket.

      Replaced by the dot below once connected, which is the better signal.
    */}
    <span
      data-settings-count
      hidden
      class="font-mono text-[0.6875rem] leading-none text-brand"></span>

    {/*
      The cog is 14px to sit level with the ⌘K label beside it, which is far
      too small to aim at. The padding grows the hit target to ~30px and the
      negative margin takes the space back out of the layout.
    */}
    <Icon name="settings" class="h-3.5 w-3.5" />
    {/* Lit while multiplayer is connected, so the state is legible from the bar. */}
    <span
      data-settings-dot
      hidden
      class="absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-brand ring-2 ring-base"
    ></span>
  </button>

  <div
    data-settings-panel
    hidden
    class="card absolute right-0 top-[calc(100%+0.6rem)] z-50 w-64 p-3 shadow-lg shadow-black/40"
  >
    <p class="label mb-2 text-ink-faint">Settings</p>

    <div class="flex items-start gap-3">
      <div class="min-w-0 flex-1">
        <label
          for="setting-multiplayer"
          class="block cursor-pointer text-sm text-ink"
        >
          Multiplayer
        </label>
        <p data-settings-status class="mt-0.5 text-xs leading-snug text-ink-faint">
          Show other readers' cursors on this page.
        </p>
      </div>

      {/*
        A real switch rather than a checkbox: there is no form here and no
        submit, and role="switch" is what tells a screen reader that flipping
        it takes effect immediately.
      */}
      <button
        type="button"
        id="setting-multiplayer"
        role="switch"
        aria-checked="false"
        data-settings-toggle
        class="switch mt-0.5 shrink-0"
      >
        <span class="switch-knob"></span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Until the script is up, the cog does nothing — so it is not there. */
  [data-settings]:not([data-settings-ready]) {
    display: none;
  }

  .switch {
    position: relative;
    display: block;
    height: 1.125rem;
    width: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-raised);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .switch[aria-checked="true"] {
    border-color: var(--color-brand-deep);
    background: var(--color-brand-deep);
  }

  .switch-knob {
    position: absolute;
    top: 1px;
    left: 1px;
    height: 0.875rem;
    width: 0.875rem;
    border-radius: 999px;
    background: var(--color-ink-dim);
    transition:
      transform 0.24s var(--ease-out-quint),
      background-color 0.2s ease;
  }

  .switch[aria-checked="true"] .switch-knob {
    transform: translateX(0.875rem);
    background: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch,
    .switch-knob {
      transition: none;
    }
  }
</style>

<script>
  import type { Session, SessionState } from "@/lib/multiplayer";
  import { closeOnOtherOverlay, overlayOpened } from "@/lib/overlays";

  const STORAGE_KEY = "rcn:multiplayer";

  /*
    Module scope, not per-page. Astro's view transitions swap the document but
    do not re-evaluate a module that has already loaded, so the session — and
    with it the socket and the peers already on screen — survives a navigation.
    setupSettings() below only ever re-binds the new markup to it.
  */
  let session: Session | null = null;
  let starting = false;
  let bindings: AbortController | null = null;

  /**
   * The presence count, and which page it was counted on.
   *
   * Module scope for the same reason the session is: a navigation rebuilds the
   * markup but not this module, and re-asking on every page-load event for a
   * page already counted is a request for nothing. Ten seconds matches the
   * cache the Worker puts on the answer, so asking sooner cannot learn anything
   * newer anyway.
   */
  let countedRoom = "";
  let countedAt = 0;
  let counted = 0;

  const COUNT_TTL_MS = 10_000;

  /* Dev runs the cursor Worker on its own port; production is a route here. */
  const COUNT_ENDPOINT = import.meta.env.DEV
    ? "http://localhost:8788/api/multiplayer/count"
    : "/api/multiplayer/count";

  /** The room key, normalised the way the Worker normalises it. */
  const room = () => location.pathname.replace(/\/+$/, "") || "/";

  /** Private browsing throws on the first read; the feature is just off there. */
  function stored(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) === "on";
    } catch {
      return false;
    }
  }

  function remember(on: boolean) {
    try {
      if (on) localStorage.setItem(STORAGE_KEY, "on");
      else localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Nothing to do — the preference simply will not survive the tab.
    }
  }

  function setupSettings() {
    bindings?.abort();
    bindings = null;

    const root = document.querySelector<HTMLElement>("[data-settings]");
    if (!root) return;

    const trigger = root.querySelector<HTMLButtonElement>("[data-settings-trigger]");
    const panel = root.querySelector<HTMLElement>("[data-settings-panel]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-settings-toggle]");
    const status = root.querySelector<HTMLElement>("[data-settings-status]");
    const dot = root.querySelector<HTMLElement>("[data-settings-dot]");
    const count = root.querySelector<HTMLElement>("[data-settings-count]");
    if (!trigger || !panel || !toggle || !status || !dot || !count) return;

    bindings = new AbortController();
    const { signal } = bindings;

    const IDLE_COPY = "Show other readers' cursors on this page.";

    /** "one other person" / "3 other people" — the count, said in words. */
    const others = (n: number) =>
      n === 1 ? "one other person" : `${n} other people`;

    /*
      The dot on the cog means "connected", not "switched on" — so a dropped
      socket reads as a dropped socket rather than as an empty room, which is
      what reporting only a peer count used to make it look like.
    */
    const describe = (state: SessionState) => {
      dot.hidden = !state.live;
      // The socket is the better authority on who is here, so the polled
      // count gets out of its way entirely while there is one.
      count.hidden = true;

      /*
        A refusal is not a failure and must not be dressed as one. Both of
        these stay true until something changes, so "still trying" would be a
        lie about what the session is doing as well as about why.
      */
      if (state.refused === "full") {
        status.textContent = "On — this page is full. Try again in a bit.";
        return;
      }
      if (state.refused === "unknown") {
        status.textContent = "On — cursors aren't available on this page.";
        return;
      }

      if (state.stalled) {
        status.textContent = "On — can't reach the server. Still trying.";
        return;
      }
      if (!state.live) {
        status.textContent = "On — connecting…";
        return;
      }

      status.textContent =
        state.peers === 0
          ? "On — nobody else is here yet."
          : `On — ${others(state.peers)} ${state.peers === 1 ? "is" : "are"} here.`;
    };

    /** What the cog and the panel say while multiplayer is switched off. */
    const describeIdle = () => {
      count.hidden = counted < 1 || countedRoom !== room();
      count.textContent = String(counted);

      trigger.setAttribute(
        "aria-label",
        count.hidden ? "Settings" : `Settings — ${others(counted)} here`,
      );

      status.textContent = count.hidden
        ? IDLE_COPY
        : counted === 1
          ? "One other person here has cursors on."
          : `${counted} other people here have cursors on.`;
    };

    const paint = (on: boolean) => {
      toggle.setAttribute("aria-checked", String(on));
      if (!on) {
        dot.hidden = true;
        describeIdle();
      }
    };

    /**
     * How many people are in this page's room, for someone who has not joined
     * it. One request, and the Worker caches the answer at the edge — see the
     * note on the markup above for why the feature needs it at all.
     */
    const refreshCount = async (force = false) => {
      if (session || document.hidden) return;

      const here = room();
      const fresh = countedRoom === here && Date.now() - countedAt < COUNT_TTL_MS;
      if (fresh && !force) {
        describeIdle();
        return;
      }

      try {
        const response = await fetch(
          `${COUNT_ENDPOINT}?room=${encodeURIComponent(here)}`,
          { credentials: "omit", signal },
        );
        // A page with no room answers 400, which is a legitimate zero.
        const body = response.ok
          ? ((await response.json()) as { peers?: unknown })
          : null;

        counted = typeof body?.peers === "number" ? body.peers : 0;
        countedRoom = here;
        countedAt = Date.now();
      } catch {
        // Offline, blocked, or navigated away mid-flight. Say nothing rather
        // than something wrong; the next page-load asks again.
        counted = 0;
      }

      if (!stored()) describeIdle();
    };

    const setOpen = (open: boolean) => {
      // Takes the command palette down with it — see lib/overlays.
      if (open) overlayOpened("settings");
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    };

    closeOnOtherOverlay("settings", () => setOpen(false), signal);

    // Arrow consts rather than declarations, like everything else in here —
    // a hoisted `function` does not inherit the null-narrowing from the guard
    // above, and re-checking each element inside would be noise.
    const enable = async () => {
      // Two clicks before the chunk lands should not open two sockets.
      if (session || starting) return;
      starting = true;
      try {
        const { start } = await import("@/lib/multiplayer");
        // The switch may have been turned back off while this was in flight.
        if (!stored()) return;
        session = start();
        session.onState(describe);
      } catch {
        remember(false);
        paint(false);
        status.textContent = "Multiplayer could not start.";
      } finally {
        starting = false;
      }
    };

    const disable = () => {
      session?.destroy();
      session = null;
    };

    toggle.addEventListener(
      "click",
      () => {
        const on = toggle.getAttribute("aria-checked") !== "true";
        remember(on);
        paint(on);

        if (on) {
          void enable();
        } else {
          disable();
          // The room carries on without us, and the count is now a page older
          // than it looks. Ask again rather than showing a number from before.
          void refreshCount(true);
        }
      },
      { signal },
    );

    trigger.addEventListener(
      "click",
      () => {
        setOpen(panel.hidden);
        // Opening the panel is the moment the number in it starts mattering.
        if (!panel.hidden) void refreshCount();
      },
      { signal },
    );

    document.addEventListener(
      "pointerdown",
      (event) => {
        if (!panel.hidden && !root.contains(event.target as Node)) setOpen(false);
      },
      { signal },
    );

    /*
      A link opened in a background tab loads hidden, and a hidden page is not
      asked for a count — there is nobody looking at the answer, and the room
      it describes will have moved on by the time there is. So ask when the
      reader actually arrives.
    */
    document.addEventListener(
      "visibilitychange",
      () => {
        if (!document.hidden && !stored()) void refreshCount();
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || panel.hidden) return;
        setOpen(false);
        trigger.focus();
      },
      { signal },
    );

    root.setAttribute("data-settings-ready", "");

    const on = stored();
    paint(on);

    // Nothing to poll for while the socket is doing better than polling.
    if (!on) void refreshCount();

    if (on) {
      // Already running from a previous page — re-point it and re-attach the
      // presence readout to this copy of the markup.
      if (session) {
        session.setRoom(location.pathname);
        session.onState(describe);
      } else {
        void enable();
      }
    }
  }

  document.addEventListener("astro:page-load", setupSettings);
</script>
