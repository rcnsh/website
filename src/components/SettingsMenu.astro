---
import Icon from "./Icon.astro";

/** The cog in the header and the popover it opens. */

/** `key` is both the lib/prefs.ts storage name and the hook the script binds by. */
const settings = [
  {
    key: "live",
    label: "Live updates",
    description: "Update the UI in real time.",
  },
  {
    key: "motion",
    label: "Reduce motion",
    description: "Disable animations and transitions",
  },
];
---

<div class="relative" data-settings>
  <button
    type="button"
    data-settings-trigger
    aria-label="Settings"
    aria-expanded="false"
    class="relative -m-2.5 flex items-center p-2.5 text-ink-faint transition-colors hover:text-ink-dim"
  >
    {/* 14px to sit level with the ⌘K label; padding grows the hit target. */}
    <Icon name="settings" class="h-3.5 w-3.5" />
  </button>

  <div
    data-settings-panel
    hidden
    class="card absolute right-0 top-[calc(100%+0.6rem)] z-50 w-64 p-3 shadow-lg shadow-black/40"
  >
    <p class="label mb-2 text-ink-faint">Settings</p>

    <div class="flex flex-col gap-3.5">
      {
        settings.map((setting) => (
          <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <label
                for={`setting-${setting.key}`}
                class="block cursor-pointer text-sm text-ink"
              >
                {setting.label}
              </label>
              <p class="mt-0.5 text-xs leading-snug text-ink-faint"
              >
                {setting.description}
              </p>
            </div>

            {/* role="switch", not a checkbox: no form, and it applies at once. */}
            <button
              type="button"
              id={`setting-${setting.key}`}
              role="switch"
              aria-checked="false"
              data-settings-toggle={setting.key}
              class="switch mt-0.5 shrink-0"
            >
              <span class="switch-knob" />
            </button>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Until the script is up, the cog does nothing — so it is not there. */
  [data-settings]:not([data-settings-ready]) {
    display: none;
  }

  .switch {
    position: relative;
    display: block;
    height: 1.125rem;
    width: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-raised);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .switch[aria-checked="true"] {
    border-color: var(--color-brand-deep);
    background: var(--color-brand-deep);
  }

  .switch-knob {
    position: absolute;
    top: 1px;
    left: 1px;
    height: 0.875rem;
    width: 0.875rem;
    border-radius: 999px;
    background: var(--color-ink-dim);
    transition:
      transform 0.24s var(--ease-out-quint),
      background-color 0.2s ease;
  }

  .switch[aria-checked="true"] .switch-knob {
    transform: translateX(0.875rem);
    background: var(--color-ink);
  }

  /* The attribute, not the media query — the switch has to obey the switch. */
  :root[data-motion="reduce"] .switch,
  :root[data-motion="reduce"] .switch-knob {
    transition: none;
  }
</style>

<script>
  import { closeOnOtherOverlay, overlayOpened } from "@/lib/overlays";
  import {
    applyMotion,
    liveUpdates,
    motionReduced,
    REDUCED_MOTION_QUERY,
    setLiveUpdates,
    setMotionReduced,
  } from "@/lib/prefs";

  let bindings: AbortController | null = null;

  function setupSettings() {
    bindings?.abort();
    bindings = null;

    const root = document.querySelector<HTMLElement>("[data-settings]");
    if (!root) return;

    const trigger = root.querySelector<HTMLButtonElement>("[data-settings-trigger]");
    const panel = root.querySelector<HTMLElement>("[data-settings-panel]");

    const switchFor = (key: string) =>
      root.querySelector<HTMLButtonElement>(`[data-settings-toggle="${key}"]`);

    const live = switchFor("live");
    const motion = switchFor("motion");
    if (!trigger || !panel || !live || !motion) return;

    bindings = new AbortController();
    const { signal } = bindings;

    const setOpen = (open: boolean) => {
      // Takes the command palette down with it — see lib/overlays.
      if (open) overlayOpened("settings");
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    };

    closeOnOtherOverlay("settings", () => setOpen(false), signal);

    /** Switches that are nothing but a stored boolean; consumers listen to lib/prefs. */
    const bindPlain = (
      button: HTMLButtonElement,
      read: () => boolean,
      write: (on: boolean) => void,
    ) => {
      button.setAttribute("aria-checked", String(read()));

      button.addEventListener(
        "click",
        () => {
          const on = button.getAttribute("aria-checked") !== "true";
          write(on);
          button.setAttribute("aria-checked", String(on));
        },
        { signal },
      );
    };

    bindPlain(live, liveUpdates, setLiveUpdates);
    bindPlain(motion, motionReduced, setMotionReduced);

    // Untouched, the switch reports the OS setting, so it must move with it.
    matchMedia(REDUCED_MOTION_QUERY).addEventListener(
      "change",
      () => {
        applyMotion();
        motion.setAttribute("aria-checked", String(motionReduced()));
      },
      { signal },
    );

    trigger.addEventListener("click", () => setOpen(panel.hidden), { signal });

    document.addEventListener(
      "pointerdown",
      (event) => {
        if (!panel.hidden && !root.contains(event.target as Node)) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || panel.hidden) return;
        setOpen(false);
        trigger.focus();
      },
      { signal },
    );

    root.setAttribute("data-settings-ready", "");
  }

  // Module scripts are deferred, so the DOM is parsed by the time this runs.
  setupSettings();
</script>
