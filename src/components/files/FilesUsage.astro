---
import type { KindTotal } from "@/lib/files-nav";
import { formatBytes } from "@/lib/utils";
import { KIND_COLOUR, KIND_LABEL } from "./kinds";

/** Share of the bucket's bytes by kind of file. No `kinds` draws the placeholder. */
interface Props {
  kinds?: KindTotal[];
}

const { kinds } = Astro.props;
const total = kinds?.reduce((sum, k) => sum + k.bytes, 0) ?? 0;
const count = (n: number) => n.toLocaleString("en-GB");
---

<section
  class="tile animate-rise col-span-12 flex flex-col [animation-delay:.03s] min-[641px]:col-span-7"
  aria-labelledby="files-usage"
>
  <div class="mb-4 flex min-h-4 items-center gap-2.5">
    <h2 id="files-usage" class="label">By type</h2>
    <span class="ml-auto font-mono text-[11px] whitespace-nowrap text-ink-faint">share of bytes</span>
  </div>

  {
    kinds ? (
      <>
        <div
          class="group mt-1 flex h-3 gap-0.5 overflow-hidden rounded-[3px]"
          role="img"
          aria-label={`Bucket usage by file type: ${kinds
            .map((k) => `${KIND_LABEL[k.kind]} ${Math.round((k.bytes / total) * 100)}%`)
            .join(", ")}`}
        >
          {kinds.map((k) => (
            <i
              class="block h-full min-w-[3px] transition-opacity duration-200 group-hover:opacity-50 hover:opacity-100!"
              style={`flex: ${k.bytes} 1 0; background: ${KIND_COLOUR[k.kind]}`}
              title={`${KIND_LABEL[k.kind]} — ${formatBytes(k.bytes)}, ${count(k.objects)} file${k.objects === 1 ? "" : "s"}`}
            />
          ))}
        </div>
        <ul class="mt-auto grid grid-cols-2 gap-x-4.5 gap-y-3.5 pt-5.5 min-[641px]:grid-cols-3 min-[1021px]:grid-cols-4">
          {kinds.map((k) => (
            <li class="flex flex-col gap-1 font-mono text-[11px] text-ink-faint">
              <b class="flex items-center gap-1.75 text-[15px] font-semibold tracking-[-0.02em] text-ink tabular-nums">
                <i class="size-2 shrink-0 rounded-[2px]" style={`background: ${KIND_COLOUR[k.kind]}`} />
                {formatBytes(k.bytes)}
              </b>
              {KIND_LABEL[k.kind]} · {count(k.objects)}
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div aria-hidden="true" class="flex flex-1 flex-col">
        <div class="placeholder-block mt-1 h-3 rounded-[3px]" />
        <div class="mt-auto grid grid-cols-2 gap-x-4.5 gap-y-3.5 pt-5.5 min-[641px]:grid-cols-3 min-[1021px]:grid-cols-4">
          {Array.from({ length: 8 }).map(() => (
            <div class="flex flex-col gap-1.5">
              <span class="placeholder-block h-[18px] w-16 rounded-xs" />
              <span class="placeholder-block h-3 w-20 rounded-xs" />
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

