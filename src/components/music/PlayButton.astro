---
import Icon from "@/components/Icon.astro";

/** Play `trackId` on the owner's Spotify. Rendered for everyone, shown only to the owner. */
interface Props {
  trackId: string | null | undefined;
  title: string;
}

const { trackId, title } = Astro.props;
---

{
  trackId && (
    <button type="button" class="play-track" data-play-track={trackId} aria-label={`Play ${title} on Spotify`} title="Play on Spotify">
      <Icon name="play" class="h-2.5 w-2.5 fill-current" />
    </button>
  )
}
