---
import Icon from "@/components/Icon.astro";
import { PLAY_CLASS, playButtonAttributes } from "@/lib/track-play";

/** Play `trackId` on the owner's Spotify. Rendered for everyone, shown only to the owner. */
interface Props {
  trackId: string | null | undefined;
  title: string;
}

const { trackId, title } = Astro.props;
---

{
  trackId && (
    <button type="button" class={PLAY_CLASS} {...playButtonAttributes(trackId, title)}>
      <Icon name="play" class="h-2.5 w-2.5 fill-current" />
    </button>
  )
}
