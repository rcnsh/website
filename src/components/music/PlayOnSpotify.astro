<script>
  import { PLAYED_EVENT } from "@/lib/now-playing";
  import { hasOwnerHint } from "@/lib/owner-hint";
  import { isTrackId, PLAY_SELECTOR, PLAY_STATE_ATTR, PLAY_TITLE, PLAY_TRACK_ATTR } from "@/lib/track-play";

  // Marks the document so the owner's play buttons show (global.css), and
  // plays from any of them, islands and live widgets included.
  if (hasOwnerHint()) {
    document.documentElement.dataset.owner = "";
    document.addEventListener("click", async (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>(PLAY_SELECTOR);
      const trackId = button?.getAttribute(PLAY_TRACK_ATTR);
      if (!button || !isTrackId(trackId) || button.getAttribute(PLAY_STATE_ATTR) === "pending") return;
      event.preventDefault();

      button.setAttribute(PLAY_STATE_ATTR, "pending");
      const response = await fetch("/api/music/play", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ track_id: trackId }),
      }).catch(() => null);
      const body = response && !response.ok ? ((await response.json().catch(() => null)) as { error?: string } | null) : null;
      const failure = response?.ok ? null : (body?.error ?? (response ? `Failed (${response.status})` : "Couldn't reach the site"));
      button.setAttribute(PLAY_STATE_ATTR, failure ? "failed" : "played");
      if (!failure) document.dispatchEvent(new CustomEvent(PLAYED_EVENT));
      button.title = failure ?? "Playing";
      setTimeout(() => {
        button.removeAttribute(PLAY_STATE_ATTR);
        button.title = PLAY_TITLE;
      }, failure ? 4000 : 1500);
    });
  }
</script>
