<script>
  import { hasOwnerCookie } from "@/lib/owner-hint";
  import { isTrackId } from "@/lib/track-play";

  // Marks the document so the owner's play buttons show (global.css), and
  // plays from any of them, islands and live widgets included.
  if (hasOwnerCookie(document.cookie)) {
    document.documentElement.dataset.owner = "";
    document.addEventListener("click", async (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button[data-play-track]");
      const trackId = button?.dataset.playTrack;
      if (!button || !isTrackId(trackId) || button.dataset.state === "pending") return;
      event.preventDefault();

      button.dataset.state = "pending";
      const response = await fetch("/api/music/play", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ track_id: trackId }),
      }).catch(() => null);
      const body = response && !response.ok ? ((await response.json().catch(() => null)) as { error?: string } | null) : null;
      const failure = response?.ok ? null : (body?.error ?? (response ? `Failed (${response.status})` : "Couldn't reach the site"));
      button.dataset.state = failure ? "failed" : "played";
      if (!failure) document.dispatchEvent(new CustomEvent("music:played"));
      button.title = failure ?? "Playing";
      setTimeout(() => {
        delete button.dataset.state;
        button.title = "Play on Spotify";
      }, failure ? 4000 : 1500);
    });
  }
</script>
