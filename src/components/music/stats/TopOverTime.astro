---
import { getTopOverTime, type TopOverTime } from "@/lib/music-stats";
import { cover, percent, plural, quarterLabel } from "@/lib/music-stats-view";

let data: TopOverTime | null = null;
try {
  data = await getTopOverTime();
} catch (error) {
  console.error("[music-stats] top over time island failed", error);
}

// Categorical, in fixed order: the warehouse orders leaders by when they
// peaked, so a colour belongs to an artist, never to a rank. Checked with the
// dataviz palette validator on the tile surface (#131311): every adjacent
// pair clears the colour-blind and normal-vision floors, all >= 3:1.
const SERIES = ["var(--color-brand)", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#3987e5"];

const quarters = data?.quarters ?? [];
const leaders = (data?.leaders ?? []).slice(0, SERIES.length).map((leader, i) => ({ ...leader, colour: SERIES[i]! }));
const maxPlays = Math.max(1, ...quarters.map((q) => q.plays));

const columns = quarters.map((quarter, qi) => {
  const segments = leaders
    .map((leader) => ({ name: leader.name, colour: leader.colour, share: leader.share[qi] ?? 0 }))
    .filter((segment) => segment.share > 0);
  const rest = Math.max(0, 1 - segments.reduce((sum, s) => sum + s.share, 0));
  const first = quarter.artists[0];
  return {
    ...quarter,
    segments,
    rest,
    tip: `${quarterLabel(quarter.period)}${quarter.partial ? " (so far)" : ""} · ${
      first ? `#1 ${first.name} ${percent(first.share)}` : "no plays"
    } · ${plural(quarter.plays, "play")}`,
  };
});

const years = (data?.years ?? []).filter((year) => year.artists.length);
// A year label at each Q1, plus the first column when that leaves room:
// history starts mid-year, and two labels that close run together.
const ticks = new Map<number, string>();
quarters.forEach((quarter, i) => {
  if (quarter.period.endsWith("Q1")) ticks.set(i, quarter.period.slice(0, 4));
});
const firstQ1 = ticks.size ? Math.min(...ticks.keys()) : quarters.length;
if (quarters[0] && !ticks.has(0) && firstQ1 >= 3) ticks.set(0, quarters[0].period.slice(0, 4));

const dominant = [...columns].sort((a, b) => (b.artists[0]?.share ?? 0) - (a.artists[0]?.share ?? 0))[0];
const summary = dominant
  ? `Share of each quarter's plays going to the ${leaders.length} most-played artists overall, ${quarterLabel(
      quarters[0]?.period ?? "",
    )} to ${quarterLabel(quarters.at(-1)?.period ?? "")}. The most one-sided quarter was ${quarterLabel(
      dominant?.period ?? "",
    )}, when ${dominant.artists[0]?.name ?? "no one"} took ${percent(dominant.artists[0]?.share ?? 0)}.`
  : "";
---

<div data-chart>
  <div class="mb-4 flex min-h-4 flex-wrap items-center gap-2.5">
    <h2 id="top-title" class="label">Who I was listening to</h2>
    <span class="ml-auto font-mono text-[11px] text-ink-dim" data-chart-readout aria-hidden="true">
      Share of plays per quarter
    </span>
  </div>

  {
    !data ? (
      <p class="text-sm text-ink-faint">Couldn't reach the music warehouse.</p>
    ) : columns.length === 0 ? (
      <p class="text-sm text-ink-faint">No plays counted yet.</p>
    ) : (
      <>
        <ul class="mb-4 flex flex-wrap gap-x-4 gap-y-1.5 font-mono text-[11px] text-ink-dim">
          {leaders.map((leader) => (
            <li class="flex items-center gap-1.5">
              <span class="inline-block h-2 w-2 rounded-[2px]" style={`background:${leader.colour}`} aria-hidden="true" />
              {leader.name}
            </li>
          ))}
          <li class="flex items-center gap-1.5">
            <span class="inline-block h-2 w-2 rounded-[2px] bg-line" aria-hidden="true" />
            Everyone else
          </li>
        </ul>

        <div
          class="grid h-[180px] items-stretch gap-[2px] max-sm:h-[140px]"
          style={`grid-template-columns: repeat(${columns.length}, minmax(0, 1fr))`}
          role="img"
          aria-label={summary}
        >
          {columns.map((column) => (
            <div
              class="group flex justify-center transition-opacity hover:bg-[color-mix(in_oklab,var(--color-ink)_5%,transparent)]"
              data-tip={column.tip}
              data-col-year={column.period.slice(0, 4)}
            >
              <div class:list={["flex w-full max-w-6 flex-col-reverse gap-[2px]", column.partial && "opacity-60"]}>
                {column.segments.map((segment) => (
                  <i class="block min-h-px" style={`flex:${segment.share} 0 0;background:${segment.colour}`} data-tip={column.tip} />
                ))}
                {column.rest > 0 && <i class="block min-h-px rounded-t-[4px] bg-line" style={`flex:${column.rest} 0 0`} data-tip={column.tip} />}
              </div>
            </div>
          ))}
        </div>

        <div
          class="mt-1.5 grid h-6 items-end gap-[2px]"
          style={`grid-template-columns: repeat(${columns.length}, minmax(0, 1fr))`}
          aria-hidden="true"
        >
          {columns.map((column) => (
            <div class="flex h-full items-end justify-center transition-opacity" data-tip={column.tip} data-col-year={column.period.slice(0, 4)}>
              <i class="block w-full max-w-6 rounded-t-[2px] bg-line-strong" style={`height:${Math.max(4, (column.plays / maxPlays) * 100)}%`} data-tip={column.tip} />
            </div>
          ))}
        </div>
        <div
          class="mt-1.5 grid font-mono text-[10px] text-ink-dim"
          style={`grid-template-columns: repeat(${columns.length}, minmax(0, 1fr))`}
          aria-hidden="true"
        >
          {columns.map((_, i) => <span class="whitespace-nowrap">{ticks.get(i) ?? ""}</span>)}
        </div>
        <p class="mt-2 font-mono text-[10.5px] text-ink-dim">
          Lower strip: plays per quarter, so a thin quarter's big share reads as thin. Credited to each song's lead artist.
        </p>

        {years.map((year) => (
          <div data-year={year.period} class="mt-6 grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="mb-2.5 font-mono text-[11px] text-ink-dim">
                Top artists, {year.period}
                {year.partial ? " so far" : ""}
              </h3>
              <ol class="flex flex-col gap-2">
                {year.artists.map((artist, i) => (
                  <li class="grid grid-cols-[1.25rem_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1">
                    <span class="font-mono text-[11px] text-ink-dim tabular-nums">{i + 1}</span>
                    <span class="truncate text-[13.5px] text-ink">{artist.name}</span>
                    <span class="font-mono text-[11px] tabular-nums text-ink-dim">{percent(artist.share)}</span>
                    <span />
                    <span class="col-span-2 block h-1 rounded-full bg-line-soft" aria-hidden="true">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${(artist.share / Math.max(0.01, year.artists[0]?.share ?? 1)) * 100}%;background:${
                          leaders.find((leader) => leader.name === artist.name)?.colour ?? "var(--color-line-strong)"
                        }`}
                      />
                    </span>
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <h3 class="mb-2.5 font-mono text-[11px] text-ink-dim">Top songs</h3>
              <ol class="flex flex-col gap-2.5">
                {year.tracks.map((song) => (
                  <li class="flex items-center gap-3">
                    {song.image ? (
                      <img src={cover(song.image, 64)} alt="" width={36} height={36} loading="lazy" class="h-9 w-9 shrink-0 rounded-xs object-cover" />
                    ) : (
                      <span class="h-9 w-9 shrink-0 rounded-xs bg-raised" />
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[13.5px] text-ink">{song.name}</span>
                      <span class="block truncate text-[12px] text-ink-dim">{song.artist}</span>
                    </span>
                    <span class="font-mono text-[11px] tabular-nums text-ink-dim">{plural(song.plays, "play")}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        ))}

        <ol class="mt-6 grid grid-cols-2 gap-2.5 sm:max-[1020px]:grid-cols-3 min-[1021px]:grid-cols-7">
          {years.map((year) => {
            const lead = year.artists[0]!;
            const song = year.tracks[0];
            return (
              <li class="card flex flex-col gap-2 p-3 transition-colors" data-card-year={year.period}>
                <span class="flex items-baseline justify-between font-mono text-[11px] text-ink-dim">
                  {year.period}
                  {year.partial && <span>so far</span>}
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-[13.5px] font-medium text-ink">{lead.name}</span>
                  <span class="block font-mono text-[10.5px] text-ink-dim">{percent(lead.share)} of plays</span>
                </span>
                {song && (
                  <span class="mt-auto flex items-center gap-2 border-t border-line-soft pt-2">
                    {song.image ? (
                      <img src={cover(song.image, 64)} alt="" width={24} height={24} loading="lazy" class="h-6 w-6 shrink-0 rounded-xs object-cover" />
                    ) : (
                      <span class="h-6 w-6 shrink-0 rounded-xs bg-raised" />
                    )}
                    <span class="min-w-0">
                      <span class="block truncate text-[11.5px] text-ink-dim">{song.name}</span>
                      <span class="block font-mono text-[10px] text-ink-dim">{song.plays} plays</span>
                    </span>
                  </span>
                )}
              </li>
            );
          })}
        </ol>

        <details class="mt-4 text-[12.5px] text-ink-dim">
          <summary class="cursor-pointer font-mono text-[11px] text-ink-faint hover:text-ink">Show as a table</summary>
          <div class="mt-3 max-h-80 overflow-auto">
            <table class="w-full font-mono text-[11px] tabular-nums">
              <caption class="sr-only">Share of each quarter's plays by artist, as charted, and the quarter's top artist</caption>
              <thead>
                <tr class="text-left text-ink-dim">
                  <th scope="col" class="py-1 pr-3 font-normal">Quarter</th>
                  <th scope="col" class="py-1 pr-3 font-normal">Plays</th>
                  {leaders.map((leader) => <th scope="col" class="py-1 pr-3 font-normal whitespace-nowrap">{leader.name}</th>)}
                  <th scope="col" class="py-1 pr-3 font-normal whitespace-nowrap">Everyone else</th>
                  <th scope="col" class="py-1 pr-3 font-normal">#1</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-soft">
                {columns.map((column, qi) => (
                  <tr>
                    <th scope="row" class="py-1 pr-3 text-left font-normal">
                      {quarterLabel(column.period)}
                      {column.partial ? " (so far)" : ""}
                    </th>
                    <td class="py-1 pr-3">{column.plays.toLocaleString("en-GB")}</td>
                    {leaders.map((leader) => (
                      <td class="py-1 pr-3">{percent(leader.share[qi] ?? 0)}</td>
                    ))}
                    <td class="py-1 pr-3">{percent(column.rest)}</td>
                    <td class="py-1 pr-3 whitespace-nowrap">
                      {column.artists[0] ? `${column.artists[0].name} ${percent(column.artists[0].share)}` : "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </>
    )
  }
</div>
