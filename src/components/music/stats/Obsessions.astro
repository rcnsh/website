---
import { getObsessions, type Obsessions } from "@/lib/music-stats";
import { cover, monthLabel, monthRange, plural } from "@/lib/music-stats-view";

let data: Obsessions | null = null;
try {
  data = await getObsessions();
} catch (error) {
  console.error("[music-stats] obsessions island failed", error);
}

const top = Math.max(1, ...(data?.items.map((item) => item.peak_week_plays) ?? []));
---

<div>
  <div class="mb-4 flex min-h-4 items-center gap-2.5">
    <h2 id="obsessions-title" class="label">Biggest obsessions</h2>
    <span class="ml-auto font-mono text-[11px] text-ink-faint">plays in one week</span>
  </div>

  {
    !data ? (
      <p class="text-sm text-ink-faint">Couldn't reach the music warehouse.</p>
    ) : data.items.length === 0 ? (
      <p class="text-sm text-ink-faint">Nothing to show yet.</p>
    ) : (
      <ol class="flex flex-col gap-3.5">
        {data.items.map((item, i) => (
          <li class="grid grid-cols-[1.25rem_2rem_minmax(0,1fr)_auto] items-center gap-x-3">
            <span class="font-mono text-[11px] text-ink-faint tabular-nums">{i + 1}</span>
            {item.image ? (
              <img src={cover(item.image, 64)} alt="" width={32} height={32} loading="lazy" class="h-8 w-8 rounded-xs bg-raised object-cover" />
            ) : (
              <div class="h-8 w-8 rounded-xs bg-raised" />
            )}
            <span class="min-w-0">
              <a
                href={`https://open.spotify.com/track/${item.track_id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block truncate text-[14px] text-ink transition-colors hover:text-brand-alt"
              >
                {item.name}
              </a>
              <span class="block truncate text-[12px] text-ink-dim">
                {item.artists} · {monthLabel(item.month)}
              </span>
            </span>
            <span class="font-mono text-[13px] text-ink tabular-nums">{item.peak_week_plays}</span>
            <span class="col-span-2" />
            <span class="col-span-2 mt-1.5 block">
              <span class="block h-1 rounded-full bg-line-soft" aria-hidden="true">
                <span class="block h-full rounded-full bg-brand" style={`width:${(item.peak_week_plays / top) * 100}%`} />
              </span>
              <span class="mt-1 block font-mono text-[10.5px] text-ink-faint">
                {item.peak_week_days} of 7 days · {plural(item.run_plays, "play")} over {monthRange(item.run_from, item.run_to)}
              </span>
            </span>
          </li>
        ))}
      </ol>
    )
  }
</div>
