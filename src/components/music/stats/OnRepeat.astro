---
import { getOnRepeat, type OnRepeat } from "@/lib/music-stats";
import { cover, plural } from "@/lib/music-stats-view";

let data: OnRepeat | null = null;
try {
  data = await getOnRepeat();
} catch (error) {
  console.error("[music-stats] on repeat island failed", error);
}

// One scale for every sparkline, so a tall bar means the same in each row.
const peak = Math.max(1, ...(data?.tracks.flatMap((track) => track.daily) ?? []));
const daysAgo = (index: number, length: number) => {
  const ago = length - 1 - index;
  // The series ends at local midnight, so its last day is yesterday.
  return ago === 0 ? "yesterday" : `${ago + 1} days ago`;
};
---

<div data-chart>
  <div class="mb-4 flex min-h-4 items-center gap-2.5">
    <h2 id="repeat-title" class="label shrink-0 whitespace-nowrap">On repeat</h2>
    <span class="ml-auto min-w-0 truncate font-mono text-[11px] text-ink-dim" data-chart-readout aria-hidden="true">
      {data ? `Last ${data.window_days} days` : ""}
    </span>
  </div>
  <p data-year-note class="-mt-2 mb-3 font-mono text-[11px] text-ink-dim">Always the last two weeks, whichever year is picked.</p>

  {
    !data ? (
      <p class="text-sm text-ink-faint">Couldn't reach the music warehouse.</p>
    ) : data.tracks.length === 0 ? (
      <p class="text-sm text-ink-faint">Nothing on repeat right now.</p>
    ) : (
      <>
        <ol class="divide-y divide-line-soft border-t border-line-soft">
          {data.tracks.map((track) => (
            <li class="grid grid-cols-[minmax(0,1fr)_4rem] items-center gap-x-3.5 gap-y-1.5 py-2.5 sm:flex">
              <a
                href={`https://open.spotify.com/track/${track.track_id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex min-w-0 flex-1 items-center gap-3.5"
              >
                {track.image ? (
                  <img
                    src={cover(track.image, 64)}
                    alt=""
                    width={36}
                    height={36}
                    loading="lazy"
                    class="h-9 w-9 shrink-0 rounded-xs bg-raised object-cover"
                  />
                ) : (
                  <div class="h-9 w-9 shrink-0 rounded-xs bg-raised" />
                )}
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[0.9375rem] text-ink transition-colors group-hover:text-brand-alt">
                    {track.name}
                  </span>
                  <span class="mt-px block truncate text-[12.5px] text-ink-dim">{track.artists}</span>
                </span>
              </a>
              <span
                class="col-start-1 row-start-2 ml-[50px] flex h-5 w-[112px] shrink-0 items-end gap-[2px] sm:ml-0 sm:h-7"
                role="img"
                aria-label={`Plays per day for the ${track.daily.length} days to yesterday, oldest first: ${track.daily.join(", ")}`}
              >
                {track.daily.map((n, i) => (
                  <i
                    class:list={["block flex-1 rounded-t-[2px]", n ? "bg-brand" : "bg-line-soft"]}
                    style={`height:${n ? Math.max(12, (n / peak) * 100) : 6}%`}
                    data-tip={`${track.name} · ${plural(n, "play")} · ${daysAgo(i, track.daily.length)}`}
                  />
                ))}
              </span>
              <span class="col-start-2 row-span-2 row-start-1 w-16 shrink-0 text-right font-mono text-[11px] leading-tight text-ink-dim">
                <span class="block text-[13px] text-ink tabular-nums">{track.plays}×</span>
                {plural(track.days, "day")}
              </span>
            </li>
          ))}
        </ol>

        {data.albums.length > 0 && (
          <div class="mt-5">
            <h3 class="mb-2.5 font-mono text-[11px] text-ink-dim">Whole albums on repeat</h3>
            <ul class="flex flex-wrap gap-2">
              {data.albums.map((album) => (
                <li class="card flex items-center gap-2.5 py-1.5 pr-3 pl-1.5">
                  {album.image && (
                    <img src={cover(album.image, 64)} alt="" width={28} height={28} loading="lazy" class="h-7 w-7 rounded-xs object-cover" />
                  )}
                  <span class="min-w-0">
                    <span class="block max-w-[14rem] truncate text-[12.5px] text-ink">{album.name}</span>
                    <span class="block font-mono text-[10.5px] text-ink-dim">
                      {album.tracks_on_repeat} songs · {album.plays} plays
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <p class="mt-5 text-[12.5px] leading-relaxed text-ink-faint">
          A song is on repeat with five or more plays across at least three days, at twice its usual rate. One per album;
          plays under 30 seconds don't count.
        </p>
      </>
    )
  }
</div>
