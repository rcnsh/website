---
import { externalLinks, site } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-4 px-5 py-7 font-mono text-xs text-ink-faint sm:flex-row sm:items-center sm:gap-5 sm:px-6"
  >
    {
      /* The 88x31 button, drawn by `npm run badge`. Links to the file, since
         the only reason to click it here is to take it. */
    }
    <a
      href="/badge.png"
      title="88×31 button — take it"
      class="inline-flex w-fit shrink-0 opacity-90 transition-opacity duration-200 hover:opacity-100"
    >
      <img
        src="/badge.png"
        srcset="/badge.png 1x, /badge@2x.png 2x"
        width="88"
        height="31"
        loading="lazy"
        decoding="async"
        alt="rcn.sh"
        class="block"
      />
    </a>

    <p>&copy; {year} {site.author}</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 sm:ml-auto">
      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-ink-dim"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
