---
/**
 * The canvas the lattice field draws on: pinned behind the page, and persisted
 * so one WebGL context serves every page and the picture can sweep from one
 * page's to the next's. See src/lib/lattice/field.ts.
 */
---

<canvas class="lattice" data-lattice-canvas aria-hidden="true" transition:persist="lattice"></canvas>

<style>
  /* Sticky rather than fixed: a rubber-band bounce moves the page's content,
     sticky elements included, but leaves fixed ones behind, so a fixed field
     would slide off the page it draws. The negative margin takes it out of
     the flow, so it covers the viewport exactly as fixed did. It must stay a
     direct child of <body>, the box it sticks within. */
  .lattice {
    position: sticky;
    top: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100dvh;
    margin-bottom: -100dvh;
    pointer-events: none;
  }
</style>

<script>
  import { startLattice } from "@/lib/lattice/field";

  // Once per document: the canvas outlives every soft navigation.
  const canvas = document.querySelector<HTMLCanvasElement>("[data-lattice-canvas]");
  if (canvas) startLattice(canvas);

  // Local dev has no warehouse token, so no cover arrives: `?cover=<image url>`
  // stands one in. Compiled out of production builds.
  if (import.meta.env.DEV) {
    const test = new URLSearchParams(location.search).get("cover");
    if (test) import("@/lib/lattice-source").then(({ pinCover }) => pinCover(test));
  }
</script>
