---
import Icon from "./Icon.astro";
import SettingsMenu from "./SettingsMenu.astro";
import { nav } from "@/lib/site";

const path =
  Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/(.)\/+$/, "$1") || "/";

const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const tabs = nav.slice(1);
const homeActive = isActive("/");
---

<header class="sticky top-0 z-50 border-b border-line-soft bg-base/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-page items-center px-4 sm:px-5">
    <div class="relative -ml-3 flex items-stretch self-stretch" data-nav-rail>
      <a
        href="/"
        aria-label="rcn.sh — home"
        aria-current={homeActive ? "page" : undefined}
        data-nav-item
        data-nav-active={homeActive ? "" : undefined}
        class="relative inline-flex shrink-0 items-center px-3 font-mono text-sm tracking-tight text-ink"
      >
        <span class="wordmark">rcn</span><span class="text-ink-faint">.sh</span>
      </a>

      {
        tabs.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              data-nav-item
              data-nav-active={active ? "" : undefined}
              class:list={[
                "relative hidden items-center px-3 text-sm transition-colors duration-200 sm:inline-flex",
                active ? "text-ink" : "text-ink-faint hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }

      <span class="nav-underline" data-nav-underline aria-hidden="true"></span>
    </div>

    <div class="ml-auto flex items-center gap-4">
      <button
        type="button"
        data-palette-trigger
        aria-label="Search ⌘K: open command palette"
        class="flex h-[30px] min-w-[30px] items-center justify-center gap-2 rounded-md border border-line-soft bg-surface px-2 font-mono text-xs text-ink-faint press transition-colors hover:border-line-strong hover:bg-raised hover:text-ink sm:justify-start sm:pr-2.5"
      >
        <Icon name="search" class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden font-mono text-ink-dim sm:inline">⌘K</kbd>
      </button>

      <SettingsMenu />
    </div>
  </div>

  <nav class="flex border-t border-line px-2 py-1 text-sm sm:hidden">
    {
      tabs.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative px-3 py-2",
              active
                ? "text-ink after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand-gradient"
                : "text-ink-faint",
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  @property --wm-from {
    syntax: "<color>";
    inherits: false;
    initial-value: #e8e3d9;
  }
  @property --wm-to {
    syntax: "<color>";
    inherits: false;
    initial-value: #e8e3d9;
  }

  .wordmark {
    background-image: linear-gradient(100deg, var(--wm-from), var(--wm-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition:
      --wm-from 0.35s var(--ease-out-quint),
      --wm-to 0.35s var(--ease-out-quint);
  }

  a:hover .wordmark,
  a:focus-visible .wordmark {
    --wm-from: var(--color-brand-blue);
    --wm-to: var(--color-brand-alt);
  }

  .nav-underline {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    width: 100px;
    transform-origin: 0 0;
    transform: scaleX(0);
    opacity: 0;
    background: linear-gradient(100deg, var(--color-brand-blue), var(--color-brand));
    pointer-events: none;
    transition:
      transform 0.25s var(--ease-out-quint),
      opacity 0.22s ease;
  }

  .nav-underline[data-instant] {
    transition: opacity 0.22s ease;
  }

  [data-nav-rail]:not([data-nav-ready]) [data-nav-active]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(100deg, var(--color-brand-blue), var(--color-brand));
  }
</style>

<script>
  import { onPage } from "@/lib/page-lifecycle";

  function setupNav(signal: AbortSignal) {
    const rail = document.querySelector<HTMLElement>("[data-nav-rail]");
    if (!rail) return;

    const bar = rail.querySelector<HTMLElement>("[data-nav-underline]");
    const items = Array.from(rail.querySelectorAll<HTMLElement>("[data-nav-item]"));
    if (!bar || items.length === 0) return;

    const activeTab = () => items.find((el) => el.hasAttribute("data-nav-active")) ?? null;

    let shown = false;

    const place = (el: HTMLElement | null, animate: boolean) => {
      if (!el || (el.offsetParent === null && el.offsetWidth === 0)) {
        bar.style.opacity = "0";
        shown = false;
        return;
      }

      const jump = !animate || !shown;
      if (jump) bar.setAttribute("data-instant", "");

      bar.style.transform = `translate3d(${el.offsetLeft}px, 0, 0) scaleX(${el.offsetWidth / 100})`;
      bar.style.opacity = "1";

      if (jump) {
        void bar.offsetWidth;
        bar.removeAttribute("data-instant");
      }
      shown = true;
    };

    const rest = () => place(activeTab(), true);

    for (const item of items) {
      item.addEventListener("pointerenter", () => place(item, true), { signal });
      item.addEventListener("focus", () => place(item, true), { signal });
    }

    rail.addEventListener("pointerleave", rest, { signal });
    rail.addEventListener("focusout", (event) => {
      if (!rail.contains(event.relatedTarget as Node | null)) rest();
    }, { signal });
    window.addEventListener("resize", () => place(activeTab(), false), {
      passive: true,
      signal,
    });

    rail.setAttribute("data-nav-ready", "");
    place(activeTab(), false);
  }

  function publishHeaderHeight() {
    const root = document.documentElement;
    root.style.setProperty("--page-w", `${root.clientWidth}px`);
    const header = document.querySelector("header");
    if (!header) return;
    root.style.setProperty("--header-h", `${Math.round(header.getBoundingClientRect().height)}px`);
  }

  onPage((signal) => {
    setupNav(signal);
    publishHeaderHeight();
  });
  window.addEventListener("resize", publishHeaderHeight, { passive: true });
</script>
