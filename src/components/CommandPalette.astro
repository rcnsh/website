---
// Here, not beside the lazily loaded terminal: see CLAUDE.md § Palette shell.
import "@wterm/dom/css";
import Icon from "./Icon.astro";
import { externalLinks, nav } from "@/lib/site";

/**
 * ⌘K / Ctrl+K, or "/" outside a text field. Rows are server-drawn, so filtering
 * is hiding and reordering markup rather than hydrating a component tree.
 *
 * Lives at the end of <body>: the header's backdrop-blur is a containing block
 * for fixed positioning, so the overlay would size to the bar.
 */
const items = [...nav, ...externalLinks].map((item) => ({
  ...item,
  external: /^https?:/.test(item.href) || item.href.endsWith(".txt"),
  // Lowercased once here so the keystroke handler never has to.
  needle: item.label.toLowerCase(),
  haystack: `${item.label} ${item.keywords ?? ""}`.toLowerCase(),
}));
---

<div
  data-palette
  inert
  class="palette fixed inset-0 z-[100] flex items-start justify-center px-4 pt-[14vh]"
>
  <div class="absolute inset-0 bg-black/75" data-palette-backdrop aria-hidden="true">
  </div>

  <div
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
    class="relative w-full max-w-[35rem] overflow-hidden rounded-tile border border-line bg-base shadow-[0_30px_80px_-20px_rgba(0,0,0,0.8)]"
  >
    <div data-palette-searchbar class="flex items-center gap-3 border-b border-line-soft px-4">
      <Icon name="search" class="h-3.5 w-3.5 shrink-0 text-ink-faint" />
      <input
        type="text"
        data-palette-input
        placeholder="Jump to…  ($ for a shell)"
        aria-label="Search pages and links"
        autocomplete="off"
        class="w-full bg-transparent py-3.5 text-sm text-ink outline-none placeholder:text-ink-faint"
      />
      <kbd class="shrink-0 rounded border border-line-soft px-1.5 py-0.5 font-mono text-[10px] text-ink-faint">esc</kbd>
    </div>

    <p data-palette-shell-error hidden class="px-4 pt-3 font-mono text-[12px] text-ink-faint">
      couldn't load the shell — try again
    </p>

    {/*
      The shell: a wterm terminal, mounted here on the first `$`. The engine,
      the terminal and the filesystem are all fetched then, so the palette
      costs nothing extra until it is used as one. Collapsed rather than
      hidden in search mode, so the terminal keeps its size and never refits
      its scrollback to nothing.
    */}
    <div data-palette-shell inert>
      <div data-palette-term aria-label="Shell" class="h-[21.5rem]"></div>
    </div>

    {/* Tall enough that the full, unfiltered list lands without scrolling. */}
    <div data-palette-list class="max-h-[21.5rem] overflow-y-auto p-1.5">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-palette-item
            data-needle={item.needle}
            data-haystack={item.haystack}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="flex w-full items-center gap-3 rounded-[5px] px-2.5 py-2.5 text-left text-sm text-ink-dim hover:text-ink"
          >
            <Icon
              name={item.icon}
              class="palette-icon h-3.5 w-3.5 shrink-0 text-ink-faint"
            />
            <span class="flex-1 truncate">{item.label}</span>
            {item.external && (
              <span class="shrink-0 font-mono text-[10px] text-ink-faint">↗</span>
            )}
          </a>
        ))
      }

      <p data-palette-empty hidden class="px-2.5 py-6 text-sm text-ink-faint">
        Nothing matches “<span data-palette-query></span>”.
      </p>
    </div>

    <div
      class="flex gap-3.5 border-t border-line-soft px-4 py-2.5 font-mono text-[10.5px] text-ink-faint"
      aria-hidden="true"
    >
      <span data-search-hint><kbd class="palette-key">↑</kbd> <kbd class="palette-key">↓</kbd> move</span>
      <span data-search-hint><kbd class="palette-key">↵</kbd> open</span>
      <span data-search-hint><kbd class="palette-key">$</kbd> shell</span>
      <span data-shell-hint><kbd class="palette-key">tab</kbd> complete</span>
      <span data-shell-hint><kbd class="palette-key">↑</kbd> history</span>
      <span data-shell-hint><kbd class="palette-key">esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  /* Always in the DOM and toggled with opacity, so closing can fade. `inert`
     is what makes that safe — a transparent overlay is still focusable. */
  .palette {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease-out;
  }

  .palette[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  .palette-key {
    font: inherit;
    border: 1px solid var(--color-line-soft);
    border-radius: 4px;
    padding: 1px 5px;
  }

  /* A row's own `display: flex` outranks the UA rule for [hidden]. */
  [data-palette-item][hidden] {
    display: none;
  }

  /* The highlighted row — set by the arrow keys and by the pointer. */
  [data-palette-item][data-active] {
    background: var(--color-raised);
    color: var(--color-ink);
  }

  [data-palette-item][data-active] :global(.palette-icon) {
    color: var(--color-brand-alt);
  }

  /* In shell mode the search bar and the rows give way to the terminal. */
  [data-palette][data-shell] [data-palette-searchbar],
  [data-palette][data-shell] [data-palette-list],
  [data-palette][data-shell] [data-search-hint],
  [data-palette]:not([data-shell]) [data-shell-hint] {
    display: none;
  }

  [data-palette]:not([data-shell]) [data-palette-shell] {
    height: 0;
    overflow: hidden;
  }

  /* The terminal in the site's colours. The session writes indexed colours
     (34 blue, 31 red, 90 faint), so these decide what they look like. */
  [data-palette] :global(.wterm) {
    --term-fg: var(--color-ink);
    --term-bg: var(--color-base);
    --term-cursor: var(--color-brand);
    --term-selection-bg: color-mix(in oklab, var(--color-brand) 35%, transparent);
    --term-color-0: var(--color-base);
    --term-color-1: #f87171;
    --term-color-4: var(--color-brand);
    --term-color-7: var(--color-ink-dim);
    --term-color-8: var(--color-ink-faint);
    --term-color-9: #f87171;
    --term-color-12: var(--color-brand-alt);
    --term-color-15: var(--color-ink);
    --term-font-family: var(--font-mono);
    --term-font-size: 12px;
    --term-line-height: 1.65;
    --term-row-height: 20px;
    padding: 12px 16px;
    border-radius: 0;
    box-shadow: none;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { closeOnOtherOverlay, overlayOpened } from "@/lib/overlays";
  import { onPage } from "@/lib/page-lifecycle";
  import type { PaletteTerminal } from "@/lib/palette-terminal";
  import type { SessionState } from "@/lib/shell-session";

  // Module state outlives the page, so the working directory, the history and
  // the downloaded filesystem carry across soft navigations. The terminal
  // itself belongs to one page's markup and is mounted afresh on each. The
  // promise, not its value, so pages that ask while it is in flight share it.
  let shellLoad: Promise<SessionState> | null = null;
  let bannerShown = false;

  async function loadShellState(): Promise<SessionState> {
    const response = await fetch("/shell-fs.json");
    if (!response.ok) throw new Error(`shell-fs.json responded ${response.status}`);
    // The one place the filesystem crosses an untyped boundary.
    const root = (await response.json()) as SessionState["root"];
    return { root, cwd: "/", history: [] };
  }

  function setupPalette(signal: AbortSignal) {
    document.body.style.overflow = "";

    const palette = document.querySelector<HTMLElement>("[data-palette]");
    if (!palette) return;

    const input = palette.querySelector<HTMLInputElement>("[data-palette-input]");
    const list = palette.querySelector<HTMLElement>("[data-palette-list]");
    const empty = palette.querySelector<HTMLElement>("[data-palette-empty]");
    const echo = palette.querySelector<HTMLElement>("[data-palette-query]");
    const backdrop = palette.querySelector<HTMLElement>("[data-palette-backdrop]");
    if (!input || !list || !empty || !echo || !backdrop) return;

    const rows = Array.from(
      list.querySelectorAll<HTMLAnchorElement>("[data-palette-item]"),
    );

    const shellPane = palette.querySelector<HTMLElement>("[data-palette-shell]");
    const termHost = palette.querySelector<HTMLElement>("[data-palette-term]");
    const shellError = palette.querySelector<HTMLElement>("[data-palette-shell-error]");

    let terminal: PaletteTerminal | null = null;
    let loading = false;
    let shellOn = false;
    signal.addEventListener("abort", () => terminal?.destroy());

    /** The matching rows, in the order they are drawn. */
    let visible = rows;
    let active = 0;
    let open = false;
    let previousOverflow = "";

    /**
     * Subsequence match — "gst" finds "Guestbook", null when it does not.
     * Walks the label alone: over a whole keyword line almost any short query
     * threads some path through. Keywords still match as a literal run.
     */
    const score = (row: HTMLAnchorElement, query: string): number | null => {
      if (!query) return 0;
      const needle = row.dataset.needle ?? "";
      const haystack = row.dataset.haystack ?? "";

      const direct = needle.indexOf(query);
      if (direct === 0) return 1000;
      if (direct > 0) return 800 - direct;
      if (haystack.includes(query)) return 500;

      let cursor = 0;
      let gaps = 0;
      for (const char of query) {
        const found = needle.indexOf(char, cursor);
        if (found === -1) return null;
        gaps += found - cursor;
        cursor = found + 1;
      }
      return 200 - Math.min(gaps, 199);
    };

    const setActive = (index: number) => {
      active = visible.length ? (index + visible.length) % visible.length : 0;

      for (const row of rows) row.removeAttribute("data-active");

      const current = visible[active];
      if (!current) return;
      current.setAttribute("data-active", "");
      // Only worth doing while the list is on screen, and scrolling something
      // invisible is a good way to move the page instead.
      if (open) current.scrollIntoView({ block: "nearest" });
    };

    const filter = () => {
      const query = input.value.toLowerCase();

      const matches = rows
        .map((row) => ({ row, s: score(row, query) }))
        .filter((entry): entry is { row: HTMLAnchorElement; s: number } => entry.s !== null)
        .sort((a, b) => b.s - a.s);

      for (const row of rows) row.hidden = true;
      // Moving each match ahead of the empty-state line both re-sorts the list
      // and keeps that line last.
      for (const { row } of matches) {
        row.hidden = false;
        list.insertBefore(row, empty);
      }

      visible = matches.map((entry) => entry.row);
      empty.hidden = visible.length > 0;
      echo.textContent = input.value;
      setActive(0);
    };

    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;

      palette.toggleAttribute("data-open", next);
      palette.toggleAttribute("inert", !next);

      if (next) {
        // Takes the settings popover down with it — see lib/overlays.
        overlayOpened("palette");
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => input.focus());
      } else {
        document.body.style.overflow = previousOverflow;
        input.value = "";
        if (shellOn) exitShell();
        else filter();
      }
    };

    const enterShell = async () => {
      if (!shellPane || !termHost || !shellError || loading) return;

      if (!terminal) {
        loading = true;
        try {
          // Only a failed fetch is forgotten: a later failure keeps the
          // visit's cwd and history.
          shellLoad ??= loadShellState().catch((error) => {
            shellLoad = null;
            throw error;
          });
          const [{ mountTerminal }, state] = await Promise.all([
            import("../lib/palette-terminal"),
            shellLoad,
          ]);
          // Closed, moved on to another page, or deleted the `$`, while that loaded.
          if (signal.aborted || !open || !input.value.startsWith("$")) return;

          terminal = await mountTerminal(termHost, state, {
            banner: !bannerShown,
            // Let the line land before the browser leaves the page.
            navigate: (href) => {
              const cancel = () => clearTimeout(timer);
              const timer = setTimeout(() => {
                signal.removeEventListener("abort", cancel);
                void navigate(href);
              }, 180);
              signal.addEventListener("abort", cancel, { once: true });
            },
            exit: () => exitShell(),
          });
          if (signal.aborted) {
            terminal.destroy();
            return;
          }
          bannerShown = true;
          // Mounted, but the reader has moved on; the next `$` resumes it.
          if (!open || !input.value.startsWith("$")) return;
        } catch (error) {
          // Guarded: without it a failure leaves a prompt over a shell whose
          // filesystem never arrived, answering as if the bucket were empty.
          console.error("[palette] shell failed to load", error);
          shellError.hidden = false;
          return;
        } finally {
          loading = false;
        }
      } else {
        terminal.resume();
      }

      // Whatever was typed after the `$` while the shell loaded is its first input.
      const ahead = input.value.slice(1);
      shellOn = true;
      shellError.hidden = true;
      palette.setAttribute("data-shell", "");
      shellPane.inert = false;
      input.value = "";
      terminal.focus();
      if (ahead) terminal.type(ahead);
    };

    const exitShell = () => {
      if (!shellPane) return;
      shellOn = false;
      palette.removeAttribute("data-shell");
      shellPane.inert = true;
      filter();
      if (open) input.focus();
    };

    closeOnOtherOverlay("palette", () => setOpen(false), signal);

    for (const trigger of document.querySelectorAll("[data-palette-trigger]")) {
      trigger.addEventListener("click", () => setOpen(true), { signal });
    }

    backdrop.addEventListener("click", () => setOpen(false), { signal });

    input.addEventListener(
      "input",
      () => {
        if (shellError) shellError.hidden = true;
        if (!shellOn && input.value === "$") {
          void enterShell();
          return;
        }
        if (!shellOn) filter();
      },
      { signal },
    );

    input.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === "Enter") {
          event.preventDefault();
          // Click the row rather than navigating by hand, so both paths agree.
          visible[active]?.click();
        }
      },
      { signal },
    );

    list.addEventListener(
      "click",
      (event) => {
        if (!(event.target as HTMLElement).closest("[data-palette-item]")) return;
        // Flipping `inert` mid-dispatch would cancel the activation this rides on.
        setTimeout(() => setOpen(false));
      },
      { signal },
    );

    list.addEventListener(
      "pointermove",
      (event) => {
        const row = (event.target as HTMLElement).closest<HTMLAnchorElement>(
          "[data-palette-item]",
        );
        if (!row) return;
        const index = visible.indexOf(row);
        if (index >= 0 && index !== active) setActive(index);
      },
      { signal },
    );

    // Global ⌘K / Ctrl+K, and "/" as a shortcut when not already typing.
    // Capturing, and stopped here, because the terminal claims both Ctrl+K and
    // Escape for itself and stops them before they would bubble up.
    window.addEventListener(
      "keydown",
      (event) => {
        const typing =
          event.target instanceof HTMLElement &&
          (event.target.tagName === "INPUT" ||
            event.target.tagName === "TEXTAREA" ||
            event.target.isContentEditable);

        if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          event.stopPropagation();
          setOpen(!open);
        } else if (event.key === "/" && !typing && !open) {
          event.preventDefault();
          setOpen(true);
        } else if (event.key === "Escape" && open) {
          event.preventDefault();
          event.stopPropagation();
          setOpen(false);
        }
      },
      { signal, capture: true },
    );

    filter();
  }

  onPage(setupPalette);
</script>
