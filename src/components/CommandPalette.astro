---
import Icon from "./Icon.astro";
import { externalLinks, nav } from "@/lib/site";

/**
 * ⌘K / Ctrl+K, or "/" from anywhere that isn't a text field. The rows are
 * server-drawn, so filtering is hiding and reordering markup rather than
 * hydrating a component tree for a dialog nobody has opened.
 *
 * Lives at the end of <body>: the header's backdrop-blur is a containing block
 * for fixed positioning, so the overlay would size to the bar.
 */
const items = [...nav, ...externalLinks].map((item) => ({
  ...item,
  external: /^https?:/.test(item.href) || item.href.endsWith(".txt"),
  // Lowercased once here so the keystroke handler never has to.
  needle: item.label.toLowerCase(),
  haystack: `${item.label} ${item.keywords ?? ""}`.toLowerCase(),
}));
---

<div
  data-palette
  inert
  class="palette fixed inset-0 z-[100] flex items-start justify-center px-4 pt-[14vh]"
>
  <div class="absolute inset-0 bg-black/75" data-palette-backdrop aria-hidden="true">
  </div>

  <div
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
    class="card relative w-full max-w-md"
  >
    <div class="flex items-center gap-3 border-b border-line px-4">
      <Icon name="search" class="palette-search h-3.5 w-3.5 shrink-0 text-ink-faint" />
      <span
        data-palette-prompt
        hidden
        class="shrink-0 whitespace-nowrap font-mono text-sm text-brand"></span>
      <input
        type="text"
        data-palette-input
        placeholder="Jump to…  ($ for a shell)"
        aria-label="Search pages and links"
        autocomplete="off"
        class="w-full bg-transparent py-3 text-sm text-ink outline-none placeholder:text-ink-faint"
      />
      <kbd class="shrink-0 font-mono text-[10px] text-ink-faint">esc</kbd>
    </div>

    {/*
      Shell scrollback. Empty and hidden until someone types `$` — the engine
      and the filesystem are both fetched on demand, so the palette costs
      nothing extra until it is actually used as one.
    */}
    <div
      data-palette-shell
      hidden
      class="max-h-[21.5rem] overflow-y-auto px-4 py-3 font-mono text-[12px] leading-[1.65]"
    >
    </div>

    {/* Tall enough that the full, unfiltered list lands without scrolling. */}
    <div data-palette-list class="max-h-[21.5rem] overflow-y-auto py-1">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-palette-item
            data-needle={item.needle}
            data-haystack={item.haystack}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="flex w-full items-center gap-3 px-4 py-2 text-left text-sm text-ink-dim transition-colors hover:text-ink"
          >
            <Icon
              name={item.icon}
              class="palette-icon h-3.5 w-3.5 shrink-0 text-ink-faint"
            />
            <span class="flex-1 truncate">{item.label}</span>
            {item.external && (
              <span class="shrink-0 font-mono text-[10px] text-ink-faint">↗</span>
            )}
          </a>
        ))
      }

      <p data-palette-empty hidden class="px-4 py-6 text-sm text-ink-faint">
        Nothing matches “<span data-palette-query></span>”.
      </p>
    </div>
  </div>
</div>

<style>
  /*
    Always in the DOM, toggled with opacity, so closing can fade. `inert` is
    what makes that safe: a transparent overlay is still focusable and still in
    the accessibility tree, and the script takes it out of both.
  */
  .palette {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease-out;
  }

  .palette[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  /* A row's own `display: flex` outranks the UA rule for [hidden]. */
  [data-palette-item][hidden] {
    display: none;
  }

  /* The highlighted row — set by the arrow keys and by the pointer. */
  [data-palette-item][data-active] {
    background: var(--color-raised);
    color: var(--color-ink);
  }

  [data-palette-item][data-active] :global(.palette-icon) {
    color: var(--color-brand);
  }

  /* In shell mode the row list gives way to the scrollback. */
  [data-palette][data-shell] [data-palette-list],
  [data-palette][data-shell] :global(.palette-search) {
    display: none;
  }

  [data-palette][data-shell] [data-palette-input] {
    font-family: var(--font-mono);
  }
</style>

<script>
  import { closeOnOtherOverlay, overlayOpened } from "@/lib/overlays";

  // The palette is re-rendered on every navigation, so each run retires the
  // last one's listeners — the same shape as the nav rail in TopBar.
  let binding: AbortController | null = null;

  function setupPalette() {
    binding?.abort();
    binding = null;

    // A navigation can swap the page out from under an open palette, and the
    // scroll lock is set on <body>, which survives the swap.
    document.body.style.overflow = "";

    const palette = document.querySelector<HTMLElement>("[data-palette]");
    if (!palette) return;

    const input = palette.querySelector<HTMLInputElement>("[data-palette-input]");
    const list = palette.querySelector<HTMLElement>("[data-palette-list]");
    const empty = palette.querySelector<HTMLElement>("[data-palette-empty]");
    const echo = palette.querySelector<HTMLElement>("[data-palette-query]");
    const backdrop = palette.querySelector<HTMLElement>("[data-palette-backdrop]");
    if (!input || !list || !empty || !echo || !backdrop) return;

    const rows = Array.from(
      list.querySelectorAll<HTMLAnchorElement>("[data-palette-item]"),
    );

    const shellPane = palette.querySelector<HTMLElement>("[data-palette-shell]");
    const prompt = palette.querySelector<HTMLElement>("[data-palette-prompt]");

    /** Shell mode. Engine and filesystem are fetched on the first `$`, never before. */
    type Shell = typeof import("../lib/shell");
    /** The filesystem shape, taken from the engine rather than restated. */
    type Root = Parameters<Shell["run"]>[0]["root"];
    let shell: { mod: Shell; root: Root } | null = null;
    let shellOn = false;
    let cwd = "/";
    const history: string[] = [];
    /** Position while arrowing back through history; -1 is the live input. */
    let recall = -1;

    /** The matching rows, in the order they are drawn. */
    let visible = rows;
    let active = 0;
    let open = false;
    let previousOverflow = "";

    /**
     * Subsequence match — "gst" finds "Guestbook". Null when it doesn't match.
     * Walks the label alone: given a whole keyword line, almost any short query
     * threads some path through it. Keywords still match as a literal run.
     */
    const score = (row: HTMLAnchorElement, query: string): number | null => {
      if (!query) return 0;
      const needle = row.dataset.needle ?? "";
      const haystack = row.dataset.haystack ?? "";

      const direct = needle.indexOf(query);
      if (direct === 0) return 1000;
      if (direct > 0) return 800 - direct;
      if (haystack.includes(query)) return 500;

      let cursor = 0;
      let gaps = 0;
      for (const char of query) {
        const found = needle.indexOf(char, cursor);
        if (found === -1) return null;
        gaps += found - cursor;
        cursor = found + 1;
      }
      return 200 - Math.min(gaps, 199);
    };

    const setActive = (index: number) => {
      active = visible.length ? (index + visible.length) % visible.length : 0;

      for (const row of rows) row.removeAttribute("data-active");

      const current = visible[active];
      if (!current) return;
      current.setAttribute("data-active", "");
      // Only worth doing while the list is on screen, and scrolling something
      // invisible is a good way to move the page instead.
      if (open) current.scrollIntoView({ block: "nearest" });
    };

    const filter = () => {
      const query = input.value.toLowerCase();

      const matches = rows
        .map((row) => ({ row, s: score(row, query) }))
        .filter((entry): entry is { row: HTMLAnchorElement; s: number } => entry.s !== null)
        .sort((a, b) => b.s - a.s);

      for (const row of rows) row.hidden = true;
      // Moving each match ahead of the empty-state line both re-sorts the list
      // and keeps that line last.
      for (const { row } of matches) {
        row.hidden = false;
        list.insertBefore(row, empty);
      }

      visible = matches.map((entry) => entry.row);
      empty.hidden = visible.length > 0;
      echo.textContent = input.value;
      setActive(0);
    };

    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;

      palette.toggleAttribute("data-open", next);
      palette.toggleAttribute("inert", !next);

      if (next) {
        // Takes the settings popover down with it — see lib/overlays.
        overlayOpened("palette");
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => input.focus());
      } else {
        document.body.style.overflow = previousOverflow;
        input.value = "";
        if (shellOn) exitShell();
        else filter();
      }
    };

    const line = (text: string, cls: string) => {
      const el = document.createElement("div");
      el.className = cls;
      el.textContent = text;
      return el;
    };

    const setPrompt = () => {
      if (prompt) prompt.textContent = `${cwd} $`;
    };

    const enterShell = async () => {
      if (!shellPane || !prompt) return;

      if (!shell) {
        /*
          Both land in one round trip, and only ever once per page.

          Guarded, because an unhandled rejection here left the pane blank with
          a live prompt: the reader typed into a shell whose filesystem had
          never arrived, and every command answered as though the bucket were
          empty. Saying so is the whole fix — there is nothing to retry
          automatically, since reopening the shell tries again anyway.
        */
        let mod: typeof import("../lib/shell");
        let root: Root;
        try {
          [mod, root] = await Promise.all([
            import("../lib/shell"),
            // The one place the filesystem crosses an untyped boundary.
            fetch("/shell-fs.json").then((response) => {
              if (!response.ok) {
                throw new Error(`shell-fs.json responded ${response.status}`);
              }
              return response.json() as Promise<Root>;
            }),
          ]);
        } catch (error) {
          console.error("[palette] shell filesystem failed to load", error);
          shellPane.appendChild(
            line("couldn't load the filesystem — try again", "text-ink-faint"),
          );
          return;
        }
        shell = { mod, root };
        shellPane.appendChild(
          line(
            "Type help for the commands, ls to look around. Backspace on an empty line goes back to search.",
            "text-ink-faint",
          ),
        );
      }

      shellOn = true;
      palette.setAttribute("data-shell", "");
      prompt.hidden = false;
      shellPane.hidden = false;
      setPrompt();
      input.value = "";
      input.placeholder = "";
    };

    const exitShell = () => {
      if (!shellPane || !prompt) return;
      shellOn = false;
      palette.removeAttribute("data-shell");
      prompt.hidden = true;
      shellPane.hidden = true;
      input.placeholder = "Jump to…  ($ for a shell)";
      filter();
    };

    const runCommand = (text: string) => {
      if (!shell || !shellPane) return;

      const result = shell.mod.run({ root: shell.root, cwd, history }, text);
      if (text.trim()) history.push(text);
      recall = -1;

      if (result.cleared) {
        shellPane.replaceChildren();
      } else {
        shellPane.appendChild(line(`${cwd} $ ${text}`, "mt-2.5 text-ink-faint"));
        if (result.output.length > 0) {
          shellPane.appendChild(
            line(
              result.output.join("\n"),
              `whitespace-pre-wrap break-words ${
                result.failed ? "text-red-400/90" : "text-ink-dim"
              }`,
            ),
          );
        }
      }

      cwd = result.cwd;
      setPrompt();
      input.value = "";
      shellPane.scrollTop = shellPane.scrollHeight;

      // Let the line land before the browser leaves the page.
      if (result.navigate) {
        const href = result.navigate;
        setTimeout(() => {
          window.location.href = href;
        }, 180);
      }
    };

    /** Returns true when the key was the shell's to handle. */
    const shellKey = (event: KeyboardEvent): boolean => {
      if (!shellOn || !shell) return false;

      if (event.key === "Enter") {
        event.preventDefault();
        runCommand(input.value);
        return true;
      }

      if (event.key === "Tab") {
        // Never let Tab move focus out of the prompt.
        event.preventDefault();
        const at = input.selectionStart ?? input.value.length;
        const result = shell.mod.complete(
          { root: shell.root, cwd, history },
          input.value,
          at,
        );

        if (result.candidates.length > 0 && shellPane) {
          shellPane.appendChild(line(`${cwd} $ ${input.value}`, "mt-2.5 text-ink-faint"));
          shellPane.appendChild(line(result.candidates.join("  "), "text-ink-dim"));
          shellPane.scrollTop = shellPane.scrollHeight;
        } else if (result.line !== input.value) {
          input.value = result.line;
          input.setSelectionRange(result.cursor, result.cursor);
        }
        return true;
      }

      if (event.key === "ArrowUp" || event.key === "ArrowDown") {
        event.preventDefault();
        if (event.key === "ArrowUp") {
          const next = recall === -1 ? history.length - 1 : Math.max(recall - 1, 0);
          if (history[next] !== undefined) {
            recall = next;
            input.value = history[next]!;
          }
        } else if (recall !== -1) {
          const next = recall + 1;
          recall = next >= history.length ? -1 : next;
          input.value = recall === -1 ? "" : history[recall]!;
        }
        return true;
      }

      // Backspacing off an empty prompt returns to search.
      if (event.key === "Backspace" && input.value === "") {
        event.preventDefault();
        exitShell();
        return true;
      }

      return false;
    };

    binding = new AbortController();
    const { signal } = binding;

    closeOnOtherOverlay("palette", () => setOpen(false), signal);

    for (const trigger of document.querySelectorAll("[data-palette-trigger]")) {
      trigger.addEventListener("click", () => setOpen(true), { signal });
    }

    backdrop.addEventListener("click", () => setOpen(false), { signal });

    input.addEventListener(
      "input",
      () => {
        if (!shellOn && input.value === "$") {
          void enterShell();
          return;
        }
        if (!shellOn) filter();
      },
      { signal },
    );

    input.addEventListener(
      "keydown",
      (event) => {
        if (shellKey(event)) return;

        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActive(active + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActive(active - 1);
        } else if (event.key === "Enter") {
          event.preventDefault();
          // Click the row rather than navigating by hand, so a normal click
          // and this take the same path — including the router's.
          visible[active]?.click();
        }
      },
      { signal },
    );

    list.addEventListener(
      "click",
      (event) => {
        if (!(event.target as HTMLElement).closest("[data-palette-item]")) return;
        // Next tick: flipping `inert` mid-dispatch would cancel the very
        // activation this is riding on.
        setTimeout(() => setOpen(false));
      },
      { signal },
    );

    list.addEventListener(
      "pointermove",
      (event) => {
        const row = (event.target as HTMLElement).closest<HTMLAnchorElement>(
          "[data-palette-item]",
        );
        if (!row) return;
        const index = visible.indexOf(row);
        if (index >= 0 && index !== active) setActive(index);
      },
      { signal },
    );

    // Global ⌘K / Ctrl+K, and "/" as a shortcut when not already typing.
    window.addEventListener(
      "keydown",
      (event) => {
        const typing =
          event.target instanceof HTMLElement &&
          (event.target.tagName === "INPUT" ||
            event.target.tagName === "TEXTAREA" ||
            event.target.isContentEditable);

        if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          setOpen(!open);
        } else if (event.key === "/" && !typing && !open) {
          event.preventDefault();
          setOpen(true);
        } else if (event.key === "Escape" && open) {
          event.preventDefault();
          setOpen(false);
        }
      },
      { signal },
    );

    filter();
  }

  // Module scripts are deferred, so the DOM is parsed by the time this runs.
  setupPalette();
</script>
